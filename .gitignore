# Snow AI 工作区
/refs/

# Snow AI 本地产出（代码笔记 / 快照）
.snow/notebook/

# Astro 生成的本地缓存类型与设置
app/.astro/
.astro/

# Dependencies
node_modules/

# Lock files — pnpm 项目，npm 残留物不进版本控制
package-lock.json

# Build output
sdk/dist/
app/dist/
themes/*/dist/

# Generated core CJS runtime artifact (run pnpm build:models before Go serve/build)
runtime/core-schema/models.js

# Pack schema artifacts (run scripts/pack-schema-build.mjs <pack> before Go builds)
packs/*/schema.js
# Freshness sidecar produced by `vanblog pack build` (same lifecycle as schema.js)
packs/*/schema.js.meta.json

# Go build artifacts
vault/vanblog
vault/bin/

# pb data (local dev)
pb_data/

# Caddy data (local dev)
caddy_data/

# OCR review — 含真实 API key，不进仓库
docker/ocr-review/ocr-config.json

# Snow AI team 任务与审查临时产物（agent 生成的 review/task 中间文件，不进版本控制）
.review/
.snow-task-*.json
*-task.json

# IDE
.DS_Store

# IDE 本地缓存（desktop 话题状态等）
.reasonix/

# Pi agent runtime 产物（容器启动时由 init-pi-config.mjs 生成，不进版本控制）
# 注意：.pi/settings.json 是有意提交的项目配置，需保留
.pi/models.json
.pi/agent/
.pi/sessions/
.pi/*.session
.pi/*.history
~/.pi/
