---
// PackPage host: default theme re-exports the builtin PackPage so that
// packs/ pages render through the builtin layout. Themes that want a custom
// PackPage shell can replace this file or put an override at
// src/builtin-overrides/layouts/PackPage.astro (which the themes integration
// would surface via `@vanblog/builtin/layouts/PackPage.astro`).
import BuiltinPackPage from '@vanblog/builtin/layouts/PackPage.astro';
const { ...props } = Astro.props;
---
<BuiltinPackPage {...props} />
