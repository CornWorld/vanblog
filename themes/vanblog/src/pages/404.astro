---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';

// Server-render so we can return a real 404 status code. The previous
// prerender=true produced HTTP 200 with a 404 body — fine for humans but
// wrong for crawlers, WAFs, and any client checking res.ok.
Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');
---
<BaseLayout title="404 - 页面不存在">
  <div class="card-post py-20 text-center">
    <div class="text-6xl font-bold text-[var(--text-muted)] mb-4">404</div>
    <p class="text-lg text-[var(--text-muted)] mb-8">此页面不存在。</p>
    <a href="/" class="ua ua-link text-base text-[var(--text-muted)] hover:text-[var(--text)]">返回主页</a>
  </div>
</BaseLayout>
