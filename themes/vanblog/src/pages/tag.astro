<!--
⛔ AGENT: DO NOT EDIT THIS BLOCK
L0 CONTRACT - 前端契约变量（见 .snow/plan/migrate-vanblog-frontend-to-theme-palette.md §模板契约清单）
页面: 标签索引
路径: themes/vanblog/src/pages/tag.astro
契约变量:
  - tags: Tag[] — 全部标签
-->

---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import ErrorState from '../components/ErrorState.astro';
import { safe } from '@vanblog/sdk';
import type { Tag } from '@vanblog/sdk';
import { getAuthorCardProps } from '../lib/viewModel';
import { withBase } from '../lib/base';
const pb = Astro.locals.pb;

const { data: tags = [], error } = await safe(
  () => pb.collection('tags').getFullList<Tag>(), // 顺序与原版 meta.tags(平台默认序)一致
  'tags'
);
const site = await Astro.locals.getSite();
const openInNewWindow = site?.displayOptions?.openArticleLinksInNewWindow === true;
const authorCard = await getAuthorCardProps(pb, site);
---
<BaseLayout title="标签" path="/tag" sideBar>
  {error ? (
    <ErrorState />
  ) : tags.length === 0 ? (
    <div class="card-post py-16 text-center">
      <p class="text-[var(--text-muted)]">暂无标签。</p>
    </div>
  ) : (
    /* 原版 tag.tsx：白卡 card-shadow py-4 px-8 md:py-6 md:px-8 + 居中标题 + 纯文本标签云 */
    <div class="bg-white card-shadow dark:bg-dark dark:card-shadow-dark py-4 px-8 md:py-6 md:px-8">
      <div class="text-lg md:text-xl text-gray-700 dark:text-dark">标签</div>
      <div class="flex flex-wrap mt-2">
        {tags.map(t => (
          <a
            href={withBase(`/tag/${encodeURIComponent(t.name)}`)}
            target={openInNewWindow ? '_blank' : '_self'}
          >
            <div class="my-2 text-gray-500 block hover:text-gray-900 dark:hover:text-dark-hover dark:text-dark-400 transform hover:scale-110 transition-all mr-5">{t.name}</div>
          </a>
        ))}
      </div>
    </div>
  )}

  <Fragment slot="sideBar">
    <AuthorCard {...authorCard} />
  </Fragment>
</BaseLayout>
