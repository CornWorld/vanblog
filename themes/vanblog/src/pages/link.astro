<!--
⛔ AGENT: DO NOT EDIT THIS BLOCK
L0 CONTRACT - 前端契约变量（见 .snow/plan/migrate-vanblog-frontend-to-theme-palette.md §模板契约清单）
页面: 友情链接（从 mereithhh 原版 link.tsx 迁移）
路径: themes/vanblog/src/pages/link.astro
契约变量:
  - site: Site — 站点配置（site.links 数组）
-->

---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard.astro';
import AuthorCard from '../components/AuthorCard.astro';
import Comments from '../components/Comments.astro';
import { renderMarkdown } from '@vanblog/base/lib/markdown/renderer';
import { getAuthorCardProps } from '../lib/viewModel';
import { sanitizeHtml } from '../lib/sanitizeHtml';

const pb = Astro.locals.pb;
const site = await Astro.locals.getSite();
const links = site?.links ?? [];
const siteName = site?.siteName || 'Vanblog';
const siteDesc = site?.siteDesc;
const baseUrl = site?.baseUrl || '';
const logo = site?.authorLogo || (baseUrl ? `${baseUrl}/logo.svg` : '');
const authorCard = await getAuthorCardProps(pb, site);

// 原版 link.tsx requireContent：申领要求 + 本站信息，一并 Markdown 渲染
const requireContent = [
  '**[申领要求]**',
  '- [x] 请先添加本站为友链后再申请友链，并通过留言或邮件告知',
  '- [x] 不和剽窃、侵权、无诚信的网站交换，优先和具有原创作品的全站 HTTPS 站点交换',
  '- [x] 原则上要求您的博客主页被百度或者 Google 等搜索引擎收录',
  '- [x] 由于访问安全性问题，请**务必**提供 HTTPS 链接的头像地址（或留言时备注暂无以便本站主动保存）',
  '- [x] 不接受视频站、资源站等非博客类站点交换，原则上只与技术/日志类博客交换友链',
  '',
  '**[本站信息]**',
  `> 名称： ${siteName}<br/>`,
  siteDesc ? `> 简介： ${siteDesc}<br/>` : '',
  baseUrl ? `> 网址： [${baseUrl}](${baseUrl})<br/>` : '',
  logo ? `> 头像： [${logo}](${logo})` : '',
  '',
].filter(Boolean).join('\n');

let requireHtml = '';
if (requireContent.trim()) {
  try {
    const { code } = await renderMarkdown(requireContent);
    requireHtml = sanitizeHtml(code);
  } catch (e) {
    console.error('[link] render:', e);
  }
}
---

<BaseLayout title="友情链接" path="/link" sideBar>
  <div class="card-post py-4 px-8 md:py-6 md:px-8">
    <div class="text-2xl md:text-3xl text-[var(--text)] text-center">友情链接</div>
    <p class="mt-6 mb-4 text-[var(--text)]">以下是本站的友情链接，排名不分先后：</p>

    {links.length === 0 ? (
      <p class="py-12 text-center text-[var(--text-muted)]">暂无友链。</p>
    ) : (
      <div class="grid gap-2 sm:gap-4 grid-cols-2 lg:grid-cols-3">
        {links.map((link) => (
          <LinkCard link={link} />
        ))}
      </div>
    )}

    <hr class="mt-8 border-[var(--border)]" />
    <div class="mt-4 text-sm md:text-base">
      {requireHtml ? (
        <div class="post-viewer" set:html={requireHtml} />
      ) : (
        <p class="text-[var(--text-muted)]">暂无站点信息。</p>
      )}
    </div>
  </div>

  {/* 原版 link.tsx 底部 WaLine 留言板（enable = 全局评论开关） */}
  {site?.commentsProvider && site.commentsProvider !== 'disabled' && (
    <div class="mt-4">
      <Comments provider={site.commentsProvider} config={site?.commentsConfig || null} />
    </div>
  )}

  <Fragment slot="sideBar">
    <AuthorCard {...authorCard} />
  </Fragment>
</BaseLayout>
