<!--
⛔ AGENT: DO NOT EDIT THIS BLOCK
L0 CONTRACT - 前端契约变量（见 .snow/plan/migrate-vanblog-frontend-to-theme-palette.md §模板契约清单）
页面: 时间轴
路径: themes/vanblog/src/pages/timeline.astro
契约变量:
  - entries: TimelineEntry[] — 时间轴条目
-->

---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import ErrorState from '../components/ErrorState.astro';
import { safe } from '@vanblog/sdk';
import { getAuthorCardProps } from '../lib/viewModel';
const pb = Astro.locals.pb;

const { data: entries = [], error } = await safe(
  () => pb.vanblog.timeline.list(),
  'timeline'
);
const site = await Astro.locals.getSite();
const authorCard = await getAuthorCardProps(pb, site);
// 原版 wordTotal：全站已发布文章字数合计（platform 无 totalWordCount 字段，需现算）。
// getFullList 受 ViewRule 约束，匿名仅能取到已发布+公开文章，与 listPublished 一致。
const { data: wordPosts } = await safe(
  () => pb.collection('posts').getFullList<{ content?: string }>({ fields: 'content' }),
  'timeline-words',
);
const wordTotal = (wordPosts ?? []).reduce((sum, p) => sum + (p.content?.length || 0), 0);
const subtitle = `${authorCard.categoryNum} 分类 × ${authorCard.postNum} 文章 × ${authorCard.tagNum} 标签 × ${wordTotal} 字`;
---
<BaseLayout title="时间轴" path="/timeline" sideBar>
  {error ? (
    <ErrorState />
  ) : entries.length === 0 ? (
    <div class="card-post py-16 text-center">
      <p class="text-[var(--text-muted)]">暂无数据。</p>
    </div>
  ) : (
    /* 原版时间线：白卡包裹 + 居中标题 + 统计副标题 */
    <div class="card-post py-4 px-8 md:py-6 md:px-8">
      <div class="text-2xl md:text-3xl text-[var(--text)] text-center">时间线</div>
      <div class="text-center text-sm text-[var(--text-muted)] mt-2 mb-4 font-light">{subtitle}</div>

      <div class="flex flex-col mt-2 space-y-6">
        {entries.map(year => (
          <section>
            <h2 class="text-xl font-semibold mb-1">
              {year.year}
              <small class="text-[var(--text-muted)] font-normal ml-2">({year.count})</small>
            </h2>
            <div class="border-l-2 border-[var(--border)] pl-6 ml-1 space-y-4">
              {year.months.map(m => (
                <div>
                  <h3 class="text-sm text-[var(--text-muted)] mb-2">
                    {year.year}.{String(m.month).padStart(2, '0')}
                    <span class="ml-1">({m.count})</span>
                  </h3>
                  <ul class="space-y-1">
                    {m.titles.map(t => (
                      <li>
                        <a href={`/posts/${t.id}`} class="hover:text-[var(--accent)]">{t.title}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  )}

  <Fragment slot="sideBar">
    <AuthorCard {...authorCard} />
  </Fragment>
</BaseLayout>
