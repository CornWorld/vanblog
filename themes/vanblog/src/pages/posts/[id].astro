---
// /posts/<id> → /post/<id> 301 兼容桩。
// 规范文章路由已对齐原版形态 /post/[id];保留复数别名是因为平台 admin 面板
// (锁定目录)可能按旧形态拼"查看文章"链接。正文实现见 post/[id].astro。
export const prerender = false;

const { id } = Astro.params;
if (!id) return Astro.redirect('/404');
return Astro.redirect(`/post/${encodeURIComponent(id)}`, 301);
