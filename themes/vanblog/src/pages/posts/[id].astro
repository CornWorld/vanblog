<!--
⛔ AGENT: DO NOT EDIT THIS BLOCK
L0 CONTRACT - 前端契约变量（见 .snow/plan/migrate-vanblog-frontend-to-theme-palette.md §模板契约清单）
页面: 文章详情
路径: themes/vanblog/src/pages/posts/[id].astro
契约变量:
  - post: Post | null — 文章数据
  - html: string | null — 渲染后的 Markdown HTML
  - id: string — 文章 ID
  - site: Site — 站点配置
-->

---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PostViewer from '../../components/PostViewer.astro';
import Toc from '../../components/Toc.astro';
import TocMobile from '../../components/TocMobile.astro';
import ExpirationNotice from '../../components/ExpirationNotice.astro';
import CopyRight from '../../components/CopyRight.astro';
import ErrorNotice from '@vanblog/base/components/ErrorNotice.astro';
import Comments from '../../components/Comments.astro';
import Reward from '../../components/Reward.astro';
import TopPin from '../../components/TopPin.astro';
import { isAuthenticated, safe } from '@vanblog/sdk';
import { fmtDate } from '../../lib/dates';
import { renderMarkdown } from '@vanblog/base/lib/markdown/renderer';
import { normalizeMathDelimiters } from '@vanblog/base/lib/markdown/normalizeMathDelimiters';
import type { Post } from '@vanblog/sdk';
import { sanitizeHtml } from '../../lib/sanitizeHtml';
import { hasHeadings } from '../../lib/toc';

const pb = Astro.locals.pb;
const site = await Astro.locals.getSite();

const { id } = Astro.params;
if (!id) return Astro.redirect('/404');

// ── POST: password verification ──
const url = new URL(Astro.request.url);
let passwordError = url.searchParams.get('error') === 'invalid_password';
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = formData.get('password')?.toString();
  if (password) {
    try {
      const raw = await pb.collection('posts').getOne<Post>(id);
      if (raw.password && raw.password === password) {
        Astro.cookies.set(`vb-unlock-${id}`, 'true', {
          path: `/posts/${id}`,
          maxAge: 86400 * 7,
          sameSite: 'lax',
        });
        return Astro.redirect(`/posts/${id}`);
      }
    } catch {
      // Cannot fetch post (e.g. blocked by ViewRule) → fall through
    }
  }
  return Astro.redirect(`/posts/${id}?error=invalid_password`);
}

// Theme ships empty live collections (see live.config.ts), so the anonymous
// ViewRule-protected read is handled by the pb fallback below: non-public
// posts redirect to login (or 404), while authenticated authors/admins can
// preview their own private/draft work.
let data: Post | null = null;
let html: string | null = null;

if (!data) {
  // Password-protected: check unlock cookie before redirecting to login
  const unlockCookie = Astro.cookies.get(`vb-unlock-${id}`);
  if (!isAuthenticated(pb) && unlockCookie?.value === 'true') {
    try {
      const raw = await pb.collection('posts').getOne<Post>(id);
      if (raw) {
        const content = normalizeMathDelimiters(raw.content || '');
        html = (await renderMarkdown(content)).code;
        data = raw;
        passwordError = false;
      }
    } catch {
      // Cookie present but expired/invalid → fall through
    }
  }

  if (!data) {
    // Anonymous visitor hitting a private/draft post → send to login so they
    // can come back as the author/admin. Returning a bare 404 here would
    // confuse authors who just toggled "private" in the editor.
    if (!isAuthenticated(pb)) {
      return Astro.redirect(`/login?back=${encodeURIComponent(`/posts/${id}`)}`);
    }
    try {
      const raw = await pb.collection('posts').getOne<Post>(id);
      const content = normalizeMathDelimiters(raw.content || '');
      html = (await renderMarkdown(content)).code;
      data = raw;
    } catch {
      // Not found OR blocked by ViewRule even when authenticated.
      Astro.response.status = 404;
    }
  }
}
// Sanitize the rendered HTML before injecting it into the page.
const safeHtml = html !== null ? sanitizeHtml(html) : null;

// 文章含 h2/h3 标题 → 侧栏渲染 Toc（原版 hasToc ? <Toc/> : null）。
const hasToc = !!safeHtml && hasHeadings(safeHtml);

// 上下篇（原版 PostBottom pre/next）：按 created 前后各取 1 条，全库精确（无 100 篇上限）。
let prePost: { id: string; title: string } | null = null;
let nextPost: { id: string; title: string } | null = null;
if (data?.created) {
  const baseFilter = 'status = "published" && deleted = false';
  // 更旧的（pre，左 `<`）：created < 本篇，取最近一条
  const { data: older } = await safe(
    () => pb.collection('posts').getList<Post>(1, 1, {
      filter: `${baseFilter} && created < "${data.created}"`,
      sort: '-created',
      fields: 'id,title',
    }),
    'post-prev'
  );
  // 更新的（next，右 `>`）：created > 本篇，取最早一条
  const { data: newer } = await safe(
    () => pb.collection('posts').getList<Post>(1, 1, {
      filter: `${baseFilter} && created > "${data.created}"`,
      sort: 'created',
      fields: 'id,title',
    }),
    'post-next'
  );
  const prev = older?.items?.[0];
  const next = newer?.items?.[0];
  if (prev?.id) prePost = { id: prev.id, title: prev.title };
  if (next?.id) nextPost = { id: next.id, title: next.title };
}

// 标签名映射（data.tags 是 record id，需查 name 渲染）。
let tagMap: Record<string, string> = {};
const tagIds = data?.tags ?? [];
if (tagIds.length) {
  const { data: tags } = await safe(
    () => pb.collection('tags').getFullList<{ id: string; name: string }>(),
    'post-tags'
  );
  tagMap = Object.fromEntries((tags ?? []).map((t) => [t.id, t.name]));
}

// 分类名（data.category 是 record id；keywords 需要 name）。
let categoryName = '';
if (data?.category) {
  // 局部 const 收窄：data 是 let，属性访问不会被 TS 可靠收窄
  const categoryId = data.category;
  const { data: cat } = await safe(
    () => pb.collection('categories').getOne<{ name: string }>(categoryId),
    'post-category'
  );
  categoryName = cat?.name || '';
}
---

<BaseLayout title={data?.title || '文章不存在'} post={data || undefined} path={`/posts/${id}`} sideBar={hasToc} keywords={data ? [data.title, categoryName, ...Object.values(tagMap)].filter(Boolean).join(',') : undefined}>
  {data && safeHtml !== null ? (
    <Fragment>
      <div class="card-post relative">
        {data.top != 0 && <TopPin />}
        <article>
          <h1>
            {data.title}
            {isAuthenticated(pb) && site?.displayOptions?.showEditButton !== false && (
              <a
                href={`/admin/edit/${id}`}
                class="ml-3 text-sm font-normal text-[var(--text-muted)] hover:text-[var(--accent)] no-underline align-middle"
                title="编辑文章"
              >
                ✏️ 编辑
              </a>
            )}
          </h1>
          <p><small>
            发表于 {fmtDate(data.created)}
            {data.private && <span class="ml-2 text-[var(--text-muted)]">· 私有</span>}
            {data.status !== 'published' && <span class="ml-2 text-[var(--text-muted)]">· {data.status}</span>}
            {data.viewCount != null && <span class="ml-2 text-[var(--text-muted)]">· 阅读 {data.viewCount}</span>}
          </small></p>
          <ExpirationNotice
            created={data.created}
            updated={data.updated}
            show={site?.displayOptions?.showExpirationReminder !== false}
          />
          <div class="lg:hidden"><TocMobile html={safeHtml} /></div>
          <PostViewer html={safeHtml} />
          {site?.displayOptions?.showCopyRight !== false && <CopyRight site={site} post={data} />}

          {/* 标签 + 上下篇（原版 PostBottom） */}
          <div class="mt-6">
            {tagIds.length > 0 && (
              <div class="flex flex-wrap justify-center gap-x-3 gap-y-1 text-sm text-[var(--text-muted)] select-none mb-2">
                {tagIds.map((tid) => tagMap[tid] && (
                  <a href={`/tags/${tid}`} class="text-inherit no-underline border-b border-transparent hover:border-[var(--text-muted)]">
                    {tagMap[tid]}
                  </a>
                ))}
              </div>
            )}
            <hr class="border-[var(--border)]" />
            <div class="flex justify-between text-sm mt-3 whitespace-nowrap overflow-hidden gap-4">
              <div class="min-w-0 max-w-[50%] overflow-hidden text-ellipsis">
                {prePost && (
                  <a href={`/posts/${prePost.id}`} class="text-[var(--text-muted)] hover:text-[var(--text)] no-underline border-b border-dashed border-[var(--border)]">
                    {`< ${prePost.title}`}
                  </a>
                )}
              </div>
              <div class="min-w-0 max-w-[50%] overflow-hidden text-ellipsis text-right">
                {nextPost && (
                  <a href={`/posts/${nextPost.id}`} class="text-[var(--text-muted)] hover:text-[var(--text)] no-underline border-b border-dashed border-[var(--border)]">
                    {`${nextPost.title} >`}
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      </div>
      {site?.displayOptions?.showDonateButton !== false && data && <Reward site={site} />}

      {/* 评论区 + 返回首页仅在文章加载成功时渲染（错误态不显示） */}
      <hr />
      <Comments
        provider={site?.commentsProvider || 'disabled'}
        config={site?.commentsConfig || null}
      />
      <p><a href="/">← 返回首页</a></p>
    </Fragment>
  ) : passwordError ? (
    <div role="alert" class="my-8 p-4 rounded-lg border border-red-300 bg-red-50 dark:border-red-700 dark:bg-red-900/20">
      <p class="text-red-700 dark:text-red-300 text-sm">🔒 密码错误，请重试。</p>
      <p class="mt-2"><a href="/" class="text-[var(--accent)] text-sm">← 返回首页</a></p>
    </div>
  ) : (
    <ErrorNotice code="404" title="文章不存在" message="该文章可能已被删除、未发布，或你没有访问权限。" />
  )}

  {hasToc && (
    <Fragment slot="sideBar">
      <Toc html={safeHtml} />
    </Fragment>
  )}
</BaseLayout>

<script>
  // ── Mermaid: render + export toolbar ──
  import mermaid from 'mermaid';

  const isDark = () => document.documentElement.classList.contains('dark');
  mermaid.initialize({ startOnLoad: false, theme: isDark() ? 'dark' : 'default' });

  const mermaidCodes = document.querySelectorAll('code.language-mermaid');
  if (mermaidCodes.length > 0) {
    mermaidCodes.forEach((code) => {
      const wrapper = document.createElement('pre');
      wrapper.className = 'mermaid';
      wrapper.textContent = code.textContent;
      code.parentElement?.replaceWith(wrapper);
    });
    await mermaid.run();

    // Attach export toolbar to each rendered mermaid SVG
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const XLINK_NS = 'http://www.w3.org/1999/xlink';
    const LIGHT_BG = '#ffffff', DARK_BG = '#0f172a';

    function isTransparent(color: string | null | undefined): boolean {
      return !color || color === 'transparent' || color.startsWith('rgba(0, 0, 0, 0)');
    }
    function resolveBg(el: HTMLElement): string {
      let cur = el.parentElement;
      while (cur) {
        const bg = getComputedStyle(cur).backgroundColor;
        if (!isTransparent(bg)) return bg;
        cur = cur.parentElement;
      }
      return isDark() ? DARK_BG : LIGHT_BG;
    }
    function getSvgDim(svg: SVGSVGElement): { w: number; h: number } {
      const vb = svg.viewBox?.baseVal;
      if (vb && vb.width > 0 && vb.height > 0) return { w: vb.width, h: vb.height };
      const r = svg.getBoundingClientRect();
      if (r.width > 0 && r.height > 0) return { w: r.width, h: r.height };
      return { w: 1200, h: 800 };
    }
    function serializeSvg(svg: SVGSVGElement, bg: string): { w: number; h: number; markup: string } {
      const clone = svg.cloneNode(true) as SVGSVGElement;
      const { w, h } = getSvgDim(clone);
      clone.setAttribute('xmlns', SVG_NS);
      clone.setAttribute('xmlns:xlink', XLINK_NS);
      clone.setAttribute('viewBox', `0 0 ${w} ${h}`);
      clone.setAttribute('width', String(w));
      clone.setAttribute('height', String(h));
      const style = [clone.getAttribute('style'), `background:${bg}`, 'max-width:none'].filter(Boolean).join(';');
      clone.setAttribute('style', style);
      return { w, h, markup: `<?xml version="1.0" encoding="UTF-8"?>\n${new XMLSerializer().serializeToString(clone)}` };
    }
    function downloadFile(name: string, href: string): void {
      const a = document.createElement('a');
      a.download = name; a.href = href;
      document.body.appendChild(a); a.click(); a.remove();
    }
    function downloadSvg(container: HTMLElement): void {
      const svg = container.querySelector('svg');
      if (!svg) return;
      const { markup } = serializeSvg(svg, resolveBg(container));
      const url = URL.createObjectURL(new Blob([markup], { type: 'image/svg+xml;charset=utf-8' }));
      downloadFile(`diagram-${Date.now()}.svg`, url);
      setTimeout(() => URL.revokeObjectURL(url), 0);
    }
    async function downloadPng(container: HTMLElement): Promise<void> {
      const svg = container.querySelector('svg');
      if (!svg) return;
      const bg = resolveBg(container);
      const { w, h, markup } = serializeSvg(svg, bg);
      const dataUrl = await new Promise<string>((ok, no) => {
        const r = new FileReader();
        r.onload = () => ok(String(r.result));
        r.onerror = () => no(new Error('read failed'));
        r.readAsDataURL(new Blob([markup], { type: 'image/svg+xml;charset=utf-8' }));
      });
      const scale = 2;
      const c = document.createElement('canvas');
      c.width = Math.round(w * scale); c.height = Math.round(h * scale);
      const ctx = c.getContext('2d');
      if (!ctx) return;
      const img = await new Promise<HTMLImageElement>((ok, no) => { const i = new Image(); i.onload = () => ok(i); i.onerror = no; i.src = dataUrl; });
      ctx.fillStyle = bg; ctx.fillRect(0, 0, c.width, c.height);
      ctx.drawImage(img, 0, 0, c.width, c.height);
      downloadFile(`diagram-${Date.now()}.png`, c.toDataURL('image/png'));
    }
    function toolBtn(label: string, icon: string, onClick: () => Promise<void>): HTMLButtonElement {
      const b = document.createElement('button');
      b.type = 'button';
      b.title = label; b.setAttribute('aria-label', label);
      b.innerHTML = icon;
      b.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); onClick().catch(console.error); });
      return b;
    }
    const pngIcon = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="12" height="10" rx="2"/><circle cx="5.5" cy="6.2" r="1"/><path d="M4.5 11l2.2-2.3 1.8 1.8 1.6-1.6 1.4 2.1"/></svg>';
    const svgIcon = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="4" cy="4" r="1.5"/><circle cx="12" cy="4" r="1.5"/><circle cx="8" cy="12" r="1.5"/><path d="M5.5 4h5"/><path d="M4.9 5.3l2.2 4.2"/><path d="M11.1 5.3l-2.2 4.2"/></svg>';
    document.querySelectorAll<HTMLElement>('.mermaid').forEach((el) => {
      if (!el.querySelector('svg') || el.querySelector('.vb-mermaid-toolbar')) return;
      const tb = document.createElement('div');
      tb.className = 'vb-mermaid-toolbar';
      tb.setAttribute('role', 'group');
      tb.setAttribute('aria-label', '导出工具');
      tb.style.cssText = 'display:flex;gap:4px;position:absolute;top:4px;right:4px;z-index:10;opacity:0;transition:opacity .2s';
      tb.appendChild(toolBtn('导出 PNG', pngIcon, () => downloadPng(el)));
      tb.appendChild(toolBtn('导出 SVG', svgIcon, () => { downloadSvg(el); return Promise.resolve(); }));
      el.style.position = 'relative';
      el.appendChild(tb);
      el.addEventListener('mouseenter', () => tb.style.opacity = '1');
      el.addEventListener('mouseleave', () => tb.style.opacity = '0');
    });
  }

  // ── Code block enhancements: wrap toggle + collapse ──
  const MAX_LINES = 15;
  document.querySelectorAll<HTMLElement>('.code-block-wrapper').forEach((wrapper) => {
    const code = wrapper.querySelector('code');
    const header = wrapper.querySelector('.code-header');
    if (!code || !header) return;

    // --- wrap toggle ---
    const wrapBtn = document.createElement('span');
    wrapBtn.className = 'code-wrap-btn';
    wrapBtn.textContent = '换行';
    wrapBtn.style.cssText = 'cursor:pointer;margin-left:8px;font-size:12px;color:#6f7177';
    wrapBtn.addEventListener('click', () => {
      const enabled = code.classList.toggle('code-wrap-enabled');
      wrapBtn.textContent = enabled ? '不换行' : '换行';
    });
    header.appendChild(wrapBtn);

    // --- collapse long blocks ---
    const lines = (code.textContent || '').trim().split('\n');
    const nonEmpty = lines.filter((l) => l.trim());
    if (lines.length > MAX_LINES || nonEmpty.length > MAX_LINES - 3) {
      code.classList.add('code-collapsed');
      const toggleBtn = document.createElement('span');
      toggleBtn.className = 'code-toggle-btn';
      toggleBtn.textContent = '展开';
      toggleBtn.style.cssText = 'cursor:pointer;margin-left:8px;font-size:12px;color:#6f7177';
      toggleBtn.addEventListener('click', () => {
        const collapsed = code.classList.toggle('code-collapsed');
        toggleBtn.textContent = collapsed ? '展开' : '收起';
      });
      header.appendChild(toggleBtn);
    }
  });
</script>

