<!--
⛔ AGENT: DO NOT EDIT THIS BLOCK
L0 CONTRACT - 前端契约变量（见 .snow/plan/migrate-vanblog-frontend-to-theme-palette.md §模板契约清单）
页面: 标签详情
路径: themes/vanblog/src/pages/tag/[tag].astro
契约变量:
  - tag: Tag — 当前标签
  - posts: PostExpand[] — 该标签下的文章
-->

---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorCard from '../../components/AuthorCard.astro';
import ArticleList from '../../components/ArticleList.astro';
import ErrorState from '../../components/ErrorState.astro';
import { safe } from '@vanblog/sdk';
import type { Tag } from '@vanblog/sdk';
import { getAuthorCardProps } from '../../lib/viewModel';
import { withBase } from '../../lib/base';

const pb = Astro.locals.pb;
const { tag: name } = Astro.params;
if (!name) return Astro.redirect('/404');
// Astro params 是原始(未解码)段;Next 对路径参数自动解码,此处对齐。
const decoded = (() => { try { return decodeURIComponent(name); } catch { return name; } })();

let tag: Tag;
try {
  tag = await pb.collection('tags').getFirstListItem<Tag>(`name="${decoded.replace(/"/g, '\\"')}"`);
} catch {
  return Astro.redirect('/404');
}

const { data: result } = await safe(
  // 原版 getTagPagesProps(params.tag) 按标签名取;relation 过滤仍用 tag.id
  () => pb.vanblog.posts.listPublished(1, 500, { tag: tag.id, sort: '-created' }),
  'tag',
);
const posts = result?.items ?? [];
const error = !result;
const wordTotal = posts.reduce((sum, p) => sum + (p.content?.length || 0), 0);
const site = await Astro.locals.getSite();
const authorCard = await getAuthorCardProps(pb, site);
const openInNewWindow = site?.displayOptions?.openArticleLinksInNewWindow === true;

// 原版 washArticlesByKey：按年份分组，年份倒序，组内日期倒序（已按 -created 排序）
const grouped = posts.reduce<Record<string, { id: string; title: string; created?: string }[]>>((acc, p) => {
  if (!p.id) return acc;
  const d = p.created ? new Date(p.created) : null;
  if (!d || Number.isNaN(d.getTime())) return acc;
  const year = String(d.getFullYear());
  (acc[year] ||= []).push({ id: p.id, title: p.title, created: p.created });
  return acc;
}, {});
const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout title={`#${tag.name}`} path={`/tag/${encodeURIComponent(name)}`} sideBar>
  <a href={withBase('/tag')} class="text-sm text-[var(--text-muted)] hover:text-[var(--accent)] mb-4 inline-block">
    ← 所有标签
  </a>

  <div class="card-post py-4 px-8 md:py-6 md:px-8">
    <div class="text-2xl text-[var(--text)] text-center">#{tag.name}</div>
    <div class="text-center text-sm text-[var(--text-muted)] mt-2 mb-4 font-light">
      {posts.length} 文章 × {wordTotal} 字
    </div>
    {tag.description && <p class="text-center text-[var(--text-muted)] mb-4">{tag.description}</p>}

    {error ? (
      <ErrorState />
    ) : posts.length === 0 ? (
      <p class="py-8 text-center text-[var(--text-muted)]">该标签下暂无文章。</p>
    ) : (
      <div class="space-y-3">
        {years.map((year) => (
          <details open>
            <summary class="cursor-pointer text-sm font-semibold text-[var(--text-muted)] select-none list-none py-1">
              {year}
            </summary>
            <ArticleList items={grouped[year]} showYear openInNewWindow={openInNewWindow} />
          </details>
        ))}
      </div>
    )}
  </div>

  <Fragment slot="sideBar">
    <AuthorCard {...authorCard} />
  </Fragment>
</BaseLayout>
