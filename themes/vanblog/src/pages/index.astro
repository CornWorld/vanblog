<!--
⛔ AGENT: DO NOT EDIT THIS BLOCK
L0 CONTRACT - 前端契约变量（见 .snow/plan/migrate-vanblog-frontend-to-theme-palette.md §模板契约清单）
页面: 首页
路径: themes/vanblog/src/pages/index.astro
契约变量:
  - posts: PostExpand[] — 文章列表
  - totalPages: number — 总页数
  - page: number — 当前页码
-->
---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import HomeArticleList from '../components/HomeArticleList.astro';
import AuthorCard from '../components/AuthorCard.astro';
import PageNav from '../vendor/PageNav';
import { getPage } from '@vanblog/sdk';
import { getAuthorCardProps } from '../lib/viewModel';
import { loadHomeFeed } from '../lib/home';

const pb = Astro.locals.pb;

// 每页 5 篇，与原版 getIndexPageProps 的 pageSize: 5 一致。
const page = getPage(Astro.url.searchParams);

const site = await Astro.locals.getSite();
// 串行：同一 pb client 并发请求会触发 SDK auto-cancel。
const feed = await loadHomeFeed(pb, page);
const authorCard = await getAuthorCardProps(pb, site);
const { loadError, posts, totalPages, overviews, keywords } = feed;

// displayOptions(openArticleLinksInNewWindow);过期提醒仅文章详情页(原版语义)
const displayOptions = site?.displayOptions;
---

<BaseLayout path="/" sideBar keywords={keywords}>
  <HomeArticleList
    loadError={loadError}
    posts={posts}
    overviews={overviews}
    encryptedHtml={feed.encryptedHtml}
    openInNewWindow={!!displayOptions?.openArticleLinksInNewWindow}
  />

  {!loadError && totalPages > 1 && (
    <PageNav total={authorCard.postNum} current={page} base="/" more="/page" />
  )}

  <Fragment slot="sideBar">
    <AuthorCard {...authorCard} />
  </Fragment>
</BaseLayout>

<script>
  // 首页概览也渲染 mermaid（对齐原版 bytemd Viewer 概览行为）
  import '../lib/homeMermaid';
</script>
