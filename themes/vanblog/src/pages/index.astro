<!--
⛔ AGENT: DO NOT EDIT THIS BLOCK
L0 CONTRACT - 前端契约变量（见 .snow/plan/migrate-vanblog-frontend-to-theme-palette.md §模板契约清单）
页面: 首页
路径: themes/vanblog/src/pages/index.astro
契约变量:
  - posts: PostExpand[] — 文章列表
  - totalPages: number — 总页数
  - page: number — 当前页码
-->
---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AuthorCard from '../components/AuthorCard.astro';
import PageNav from '../components/PageNav.astro';
import ErrorState from '../components/ErrorState.astro';
import { safe, getPage } from '@vanblog/sdk';
import { getAuthorCardProps } from '../lib/viewModel';
import { sanitizeHtml } from '../lib/sanitizeHtml';
import { renderMarkdown } from '@vanblog/base/lib/markdown/renderer';

const pb = Astro.locals.pb;

// 每页 5 篇，与原版 getIndexPageProps 的 pageSize: 5 一致。
const perPage = 5;
const page = getPage(Astro.url.searchParams);

const { data: result, error: loadError } = await safe(
  () => pb.vanblog.posts.listPublished(page, perPage, { expand: 'category,tags' }),
  'index'
);
const posts = result?.items ?? [];
const totalPages = result?.totalPages ?? 1;

// AuthorCard 侧栏 view model（原版 getPageProps → getAuthorCardProps）。
const site = await Astro.locals.getSite();
const authorCard = await getAuthorCardProps(pb, site);

// displayOptions（showExpirationReminder / openArticleLinksInNewWindow）
const displayOptions = site?.displayOptions;

// keywords = 文章 tag + 分类名 去重（原版 getArticlesKeyWord 语义）。
const keywords = Array.from(
  new Set(
    posts.flatMap((p) =>
      [p.expand?.category?.name, ...(p.expand?.tags ?? []).map((t) => t.name)].filter(Boolean),
    ) as string[],
  ),
).join(',');

// 首页概览：渲染真实 Markdown（原版 PostCard type="overview"，截到 <!-- more -->）。
const overviews = await Promise.all(
  posts.map(async (post) => {
    const md = post.content || '';
    const parts = md.split('<!-- more -->');
    const overviewMd = parts.length > 1 ? parts[0] : md.substring(0, 50);
    if (!overviewMd.trim()) return '';
    try {
      const { code } = await renderMarkdown(overviewMd);
      return sanitizeHtml(code);
    } catch (e) {
      console.error('[index] overview render:', e);
      return '';
    }
  })
);
---

<BaseLayout path="/" sideBar keywords={keywords}>
  {
    loadError ? (
      <ErrorState />
    ) : posts.length === 0 ? (
      <p class="py-12 text-center text-[var(--text-muted)]">暂无文章。</p>
    ) : (
      <div class="space-y-2 md:space-y-4">
        {posts.map((post, i) => (
          <ArticleCard
            post={post}
            overviewHtml={overviews[i] || undefined}
            showExpirationReminder={displayOptions?.showExpirationReminder !== false}
            openInNewWindow={!!displayOptions?.openArticleLinksInNewWindow}
          />
        ))}
      </div>
    )
  }

  {!loadError && totalPages > 1 && (
    <PageNav page={page} totalPages={totalPages} baseUrl="/" />
  )}

  <Fragment slot="sideBar">
    <AuthorCard {...authorCard} />
  </Fragment>
</BaseLayout>
