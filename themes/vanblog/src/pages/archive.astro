<!--
⛔ AGENT: DO NOT EDIT THIS BLOCK
L0 CONTRACT - 前端契约变量（见 .snow/plan/migrate-vanblog-frontend-to-theme-palette.md §模板契约清单）
页面: 归档
路径: themes/vanblog/src/pages/archive.astro
契约变量:
  - posts: Post[] — 所有文章
  - years: number[] — 年份列表
-->

---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ErrorState from '../components/ErrorState.astro';
import SiteStatsSummary from '../components/SiteStatsSummary.astro';
import { fmtDate, safe } from '@vanblog/sdk';
import type { Post } from '@vanblog/sdk';
const pb = Astro.locals.pb;

const { data: result } = await safe(
  () => pb.vanblog.posts.listPublished(1, 500, { sort: '-created' }),
  'archive'
);
const posts = result?.items ?? [];
const error = !result;

// Site stats
const postCount = result?.totalItems ?? posts.length;
const categories = await safe(() => pb.collection('categories').getFullList(), 'archive-categories');
const categoryCount = categories.data?.length ?? 0;
const tags = await safe(() => pb.collection('tags').getFullList(), 'archive-tags');
const tagCount = tags.data?.length ?? 0;
const totalChars = posts.reduce((sum: number, p: Post) => sum + (p.content?.length || 0), 0);
const statsOk = !!(result && categories.data && tags.data);

// Group by year
const byYear: Record<number, Post[]> = {};
for (const post of posts) {
  const created = post.created;
  if (!created) continue;
  const year = new Date(created.replace(' ', 'T')).getFullYear();
  if (!byYear[year]) byYear[year] = [];
  byYear[year].push(post);
}
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---
<BaseLayout title="归档" path="/archive">
  <h1 class="mb-8">归档</h1>
  {statsOk && (
    <SiteStatsSummary
      postCount={postCount}
      categoryCount={categoryCount}
      tagCount={tagCount}
      totalWords={totalChars}
    />
  )}
  {
    error ? (
      <ErrorState />
    ) : years.length === 0 ? (
      <p class="py-12 text-center text-[var(--text-muted)]">暂无文章。</p>
    ) : (
      <div class="space-y-8">
        {years.map(year => (
          <section>
            <h2 class="text-2xl mb-4 pb-2 border-b border-[var(--border)]">{year}</h2>
            <ul class="space-y-2">
              {byYear[year].map(post => (
                <li class="flex items-baseline gap-3">
                  <time class="text-sm text-[var(--text-muted)] whitespace-nowrap tabular-nums"
                        datetime={post.created}>
                    {fmtDate(post.created)}
                  </time>
                  <a href={`/posts/${post.id}`} class="hover:text-[var(--accent)]">{post.title}</a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    )
  }
</BaseLayout>
