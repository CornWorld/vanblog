<!--
⛔ AGENT: DO NOT EDIT THIS BLOCK
L0 CONTRACT - 前端契约变量（见 .snow/plan/migrate-vanblog-frontend-to-theme-palette.md §模板契约清单）
页面: 归档
路径: themes/vanblog/src/pages/archive.astro
契约变量:
  - posts: Post[] — 所有文章
  - years: number[] — 年份列表
-->
---
export const prerender = false;

import { articlePath } from '../lib/base';
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import TimeLineItem from '../vendor/TimeLineItem';
import ErrorState from '../components/ErrorState.astro';
import { safe } from '@vanblog/sdk';
import type { Post } from '@vanblog/sdk';
import { getAuthorCardProps } from '../lib/viewModel';
const pb = Astro.locals.pb;

const { data: result, error } = await safe(
  () => pb.vanblog.posts.listPublished(1, 500, { sort: '-created' }),
  'archive'
);
const posts = result?.items ?? [];
const postCount = result?.totalItems ?? posts.length;
const totalChars = posts.reduce((sum: number, p: Post) => sum + (p.content?.length || 0), 0);

// AuthorCard 侧栏 view model（归档非原版页面，但与其他内容页保持一致）。
const site = await Astro.locals.getSite();
const authorCard = await getAuthorCardProps(pb, site);

// Group by year
const byYear: Record<number, Post[]> = {};
for (const post of posts) {
  const created = post.created;
  if (!created) continue;
  const year = new Date(created.replace(' ', 'T')).getFullYear();
  if (!byYear[year]) byYear[year] = [];
  byYear[year].push(post);
}
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---
<BaseLayout title="归档" path="/archive" sideBar>
  <div class="bg-white card-shadow dark:bg-dark dark:card-shadow-dark py-4 px-8 md:py-6 md:px-8">
    <div>
      <div class="text-2xl md:text-3xl text-gray-700 text-center dark:text-dark">归档</div>
      <div class="text-center text-gray-600 text-sm mt-2 mb-4 font-light dark:text-dark">{`${authorCard.categoryNum} 分类 × ${postCount} 文章 × ${authorCard.tagNum} 标签 × ${totalChars} 字`}</div>
    </div>
    <div class="flex flex-col mt-2">
      {
        error ? (
          <ErrorState />
        ) : years.length === 0 ? (
          <p class="py-8 text-center text-[var(--text-muted)]">暂无文章。</p>
        ) : (
          years.map(year => (
            <TimeLineItem
              client:load
              date={String(year)}
              articles={byYear[year].map(post => ({ id: post.id ?? '', title: post.title, createdAt: post.created ?? '', path: articlePath(post.pathname) }))}
              defaultOpen={false}
              showYear={true}
              openArticleLinksInNewWindow={site?.displayOptions?.openArticleLinksInNewWindow === true}
            />
          ))
        )
      }
    </div>
  </div>

  <Fragment slot="sideBar">
    <AuthorCard {...authorCard} />
  </Fragment>
</BaseLayout>
