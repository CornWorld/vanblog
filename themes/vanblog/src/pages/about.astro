<!--
⛔ AGENT: DO NOT EDIT THIS BLOCK
L0 CONTRACT - 前端契约变量（见 .snow/plan/migrate-vanblog-frontend-to-theme-palette.md §模板契约清单）
页面: 关于
路径: themes/vanblog/src/pages/about.astro
契约变量:
  - site: Site — 站点配置
  - html: string — 渲染后的 Markdown 内容
  - updatedAt: string — 最后更新时间
-->

---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import { renderMarkdown } from '@vanblog/base/lib/markdown/renderer';
import { getAuthorCardProps } from '../lib/viewModel';
import { sanitizeHtml } from '../lib/sanitizeHtml';

Astro.cache.set(false);

// About page is the public rendering of site.aboutContent. Markdown source
// lives on the site record (edited in /admin/site) so this page just renders
// whatever the admin wrote. Empty content → blank page rather than 404:
// users commonly leave the field blank until they have something to say.
const site = await Astro.locals.getSite();
const pb = Astro.locals.pb;
// AuthorCard sidebar view model（原版 getPageProps → authorCardProps）。
const authorCard = await getAuthorCardProps(pb, site);

const raw = site?.aboutContent || '';
const updatedAt = site?.aboutUpdatedAt;
const rewards = site?.rewards ?? [];
const showDonateInfo = site?.displayOptions?.showDonateInfo !== false;

// 原版 about.tsx：showDonateInfo != "false" 且有捐赠记录时，
// 在正文末尾追加「## 捐赠信息」表格。新平台无捐赠时间字段，故为两列表。
const donateTable =
  showDonateInfo && rewards.length > 0
    ? [
        '',
        '## 捐赠信息',
        '',
        '| 捐赠人 | 捐赠金额 |',
        '|---|---|',
        ...rewards.map((r) => `|${r.name}|${r.value}|`),
        '',
      ].join('\n')
    : '';

const content = `${raw}${donateTable}`;

let html = '';
if (content.trim()) {
  try {
    const { code } = await renderMarkdown(content);
    html = sanitizeHtml(code);
  } catch (e) {
    console.error('[about] render:', e);
  }
}
---

<BaseLayout title="关于我" path="/about" sideBar>
  <article class="card-post relative">
    {/* 原版 PostCard type="about"：居中标题 + 副标题（更新时间）+ 正文 */}
    <div class="flex justify-center post-card-title mb-2 mt-2">
      <div class="text-lg md:text-2xl font-medium text-[var(--text)] select-none">关于我</div>
    </div>
    <div class="text-center text-xs md:text-sm divide-x divide-[var(--border)] text-[var(--text-muted)] post-card-sub-title flex justify-center items-center">
      {updatedAt && (
        <span class="inline-flex px-2 items-center">
          <time datetime={updatedAt}>更新于 {new Date(updatedAt).toLocaleDateString('zh-CN')}</time>
        </span>
      )}
    </div>
    <div class="text-sm md:text-base text-[var(--text)] mt-4 mx-2">
      {html ? (
        <div class="post-viewer" set:html={html} />
      ) : (
        <p class="text-[var(--text-muted)]">暂无内容。</p>
      )}
    </div>
  </article>

  <Fragment slot="sideBar">
    <AuthorCard {...authorCard} />
  </Fragment>
</BaseLayout>
