<!--
⛔ AGENT: DO NOT EDIT THIS BLOCK
L0 CONTRACT - 前端契约变量（见 .snow/plan/migrate-vanblog-frontend-to-theme-palette.md §模板契约清单）
页面: 关于
路径: themes/vanblog/src/pages/about.astro
契约变量:
  - site: Site — 站点配置
  - html: string — 渲染后的 Markdown 内容
  - updatedAt: string — 最后更新时间
-->

---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { renderMarkdown } from '@vanblog/base/lib/markdown/renderer';

Astro.cache.set(false);

// About page is the public rendering of site.aboutContent. Markdown source
// lives on the site record (edited in /admin/site) so this page just renders
// whatever the admin wrote. Empty content → blank page rather than 404:
// users commonly leave the field blank until they have something to say.
const site = await Astro.locals.getSite();
const content = site?.aboutContent || '';
const updatedAt = site?.aboutUpdatedAt;

let html = '';
if (content.trim()) {
  try {
    const { code } = await renderMarkdown(content);
    html = code;
  } catch (e) {
    console.error('[about] render:', e);
  }
}
---

<BaseLayout title="关于" path="/about">
  <article>
    <h1>关于</h1>
    {html ? (
      <div set:html={html} />
    ) : (
      <p>暂无内容。</p>
    )}
    {updatedAt && (
      <p><small>更新于 {new Date(updatedAt).toLocaleDateString('zh-CN')}</small></p>
    )}
  </article>
</BaseLayout>
