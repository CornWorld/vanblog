---
export interface Props {
  html: string;
}

const { html } = Astro.props;
---

<div class="post-viewer">
  <Fragment set:html={html} />
</div>

<script is:inline>
  (() => {
    // Image click zoom (lightweight modal)
    const viewer = document.querySelector('.post-viewer');
    if (!viewer) return;

    let modal = null;

    function openZoom(img) {
      if (modal) return;
      modal = document.createElement('div');
      modal.setAttribute('role', 'dialog');
      modal.setAttribute('aria-modal', 'true');
      modal.setAttribute('aria-label', 'Image zoom');
      modal.className = 'medium-zoom';
      modal.style.cssText =
        'position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;' +
        'background:rgba(0,0,0,0.8);cursor:zoom-out;padding:2rem;';

      const cloned = img.cloneNode(true);
      cloned.style.cssText = 'max-width:100%;max-height:100%;object-fit:contain;border-radius:4px;';
      modal.append(cloned);

      modal.addEventListener('click', closeZoom);
      document.addEventListener('keydown', onKeyDown);
      document.body.style.overflow = 'hidden';
      document.body.append(modal);
    }

    function closeZoom() {
      if (!modal) return;
      modal.remove();
      modal = null;
      document.removeEventListener('keydown', onKeyDown);
      document.body.style.overflow = '';
    }

    function onKeyDown(e) {
      if (e.key === 'Escape') closeZoom();
    }

    viewer.addEventListener('click', (e) => {
      const target = e.target;
      if (target.tagName === 'IMG') {
        openZoom(target);
      }
    });
  })();
</script>
<style>
  :global(.medium-zoom) img {
    animation: zoom-fade-in 0.2s ease;
  }
  @keyframes zoom-fade-in {
    from { opacity: 0; transform: scale(0.9); }
    to   { opacity: 1; transform: scale(1); }
  }
</style>
