---
// Multi-provider comment system component.
// Renders the appropriate comment widget based on site.commentsProvider.
//
// Props:
//   provider: 'disabled' | 'artalk' | 'external'
//   config:  provider-specific configuration from site.commentsConfig

export interface Props {
  provider: string;
  config?: Record<string, unknown> | null;
}
const { provider, config } = Astro.props;
const server = String(config?.server || '').replace(/\/+$/, '');
---

{provider === 'disabled' || !provider ? null : (
  <div id="vanblog-comments" class="mt-8 pt-6 border-t border-[var(--border)]">
    {provider === 'artalk' && (
      <>
        <link href={`${server}/dist/Artalk.css`} rel="stylesheet" />
        <div id="artalk-container"></div>
        <script src={`${server}/dist/Artalk.js`}></script>
        <script is:inline data-server={server} data-site={String(config?.site || 'VanBlog')}>
          (() => {
            const server = document.currentScript.dataset.server;
            const site = document.currentScript.dataset.site;
            const el = document.getElementById('artalk-container');
            if (!el || typeof Artalk === 'undefined') return;
            const getDark = () => document.documentElement.classList.contains('dark');
            Artalk.init({
              el: '#artalk-container',
              server,
              site,
              pageKey: window.location.pathname,
              darkMode: getDark() ? 'dark' : false,
            });
            // Sync with global dark mode toggle
            document.documentElement.addEventListener('darkmodechange', (e) => {
              Artalk.ui?.setDarkMode(e.detail?.dark ?? getDark());
            });
          })();
        </script>
      </>
    )}

    {provider === 'external' && (
      <Fragment set:html={String(config?.customScript || '')} />
    )}
  </div>
)}
