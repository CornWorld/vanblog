---
// Footer = vendor Footer island(UPSTREAM Footer/index.tsx:ICP/公安备案/
// RunningTime/Powered By/©/全站访客)。本文件做平台 site 字段映射:
// beianNumber→ipcNumber(原版语义即 ICP),since 取站点创建时间。
import FooterIsland from '../vendor/Footer';

interface Props {
  site: Record<string, any> | null;
}

const { site } = Astro.props;
const since = site?.created || '';
---

<FooterIsland
  client:load
  ipcNumber={site?.beianNumber || ''}
  ipcHref={site?.beianUrl || 'https://beian.miit.gov.cn/'}
  gaBeianNumber={site?.gaBeianNumber || ''}
  gaBeianUrl={site?.gaBeianUrl || ''}
  gaBeianLogoUrl={site?.gaBeianLogoUrl || ''}
  since={since}
  version=""
/>
