---
// Author card sidebar (migrated from mereithhh vanblog website/components/AuthorCard).
// Sticky right-sidebar card: avatar + name + description + stats (日志/分类/标签)
// + social links + RSS. Rendered inside BaseLayout's `sideBar` slot (vanblog-sider).
// Props come from the shared view model (src/lib/viewModel.ts → getAuthorCardProps),
// mirroring the original AuthorCardProps contract.
import SocialLinks from './SocialLinks.astro';
import type { SocialItem } from '@vanblog/sdk';

export interface Props {
  author: string;
  desc: string;
  logo: string;
  logoDark: string;
  postNum: number;
  categoryNum: number;
  tagNum: number;
  socials: SocialItem[];
  showRSS?: boolean;
}

const {
  author,
  desc,
  logo,
  logoDark,
  postNum,
  categoryNum,
  tagNum,
  socials,
  showRSS = true,
} = Astro.props;
---

<div class="sticky top-20">
  <div class="flex flex-col items-center bg-[var(--surface)] pt-6 pb-4 card-shadow ml-2">
    <div class="px-6 flex flex-col justify-center items-center text-center">
      {logo && (
        <div class="relative">
          {logo && (
            <img
              src={logo}
              alt={author}
              width={120}
              height={120}
              loading="lazy"
              class="rounded-full w-[120px] h-[120px] object-cover dark:hidden"
            />
          )}
          {logoDark && (
            <img
              src={logoDark}
              alt={author}
              width={120}
              height={120}
              loading="lazy"
              class="rounded-full w-[120px] h-[120px] object-cover hidden dark:block"
            />
          )}
        </div>
      )}
      <div class="mt-2 font-semibold text-[var(--text)] mb-2">{author}</div>
      {desc && <div class="text-sm text-[var(--text-muted)] mb-2">{desc}</div>}
      <div class="flex">
        <a href="/timeline" class="group flex flex-col justify-center items-center text-sm px-1 no-underline">
          <div class="font-bold text-[var(--text)] group-hover:text-[var(--accent)]">{postNum}</div>
          <div class="text-[var(--text-muted)] group-hover:text-[var(--accent)]">日志</div>
        </a>
        <a href="/categories" class="group flex flex-col justify-center items-center text-sm px-1 no-underline">
          <div class="font-bold text-[var(--text)] group-hover:text-[var(--accent)]">{categoryNum}</div>
          <div class="text-[var(--text-muted)] group-hover:text-[var(--accent)]">分类</div>
        </a>
        <a href="/tags" class="group flex flex-col justify-center items-center text-sm px-1 no-underline">
          <div class="font-bold text-[var(--text)] group-hover:text-[var(--accent)]">{tagNum}</div>
          <div class="text-[var(--text-muted)] group-hover:text-[var(--accent)]">标签</div>
        </a>
      </div>
    </div>

    {socials.length > 0 && <div class="w-full"><SocialLinks socials={socials} /></div>}

    {showRSS && (
      <div class="mt-3 w-full flex justify-center">
        <a
          href="/api/feed.xml"
          target="_blank"
          rel="noreferrer"
          class="flex items-center text-sm text-[var(--text-muted)] hover:text-[var(--accent)] no-underline transition-colors px-2 py-1"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18ZM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44Zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z" />
          </svg>
          <span class="ml-1">RSS</span>
        </a>
      </div>
    )}
  </div>
</div>
