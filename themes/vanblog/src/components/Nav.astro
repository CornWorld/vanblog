---
import type { Site } from '@vanblog/sdk';

interface NavEntry {
  label: string;
  href: string;
  external?: boolean;
}

interface Props {
  site: Partial<Site> | null;
  isLoggedIn: boolean;
  /** Pack nav items resolved by the Astro Pack integration, passed from BaseLayout. */
  packNavItems?: { label: string; href: string }[];
  /** Categories for the sub-menu row (migrated from original NavBar showSubMenu). */
  categories?: { id: string; name: string }[];
}

const { site, isLoggedIn, packNavItems = [], categories = [] } = Astro.props;
const siteName = site?.siteName || 'Vanblog';
const hasAbout = !!(site?.aboutContent && site.aboutContent.trim());
const hasLinks = (site?.links?.length ?? 0) > 0;

// Custom nav (site.nav) wins over the default menu — matches the original
// config-driven NavBar. "value" containing "http" is rendered as an external link.
const customNav: NavEntry[] = (site?.nav ?? []).map((n) => ({
  label: n.name,
  href: n.value,
  external: n.value.includes('http'),
}));
const defaultNav: NavEntry[] = [
  { label: '首页', href: '/' },
  { label: '归档', href: '/archive' },
  { label: '时间轴', href: '/timeline' },
  { label: '标签', href: '/tags' },
  { label: '分类', href: '/categories' },
  ...packNavItems.map((p) => ({ label: p.label, href: p.href })),
  ...(hasLinks ? [{ label: '友链', href: '/link' }] : []),
  ...(hasAbout ? [{ label: '关于', href: '/about' }] : []),
];
const nav = customNav.length > 0 ? customNav : defaultNav;

// Header-left content (migrated from original displayOptions).
const headerLeftContent = site?.displayOptions?.headerLeftContent || 'siteName';
const siteLogo = site?.siteLogo;
const siteLogoDark = site?.siteLogoDark;
const sitePalette = site?.palette || '';
const subMenuOffset = site?.displayOptions?.subMenuOffset || 0;
const showRSS = site?.displayOptions?.showRSS !== false;
---

<!--
  原版 NavBar 样式对齐：白底通栏 nav-shadow（h-14 主行 + h-10 分类子菜单行），
  左侧 hamburger + logo(52px)/站点名，菜单项 nav-item + ua 下划线动画 + hover:scale-110，
  右侧 搜索图标+⌘K / 调色盘(太阳月亮图标) / RSS(复制订阅地址) / 管理图标。
-->
<header id="vanblog-nav" class="bg-[var(--surface)] sticky top-0 z-10 card-shadow">
  <!-- 主导航行（原版 h-14 / 56px） -->
  <div class="flex items-center w-full border-b border-[var(--border)] h-14">
    <div class="mx-4 flex items-center gap-1">
      <!-- 移动端汉堡按钮 -->
      <button
        id="nav-hamburger"
        type="button"
        class="block md:hidden cursor-pointer text-[var(--text-muted)]"
        aria-label="打开菜单"
        aria-expanded="false"
      >
        <svg viewBox="0 0 1024 1024" width="24" height="24" fill="currentColor" aria-hidden="true">
          <path d="M904 160H120c-4.4 0-8 3.6-8 8v64c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-64c0-4.4-3.6-8-8-8zM904 784H120c-4.4 0-8 3.6-8 8v64c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-64c0-4.4-3.6-8-8-8zM904 472H120c-4.4 0-8 3.6-8 8v64c0 4.4 3.6 8 8 8h784c4.4 0 8-3.6 8-8v-64c0-4.4-3.6-8-8-8z" />
        </svg>
      </button>
      <!-- Logo（headerLeftContent=siteLogo，52px，明暗双图切换） -->
      {headerLeftContent === 'siteLogo' && siteLogo && (
        <a href="/" class="hidden md:block shrink-0" aria-label={siteName}>
          <img src={siteLogo} alt={siteName} width={52} height={52} class="dark:hidden" />
          {siteLogoDark && <img src={siteLogoDark} alt={siteName} width={52} height={52} class="hidden dark:block" />}
        </a>
      )}
    </div>

    <!-- 站点名（headerLeftContent=siteName，桌面端） -->
    {headerLeftContent === 'siteName' && (
      <a href="/" class="hidden md:block text-[var(--text)] cursor-pointer select-none text-lg lg:text-xl font-medium mr-4 no-underline">
        {siteName}
      </a>
    )}

    <!-- 第二个 flex：移动端居中站点名 + 桌面菜单 + 操作区 -->
    <div class="flex justify-between h-full flex-grow">
      <!-- 移动端居中站点名 -->
      <div class="md:hidden flex-grow text-center flex items-center justify-center text-[var(--text)] select-none">
        <a href="/" class="no-underline">{siteName}</a>
      </div>

      <!-- 桌面端菜单（原版 nav-item + ua 下划线动画 + hover:scale-110） -->
      <ul class="hidden md:flex h-full items-center text-sm text-[var(--text-muted)]">
        {nav.map((item) => (
          <li class="nav-item ua transform hover:scale-110 transition-all">
            <a
              href={item.href}
              class="h-full flex items-center px-2 md:px-4 text-inherit no-underline"
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- 操作区（搜索 / 调色盘 / RSS / 管理登录） -->
      <div class="flex items-center">
        <!-- 搜索（放大镜 + ⌘K 快捷键徽标） -->
        <button id="search-open-btn" type="button" title="搜索" aria-label="搜索"
                class="flex items-center transform hover:scale-110 transition-all select-none cursor-pointer text-[var(--text-muted)]">
          <svg viewBox="0 0 1024 1024" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M789.804097 737.772047 742.865042 784.699846 898.765741 940.600545 945.704796 893.672746Z" />
            <path d="M456.92259 82.893942c-209.311143 0-379.582131 170.282245-379.582131 379.582131s170.270988 379.570875 379.582131 379.570875c209.287607 0 379.558595-170.270988 379.558595-379.570875S666.210197 82.893942 456.92259 82.893942zM770.128989 462.477097c0 172.721807-140.508127 313.229934-313.206398 313.229934-172.720783 0-313.229934-140.508127-313.229934-313.229934s140.508127-313.229934 313.229934-313.229934C629.620861 149.247162 770.128989 289.75529 770.128989 462.477097z" />
          </svg>
          <span id="nav-search-key" class="hidden sm:flex items-center text-sm text-[var(--text-muted)] ml-2 py-0.5 px-1.5 border border-[var(--border)] rounded-md leading-5">
            <kbd>Ctrl</kbd><span class="mx-1">+</span><kbd>K</kbd>
          </span>
        </button>

        <!-- 调色盘/主题（原版 ThemeButton 太阳/月亮图标，点击开调色盘面板） -->
        <div class="relative">
          <button
            id="palette-toggle"
            type="button"
            aria-label="切换调色盘"
            title="切换调色盘"
            data-site-palette={sitePalette}
            class="flex items-center cursor-pointer hover:scale-125 transform transition-all mx-4 sm:ml-2 lg:ml-6 text-[var(--text-muted)]"
          >
            <svg id="palette-icon-sun" viewBox="0 0 1024 1024" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M952 552h-80a40 40 0 0 1 0-80h80a40 40 0 0 1 0 80zM801.88 280.08a41 41 0 0 1-57.96-57.96l57.96-58a41.04 41.04 0 0 1 58 58l-58 57.96zM512 752a240 240 0 1 1 0-480 240 240 0 0 1 0 480zm0-560a40 40 0 0 1-40-40V72a40 40 0 0 1 80 0v80a40 40 0 0 1-40 40zm-289.88 88.08-58-57.96a41.04 41.04 0 0 1 58-58l57.96 58a41 41 0 0 1-57.96 57.96zM192 512a40 40 0 0 1-40 40H72a40 40 0 0 1 0-80h80a40 40 0 0 1 40 40zm30.12 231.92a41 41 0 0 1 57.96 57.96l-57.96 58a41.04 41.04 0 0 1-58-58l58-57.96zM512 832a40 40 0 0 1 40 40v80a40 40 0 0 1-80 0v-80a40 40 0 0 1 40-40zm289.88-88.08 58 57.96a41.04 41.04 0 0 1-58 58l-57.96-58a41 41 0 0 1 57.96-57.96z" />
            </svg>
            <svg id="palette-icon-moon" viewBox="0 0 1024 1024" width="20" height="20" fill="currentColor" aria-hidden="true" class="hidden">
              <path d="M524.8 938.667h-4.267a439.893 439.893 0 0 1-313.173-134.4 446.293 446.293 0 0 1-11.093-597.334A432.213 432.213 0 0 1 366.933 90.027a42.667 42.667 0 0 1 45.227 9.386 42.667 42.667 0 0 1 10.24 42.667 358.4 358.4 0 0 0 82.773 375.893 361.387 361.387 0 0 0 376.747 82.774 42.667 42.667 0 0 1 54.187 55.04 433.493 433.493 0 0 1-99.84 154.88 438.613 438.613 0 0 1-311.467 128z" />
            </svg>
          </button>
          <div id="palette-panel" class="hidden absolute right-0 top-full mt-2 w-60 rounded-xl border border-[var(--border)] bg-[var(--surface)] card-shadow p-2 z-50">
            <p class="px-2 py-1 text-xs text-[var(--text-muted)]">调色盘（选它即定明暗 + 配色）</p>
            <div id="palette-list" class="flex flex-col gap-1"></div>
          </div>
        </div>

        <!-- RSS（点击复制订阅地址，原版 RssButton） -->
        {showRSS && (
          <button
            id="nav-rss-btn"
            type="button"
            title="RSS 订阅"
            aria-label="RSS 订阅"
            class="flex items-center justify-center cursor-pointer hover:scale-125 transform transition-all mr-4 md:mr-2 text-[var(--text-muted)]"
          >
            <svg viewBox="0 0 1024 1024" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M832.512 63.488q26.624 0 49.664 10.24t40.448 27.648 27.648 40.448 10.24 49.664l0 704.512q0 26.624-10.24 49.664t-27.648 40.448-40.448 27.648-49.664 10.24l-704.512 0q-26.624 0-49.664-10.24t-40.448-27.648-27.648-40.448-10.24-49.664l0-704.512q0-26.624 10.24-49.664t27.648-40.448 40.448-27.648 49.664-10.24l704.512 0zM188.416 923.648q19.456 0 36.864-7.168t30.208-19.968 19.968-30.208 7.168-36.864-7.168-36.864-19.968-30.208-30.208-19.968-36.864-7.168q-20.48 0-37.376 7.168t-30.208 19.968-20.48 30.208-7.168 36.864 7.168 36.864 20.48 30.208 30.208 19.968 37.376 7.168zM446.464 897.024l36.864 0q15.36 0 30.208 0.512t31.232 0.512 36.864-1.024q0-93.184-35.84-175.616t-97.28-143.872-143.872-96.768-175.616-35.328q-1.024 24.576-1.024 39.936l0 28.672q0 14.336 0.512 29.184t0.512 37.376q65.536 0 123.392 24.576t100.864 67.584 68.096 100.864 25.088 123.392zM707.584 894.976q36.864 0 49.152 0.512t18.432 1.536 15.872 1.024 41.472-2.048q0-145.408-55.296-272.896t-150.528-222.72-223.232-150.528-273.408-55.296q-1.024 25.6-1.024 36.864l0 16.384q0 4.096 0.512 5.632t0.512 7.168 0.512 18.432 0.512 40.448q119.808 0 224.768 45.056t183.296 123.392 123.392 183.296 45.056 223.744z" />
            </svg>
            <span id="nav-rss-feedback" class="hidden ml-1 text-xs"></span>
          </button>
        )}

        <!-- 管理/登录（原版 AdminButton 图标，登录后额外保留退出按钮） -->
        {isLoggedIn ? (
          <>
            <a href="/admin" target="_blank" rel="noopener noreferrer" title="管理后台" aria-label="管理后台"
               class="hidden md:flex items-center cursor-pointer hover:scale-125 transform transition-all mr-2 text-[var(--text-muted)] no-underline">
              <svg viewBox="0 0 1024 1024" width="20" height="20" fill="currentColor" aria-hidden="true">
                <path d="M204.928 286.464a4.476 4.476 0 1 0 572.928 0 4.476 4.476 0 1 0-572.928 0Z" />
                <path d="M869.312 523.264c-35.392-43.2-101.888-51.2-140.16-10.496C669.504 576.128 585.408 616 491.328 616c-83.264 0-158.976-31.04-216.832-82.048-43.84-38.656-112.64-23.36-145.472 25.024-49.28 72.768-78.4 160.064-78.4 254.72 0 19.072 1.28 37.76 3.648 56.064 11.904 90.56 96 154.24 187.264 154.24h539.392c100.544 0 183.744-77.824 191.232-178.048.768-10.624 1.216-21.376 1.216-32.192 0-110.464-39.168-211.328-104.064-290.496z" />
              </svg>
            </a>
            <button id="logout-btn" type="button" title="退出登录" aria-label="退出登录"
                    class="flex items-center cursor-pointer hover:scale-125 transform transition-all mr-4 text-[var(--text-muted)]">
              <svg viewBox="0 0 1024 1024" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M768 128H512a32 32 0 0 0 0 64h256a64 64 0 0 1 64 64v512a64 64 0 0 1-64 64H512a32 32 0 0 0 0 64h256a128 128 0 0 0 128-128V256a128 128 0 0 0-128-128zM544.832 462.432a32 32 0 0 0-45.248 45.248L546.752 555H128a32 32 0 0 0 0 64h418.752l-47.168 47.168a32 32 0 0 0 45.248 45.248l104-104a32 32 0 0 0 0-45.248z" />
              </svg>
            </button>
          </>
        ) : (
          <a href="/login" class="hidden md:flex items-center cursor-pointer hover:scale-125 transform transition-all mr-4 text-sm text-[var(--text-muted)] no-underline">
            登录
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- 分类子菜单行（原版 showSubMenu 第二行 h-10） -->
  {categories.length > 0 && (
    <div class="h-10 items-center hidden md:flex border-b border-[var(--border)] overflow-hidden">
      <div class="mx-5 flex-shrink-0" style={{ width: 52 + subMenuOffset }}></div>
      <ul class="flex h-full items-center text-sm text-[var(--text-muted)] overflow-x-auto">
        {categories.map((c) => (
          <li class="flex items-center h-full md:px-2 hover:text-[var(--text)] transform hover:scale-110 cursor-pointer transition-all whitespace-nowrap">
            <a href={`/categories/${c.id}`} class="text-inherit no-underline">{c.name}</a>
          </li>
        ))}
      </ul>
    </div>
  )}
</header>

<!-- 移动端抽屉菜单 -->
<div id="nav-drawer" class="fixed inset-0 z-40 hidden md:hidden" role="dialog" aria-modal="true" aria-label="导航菜单" aria-hidden="true">
  <div class="nav-drawer-backdrop fixed inset-0 bg-black/50 backdrop-blur-sm"></div>
  <div class="nav-drawer-panel fixed left-0 top-0 bottom-0 w-64 bg-[var(--surface)] card-shadow border-r border-[var(--border)] p-4 overflow-y-auto">
    <div class="flex items-center justify-between mb-4">
      <a href="/" class="font-bold text-[var(--text)] no-underline">{siteName}</a>
      <button id="nav-drawer-close" type="button" class="cursor-pointer text-[var(--text-muted)]" aria-label="关闭菜单">✕</button>
    </div>

    <nav class="flex flex-col gap-1 text-sm">
      {nav.map((item) => (
        item.external ? (
          <a href={item.href} target="_blank" rel="noopener noreferrer" class="nav-link" data-drawer-close>{item.label}</a>
        ) : (
          <a href={item.href} class="nav-link" data-drawer-close>{item.label}</a>
        )
      ))}
    </nav>

    {categories.length > 0 && (
      <div class="mt-4">
        <p class="text-xs text-[var(--text-muted)] mb-2">分类</p>
        <nav class="flex flex-col gap-1 text-sm">
          {categories.map((c) => (
            <a href={`/categories/${c.id}`} class="nav-link" data-drawer-close>{c.name}</a>
          ))}
        </nav>
      </div>
    )}

    <div class="mt-6 pt-4 border-t border-[var(--border)] flex gap-2">
      <a href="/search" class="btn-primary flex-1 justify-center" data-drawer-close>搜索</a>
      {isLoggedIn ? (
        <a href="/admin" target="_blank" rel="noopener noreferrer" class="nav-link border border-[var(--border)] rounded flex-1 text-center" data-drawer-close>管理</a>
      ) : (
        <a href="/login" class="nav-link border border-[var(--border)] rounded flex-1 text-center" data-drawer-close>登录</a>
      )}
    </div>
  </div>
</div>

<!-- 搜索浮层 -->
<div id="search-dialog-overlay" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true" aria-label="搜索" aria-hidden="true">
  <div class="search-dialog-backdrop fixed inset-0 bg-black/50"></div>
  <div class="fixed top-[15%] left-1/2 -translate-x-1/2 w-full max-w-lg px-4">
    <div class="bg-[var(--surface)] rounded-xl card-shadow border border-[var(--border)] p-4">
      <form id="search-dialog-form" action="/search" method="get">
        <input type="text" name="q" id="search-dialog-input" autofocus autocomplete="off"
          aria-label="搜索关键词"
          placeholder="输入关键词搜索…"
          class="w-full px-4 py-3 text-lg bg-[var(--bg)] border border-[var(--border)] rounded-lg text-[var(--text)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent)]" />
      </form>
      <div id="search-dialog-results" class="mt-3 hidden"></div>
    </div>
  </div>
</div>

<script>
  import { getPalette, fetchPalettes, applyPalette, SYSTEM_PALETTE } from '@vanblog/sdk/browser';
  import type { PaletteMeta } from '@vanblog/sdk/browser';

  const header = document.getElementById('vanblog-nav');

  /* ── Mac 检测：⌘K 徽标显示 ⌘ 而非 Ctrl ── */
  if (/Mac|iPhone|iPad/i.test(navigator.userAgent)) {
    const first = document.querySelector('#nav-search-key kbd:first-child');
    if (first) first.textContent = '⌘';
  }

  /* ── 调色盘/主题图标（原版 ThemeButton 太阳/月亮，随当前明暗切换） ── */
  const paletteIconSun = document.getElementById('palette-icon-sun');
  const paletteIconMoon = document.getElementById('palette-icon-moon');
  function updatePaletteIcon() {
    const dark = document.documentElement.classList.contains('dark');
    paletteIconSun?.classList.toggle('hidden', dark);
    paletteIconMoon?.classList.toggle('hidden', !dark);
  }
  updatePaletteIcon();

  /* ── 移动端抽屉 ── */
  const drawer = document.getElementById('nav-drawer');
  const hamburger = document.getElementById('nav-hamburger');
  function openNavDrawer() {
    if (!drawer) return;
    drawer.classList.remove('hidden');
    drawer.setAttribute('aria-hidden', 'false');
    hamburger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeNavDrawer() {
    if (!drawer) return;
    drawer.classList.add('hidden');
    drawer.setAttribute('aria-hidden', 'true');
    hamburger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  hamburger?.addEventListener('click', () => {
    drawer?.classList.contains('hidden') ? openNavDrawer() : closeNavDrawer();
  });
  document.getElementById('nav-drawer-close')?.addEventListener('click', closeNavDrawer);
  drawer?.querySelector('.nav-drawer-backdrop')?.addEventListener('click', closeNavDrawer);
  drawer?.querySelectorAll('[data-drawer-close]').forEach((el) => el.addEventListener('click', closeNavDrawer));

  /* ── 搜索浮层 ── */
  const searchOverlay = document.getElementById('search-dialog-overlay');
  function openSearchDialog() {
    if (!searchOverlay) return;
    searchOverlay.classList.remove('hidden');
    searchOverlay.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => {
      const input = document.getElementById('search-dialog-input') as HTMLInputElement | null;
      input?.focus();
      input?.select();
    });
  }
  function closeSearchDialog() {
    if (!searchOverlay) return;
    searchOverlay.classList.add('hidden');
    searchOverlay.setAttribute('aria-hidden', 'true');
  }
  searchOverlay?.querySelector('.search-dialog-backdrop')?.addEventListener('click', closeSearchDialog);
  document.getElementById('search-dialog-form')?.addEventListener('submit', closeSearchDialog);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (searchOverlay && !searchOverlay.classList.contains('hidden')) closeSearchDialog();
      if (drawer && !drawer.classList.contains('hidden')) closeNavDrawer();
    }
  });

  /* ── Headroom: scroll to hide/show nav ── */
  let lastScroll = 0;
  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        if (!header) return;
        const cur = window.scrollY;
        if (Math.abs(cur - lastScroll) >= 8) {
          header.style.transform =
            cur > lastScroll && cur > 56
              ? 'translateY(-100%)'
              : '';
          lastScroll = cur;
        }
      });
    },
    { passive: true },
  );

  /* ── 调色盘切换（原子调色盘模型：选一个调色盘即定明暗 + 配色） ── */
  const paletteBtn = document.getElementById('palette-toggle');
  const palettePanel = document.getElementById('palette-panel');
  const paletteList = document.getElementById('palette-list');
  const sitePalette = (paletteBtn?.dataset.sitePalette || '') as string;
  let palettes: PaletteMeta[] = [];

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  }
  function openPalette() {
    palettePanel?.classList.remove('hidden');
    loadPalettes();
  }
  function closePalette() {
    palettePanel?.classList.add('hidden');
  }
  function renderPaletteList() {
    if (!paletteList) return;
    const userPref = getPalette(); // null → following system (no persisted preference)
    paletteList.innerHTML = '';

    // 跟随系统 (system mode): OS light/dark + site default palette
    const sysBtn = document.createElement('button');
    sysBtn.type = 'button';
    const sysActive = !userPref;
    sysBtn.className = `flex items-center justify-between px-2 py-1.5 rounded text-sm hover:bg-[var(--border)] ${sysActive ? 'text-[var(--accent)] font-medium' : 'text-[var(--text)]'}`;
    sysBtn.innerHTML = `<span>🌓 跟随系统</span><span class="text-xs text-[var(--text-muted)]">自动</span>`;
    sysBtn.addEventListener('click', () => selectPalette(SYSTEM_PALETTE));
    paletteList.appendChild(sysBtn);

    palettes.forEach((p) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      const activeCls = p.name === userPref ? 'text-[var(--accent)] font-medium' : 'text-[var(--text)]';
      btn.className = `flex items-center justify-between px-2 py-1.5 rounded text-sm hover:bg-[var(--border)] ${activeCls}`;
      const typeLabel = p.type === 'dark' ? '🌙 暗色' : '☀️ 亮色';
      btn.innerHTML = `<span>${escapeHtml(p.label || p.name)}</span><span class="text-xs text-[var(--text-muted)]">${typeLabel}</span>`;
      btn.addEventListener('click', () => selectPalette(p.name));
      paletteList.appendChild(btn);
    });
  }
  async function loadPalettes() {
    palettes = await fetchPalettes();
    renderPaletteList();
  }
  function selectPalette(name: string) {
    // Delegate persistence + html.dark + palette.css link + progressive switch to the SDK.
    applyPalette(name, { sitePalette: sitePalette || null, palettes });
    updatePaletteIcon();
    renderPaletteList();
    closePalette();
  }
  paletteBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    palettePanel?.classList.contains('hidden') ? openPalette() : closePalette();
  });
  document.addEventListener('click', (e) => {
    if (palettePanel && !palettePanel.classList.contains('hidden') && !paletteBtn?.contains(e.target as Node)) {
      closePalette();
    }
  });
  renderPaletteList();

  // Follow system live: in system mode (no persisted preference), react to OS light/dark changes.
  if (typeof matchMedia !== 'undefined') {
    const mq = matchMedia('(prefers-color-scheme: dark)');
    const onSystemChange = () => {
      if (!getPalette()) {
        applyPalette(SYSTEM_PALETTE, { sitePalette: sitePalette || null, palettes });
        updatePaletteIcon();
        renderPaletteList();
      }
    };
    mq.addEventListener?.('change', onSystemChange);
  }

  /* ── RSS 订阅地址复制（原版 RssButton） ── */
  const rssBtn = document.getElementById('nav-rss-btn');
  const rssFeedback = document.getElementById('nav-rss-feedback');
  rssBtn?.addEventListener('click', async (e) => {
    e.preventDefault();
    try {
      const url = `${location.protocol}//${location.host}/api/feed.xml`;
      await navigator.clipboard.writeText(url);
      if (rssFeedback) {
        rssFeedback.textContent = '已复制';
        rssFeedback.classList.remove('hidden');
        setTimeout(() => {
          rssFeedback.classList.add('hidden');
          rssFeedback.textContent = '';
        }, 1500);
      }
    } catch (err) {
      console.error('[nav] copy rss:', err);
    }
  });

  /* ── 退出登录 ── */
  const logoutBtn = document.getElementById('logout-btn');
  logoutBtn?.addEventListener('click', async () => {
    const { logout } = await import('@vanblog/sdk/browser');
    logout('/');
  });

  /* ── Ctrl+K → open search dialog ── */
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      openSearchDialog();
    }
  });

  /* ── Search button click ── */
  document.getElementById('search-open-btn')?.addEventListener('click', (e) => {
    e.preventDefault();
    openSearchDialog();
  });

  /* ── 实时搜索（原版 SearchCard：防抖 + 结果列表） ── */
  const searchInput = document.getElementById('search-dialog-input') as HTMLInputElement | null;
  const searchResults = document.getElementById('search-dialog-results');
  let searchTimer: ReturnType<typeof setTimeout> | undefined;

  async function doSearch(q: string) {
    if (!searchResults) return;
    if (!q) {
      searchResults.classList.add('hidden');
      searchResults.innerHTML = '';
      return;
    }
    try {
      const { getClient } = await import('@vanblog/sdk/browser');
      const results = await getClient().vanblog.search.query(q, { limit: 10 });
      if (q !== (searchInput?.value || '').trim()) return; // stale response
      if (!results.length) {
        searchResults.innerHTML = '<p class="text-sm text-[var(--text-muted)] px-2 py-2">无结果。</p>';
      } else {
        searchResults.innerHTML = results
          .map((r) => {
            // 只信任站内绝对路径，其余回退到 /posts/<id>
            const href = r.path && r.path.startsWith('/') && !r.path.startsWith('//')
              ? r.path
              : `/posts/${encodeURIComponent(r.id)}`;
            return `<a href="${href}" class="block px-2 py-1.5 rounded text-sm text-[var(--text)] hover:bg-[var(--border)] no-underline truncate">${escapeHtml(r.title)}</a>`;
          })
          .join('');
      }
      searchResults.classList.remove('hidden');
    } catch (err) {
      console.error('[search] live:', err);
    }
  }

  searchInput?.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => doSearch(searchInput.value.trim()), 300);
  });
</script>

<style>
  /* 移动端抽屉入场动画（打开时播放，关闭瞬时隐藏） */
  @keyframes vanblog-drawer-slide {
    from { transform: translateX(-100%); }
    to   { transform: translateX(0); }
  }
  @keyframes vanblog-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  #nav-drawer:not(.hidden) .nav-drawer-backdrop {
    animation: vanblog-fade-in 0.2s ease;
  }
  #nav-drawer:not(.hidden) .nav-drawer-panel {
    animation: vanblog-drawer-slide 0.25s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    #nav-drawer .nav-drawer-backdrop,
    #nav-drawer .nav-drawer-panel {
      animation: none;
    }
  }
</style>
