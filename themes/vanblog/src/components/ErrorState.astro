---
interface Props {
  message?: string;
  retryUrl?: string;
}

const { message = '加载失败，请稍后重试。', retryUrl } = Astro.props;
---
<div class="py-12 text-center">
  <p class="text-[var(--text-muted)] mb-4">{message}</p>
  {retryUrl && (
    <a href={retryUrl} class="btn-primary">
      重试
    </a>
  )}
  <button
    class="btn-primary ml-2"
    onclick="location.reload()"
  >
    刷新
  </button>
</div>
