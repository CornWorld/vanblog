---
import { stripMarkdown, fmtDate } from '@vanblog/sdk';
import type { PostExpand } from '@vanblog/sdk';

export interface Props {
  post: PostExpand;
  showExcerpt?: boolean;
  /** showExpirationReminder from site.displayOptions (default true). */
  showExpirationReminder?: boolean;
  /** openArticleLinksInNewWindow from site.displayOptions (default false). */
  openInNewWindow?: boolean;
}

const { post, showExcerpt = true, showExpirationReminder = true, openInNewWindow = false } = Astro.props;

// ── Helpers ────────────────────────────────────────────────────────────────
function yearsSince(raw: string | undefined | null): number {
  if (!raw) return 0;
  const d = new Date(raw.replace(' ', 'T'));
  if (isNaN(d.getTime())) return 0;
  return Math.floor((Date.now() - d.getTime()) / (365.25 * 24 * 60 * 60 * 1000));
}

const updatedYearsAgo = yearsSince(post.updated);
const isExpired = updatedYearsAgo >= 1;
const isPinned = (post.top ?? 0) > 0;
const excerpt = stripMarkdown(post.content, 200);
---

<article class="card-post relative">
  <!-- 📌 置顶图标 -->
  {isPinned && (
    <span class="absolute top-2 left-2 text-lg" title="置顶">📌</span>
  )}

  <!-- 过期提醒横幅（displayOptions.showExpirationReminder 控制） -->
  {isExpired && showExpirationReminder !== false && (
    <div class="mb-3 px-3 py-2 rounded text-sm bg-yellow-50 text-yellow-800 border border-yellow-200 dark:bg-yellow-900/20 dark:text-yellow-300 dark:border-yellow-700/30">
      本文最后更新于 {updatedYearsAgo} 年前
    </div>
  )}

  <!-- 文章标题 -->
  <h2 class="text-xl mb-2">
    <a
      href={`/posts/${encodeURIComponent(post.id ?? '')}`}
      class="text-[var(--text)] hover:text-[var(--accent)] no-underline"
      target={openInNewWindow ? '_blank' : undefined}
      rel={openInNewWindow ? 'noopener noreferrer' : undefined}
    >
      {post.title}
    </a>
  </h2>

  <!-- 元信息：日期 + 分类 -->
  <div class="flex items-center gap-3 text-sm text-[var(--text-muted)] mb-3 flex-wrap">
    {post.created && (
      <time datetime={post.created}>{fmtDate(post.created)}</time>
    )}

    {post.expand?.category && (
      <a href={`/categories/${post.category}`} class="text-[var(--accent)]">
        {post.expand.category.name}
      </a>
    )}

    {post.private && (
      <span class="inline-flex items-center gap-1 text-xs px-2 py-0.5 rounded-full border border-[var(--border)] text-[var(--text-muted)]" title="私有文章">
        🔒 私有
      </span>
    )}
  </div>

  <!-- 标签列表 -->
  {post.expand?.tags && post.expand.tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-3">
      {post.expand.tags.map((tag) => (
        <a href={`/tags/${tag.id}`} class="tag-badge">
          #{tag.name}
        </a>
      ))}
    </div>
  )}

  <!-- 加密锁：私有文章显示密码输入框 -->
  {post.private ? (
    <div class="my-4 p-4 rounded-lg border border-[var(--border)] bg-[var(--surface)]">
      <p class="text-sm text-[var(--text-muted)] mb-2">🔒 此文章需要密码才能访问</p>
      <form class="flex gap-2" method="post" action={`/posts/${encodeURIComponent(post.id ?? '')}`}>
        <!-- TODO: Add CSRF token for added security against cross-site form submission -->
        <input
          type="password"
          name="password"
          placeholder="输入文章密码..."
          class="flex-1 min-w-0 px-3 py-2 text-sm rounded-lg"
          required
        />
        <button type="submit" class="btn-primary text-sm">解锁</button>
      </form>
    </div>
  ) : (
    <>
      <!-- 摘要 -->
      {showExcerpt && excerpt && (
        <p class="text-[var(--text-muted)] text-sm leading-relaxed">
          {excerpt}
        </p>
      )}

      <!-- 阅读全文链接 -->
      <div class="mt-3">
        <a
          href={`/posts/${encodeURIComponent(post.id ?? '')}`}
          class="text-sm text-[var(--accent)] hover:underline"
          target={openInNewWindow ? '_blank' : undefined}
          rel={openInNewWindow ? 'noopener noreferrer' : undefined}
        >
          阅读全文 →
        </a>
      </div>
    </>
  )}
</article>
