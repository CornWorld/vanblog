---
import '../styles/global.css';
// KaTeX CSS — required to hide the MathML aria-hidden output that rehype-katex
// generates alongside the visual HTML. Without this, both versions render and
// the article displays duplicated math. Loaded globally (not just in editor)
// because post content is rendered server-side via markdown pipeline.
import 'katex/dist/katex.css';
import { safe, stripMarkdown, buildThemeInitScript, buildPaletteTypeMap, paletteCssUrl } from '@vanblog/sdk';
import { packs as packMetadata } from 'virtual:vanblog/packs';
import { contributions as packContributions } from 'virtual:vanblog/pack-frontend';
import type { Site, Post } from '@vanblog/sdk';
import themeMeta from '../../theme.json';

import Footer from '../components/Footer.astro';
import NavChrome from '../vendor/NavChrome';
import ToastProviderIsland from '../vendor/ToastProvider';
import BackToTopIsland from '../vendor/BackToTop';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  site?: Partial<Site>;
  post?: Post;
  path?: string; // e.g. "/posts/xxx"
  /** Render a right sidebar column (vanblog-sider, w-52, hidden below lg).
   *  Content goes into the `sideBar` named slot — e.g. the AuthorCard. */
  sideBar?: boolean;
}

const { title = '', description, keywords, site: siteProp, post, path, sideBar = false } = Astro.props;
const pb = Astro.locals.pb;

// Fall back to site config from middleware (lazy-loaded from pb)
const site = siteProp || await Astro.locals.getSite();

// Effective site palette: site.palette first, else this theme's recommendedPalette.
const recommendedPalette = (themeMeta as { recommendedPalette?: string })?.recommendedPalette || null;
const effectivePalette = site?.palette || recommendedPalette;

// Default favicon: site.favicon or a minimal inline SVG (avoids /favicon.ico 404).
const DEFAULT_FAVICON = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%231772b4'/%3E%3Ctext x='16' y='23' font-size='20' font-weight='bold' text-anchor='middle' fill='white' font-family='sans-serif'%3EV%3C/text%3E%3C/svg%3E";


const siteName = site?.siteName || 'Vanblog';
const siteDesc = description || site?.siteDesc || '';
const baseUrl = site?.baseUrl || '';
// 原版首页 <title> 仅站点名，其他页为「标题 - 站点名」。
const pageTitle = title ? `${title} - ${siteName}` : siteName;

// Canonical URL
const canonicalURL = baseUrl && path ? `${baseUrl.replace(/\/$/, '')}${path}` : undefined;

const desc = post ? stripMarkdown(post.content) || siteDesc : siteDesc;

// JSON-LD structured data for articles
const articleSchema = post ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  datePublished: post.created,
  dateModified: post.updated,
  author: site?.author ? { '@type': 'Person', name: site.author } : undefined,
  publisher: {
    '@type': 'Organization',
    name: siteName,
  },
  description: desc,
  mainEntityOfPage: canonicalURL ? { '@type': 'WebPage', '@id': canonicalURL } : undefined,
} : undefined;

// JSON-LD for website
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  description: siteDesc,
  url: baseUrl || undefined,
};

// Escape `<` so user-controlled values can't break out of the JSON-LD `<script>`
// block (JSON.stringify does not escape `</script>` sequences).
const safeJsonLd = (obj: unknown) => JSON.stringify(obj).replace(/</g, '\\u003c');

// Pack nav items are resolved at build time by the Astro Pack integration.
const packNavItems = packMetadata.flatMap((pack) => pack.nav ? [pack.nav] : []);

// Categories for the nav sub-menu (migrated from original NavBar showSubMenu).
const navCategories = await safe(() => pb.collection('categories').getFullList<{ id: string; name: string }>(), 'nav-categories');

// 导航菜单:site.nav 自定义优先,否则默认集(自原手搓 Nav.astro 迁移)。
interface NavEntry { label: string; href: string }
const customNav: NavEntry[] = (site?.nav ?? []).map((n) => ({ label: n.name, href: n.value }));
const defaultNav: NavEntry[] = [
  { label: '首页', href: '/' },
  { label: '归档', href: '/archive' },
  { label: '时间轴', href: '/timeline' },
  { label: '标签', href: '/tag' },
  { label: '分类', href: '/category' },
  ...packNavItems.map((p) => ({ label: p.label, href: p.href })),
  ...((site?.links?.length ?? 0) > 0 ? [{ label: '友链', href: '/link' }] : []),
  ...(site?.aboutContent && site.aboutContent.trim() ? [{ label: '关于', href: '/about' }] : []),
];
const navEntries = customNav.length > 0 ? customNav : defaultNav;
const navMenus = navEntries.map((e, i) => ({ id: i, name: e.label, value: e.href, level: 0 }));

// Palette name→type map for theme init. Light/dark is decided by the active
// palette's `type` (atomic palette model, VSCode-style), not by a user theme
// mode. If the list can't be fetched, the init script safely falls back to light.
const palettes = await safe(() => pb.vanblog.palettes.list(), 'palettes');
const paletteTypeMap = buildPaletteTypeMap(palettes.data ?? []);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Prevent FOUC: apply effective palette (light/dark from palette type) + user preference before paint -->
    <script
      is:inline
      set:html={buildThemeInitScript({
        sitePalette: effectivePalette,
        siteUpdated: site?.updated,
        palettes: paletteTypeMap,
      })}
    />

    <!-- Favicon: site.favicon or a minimal inline SVG fallback -->
    <link rel="icon" href={site?.favicon || DEFAULT_FAVICON} />

    <!-- Core SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    {keywords && <meta name="keywords" content={keywords} />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Palette CSS (zero-build theme switch; see docs/agent-theme-architecture.md §4) -->
    {effectivePalette && (
      <link rel="stylesheet" href={paletteCssUrl(effectivePalette, site?.updated)} data-vanblog-palette />
    )}

    {packContributions.filter((item) => item.scope === 'public').flatMap((item) => item.styles).map((href) => (
      <link rel="stylesheet" href={href} data-vanblog-pack-style />
    ))}

    <!-- OpenGraph (Facebook / WeChat / others) -->
    <meta property="og:title" content={post?.title || title || siteName} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={post ? 'article' : 'website'} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {post && <meta property="article:published_time" content={post.created} />}
    {post && <meta property="article:modified_time" content={post.updated} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={post?.title || title || siteName} />
    <meta name="twitter:description" content={desc} />

    <!-- RSS auto-discovery -->
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href="/api/feed.xml" />
    <link rel="alternate" type="application/atom+xml" title={`${siteName} Atom`} href="/api/atom.xml" />

    <!-- Structured Data (JSON-LD) -->
    {post ? (
      <script is:inline type="application/ld+json" set:html={safeJsonLd(articleSchema)} />
    ) : (
      <script is:inline type="application/ld+json" set:html={safeJsonLd(websiteSchema)} />
    )}

    <!-- Analytics（原版 BaiduAnalysis / gaAnalysis） -->
    {site?.baiduAnalysisId && (
      <script is:inline src={`https://hm.baidu.com/hm.js?${site.baiduAnalysisId}`} async />
    )}
    {site?.gaAnalysisId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaAnalysisId}`} />
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${site.gaAnalysisId}');`} />
      </>
    )}
<!-- Custom head / CSS / Script（原版 CustomLayout，站点后台自定义注入；
         script 放 head 对齐原版 beforeInteractive 语义） -->
    {site?.customHead && <Fragment set:html={site.customHead} />}
    {site?.customCss && <style is:inline set:html={site.customCss} />}
    {site?.customScript && <script is:inline set:html={site.customScript} />}
  </head>
  <!-- 壳层 = 上游 Layout/index.tsx + LayoutBody/index.tsx 逐式(类名 upstream literal):
       body 裸;内容与 Footer 同包一个 mx-auto lg:px-6 md:py-4 py-2 px-2 md:px-4
       text-gray-700 容器;LayoutBody 双列 flex,vanblog-sider 无侧栏时仅去 w-52。 -->
  <body>
    <NavChrome
      client:load
      siteName={siteName}
      logo={site?.siteLogo || ''}
      logoDark={site?.siteLogoDark || ''}
      categories={navCategories.data ?? []}
      menus={navMenus}
      showSubMenu={site?.displayOptions?.showSubMenu !== false ? "true" : "false"}
      showAdminButton={site?.displayOptions?.showAdminButton !== false ? "true" : "false"}
      showFriends={site?.displayOptions?.showFriends !== false ? "true" : "false"}
      showRSS={site?.displayOptions?.showRSS !== false ? "true" : "false"}
      headerLeftContent={(site?.siteLogo && site?.displayOptions?.headerLeftContent === 'siteLogo') ? 'siteLogo' : 'siteName'}
      defaultTheme="auto"
      subMenuOffset={site?.displayOptions?.subMenuOffset || 0}
      openArticleLinksInNewWindow={site?.displayOptions?.openArticleLinksInNewWindow === true}
      sitePalette={site?.palette || ''}
    />
    <ToastProviderIsland client:load />
    <div class="mx-auto lg:px-6 md:py-4 py-2 px-2 md:px-4 text-gray-700">
      <div class="flex mx-auto justify-center">
        <div class="flex-shrink flex-grow md:max-w-3xl xl:max-w-4xl w-full vanblog-main">
          <slot />
        </div>
        <div class={`hidden lg:block flex-shrink-0 flex-grow-0 vanblog-sider ${sideBar ? 'w-52' : ''}`}>
          <slot name="sideBar" />
        </div>
      </div>
      <Footer site={site} />
    </div>
    <BackToTopIsland client:load />

    {packContributions.filter((item) => item.scope === 'public').flatMap((item) => item.scripts).map((src) => (
      <script is:inline type="module" src={src} data-vanblog-pack-script></script>
    ))}
<!-- Custom HTML（原版 CustomLayout，站点后台自定义注入；script 已在 head） -->
    {site?.customHtml && <Fragment set:html={site.customHtml} />}
  </body>
</html>
