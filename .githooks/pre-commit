#!/bin/sh
# VanBlog pre-commit hook

set -e

echo "→ go vet -all (strict)..."
(cd vault && go vet -all ./...) || exit 1

echo "→ golangci-lint..."
GL_BIN="$(go env GOPATH)/bin/golangci-lint"
if [ -x "$GL_BIN" ] || command -v golangci-lint >/dev/null 2>&1; then
  if [ -x "$GL_BIN" ]; then
    (cd vault && "$GL_BIN" run ./...) || exit 1
  else
    (cd vault && golangci-lint run ./...) || exit 1
  fi
else
  echo "  (golangci-lint 未安装,跳过 — 安装: go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@latest (v2 module path; v1 cannot target Go >= 1.27))"
fi

echo "→ go test ./... ..."
(cd vault && go test ./...) || exit 1

echo "→ eslint (app + sdk + themes) ..."
npx eslint app/src sdk/src themes/base/src themes/vanblog/src || exit 1

echo "→ astro check (app + themes via pnpm -r) ..."
(pnpm -r check) || exit 1

echo "✓ pre-commit OK"