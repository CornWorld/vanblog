---
import '../styles/global.css';
// KaTeX CSS — required to hide the MathML aria-hidden output that rehype-katex
// generates alongside the visual HTML. Without this, both versions render and
// the article displays duplicated math. Loaded globally (not just in editor)
// because post content is rendered server-side via markdown pipeline.
import 'katex/dist/katex.css';
import { stripMarkdown } from '@vanblog/sdk';
import type { SiteConfig, Post } from '@vanblog/sdk';

interface Props {
  title: string;
  description?: string;
  site?: Partial<SiteConfig>;
  post?: Post;
  path?: string; // e.g. "/posts/xxx"
}

const { title, description, site: siteProp, post, path } = Astro.props;
const pb = Astro.locals.pb;

// Fall back to site config from middleware (lazy-loaded from pb)
const site = siteProp || await Astro.locals.getSite();

// Auth state for nav: show logout only when there's a session.
const isLoggedIn = pb.authStore.isValid;
const hasAbout = !!(site?.aboutContent && site.aboutContent.trim());

const siteName = site?.siteName || 'Vanblog';
const siteDesc = description || site?.siteDesc || '';
const baseUrl = site?.baseUrl || '';

// Canonical URL
const canonicalURL = baseUrl && path ? `${baseUrl.replace(/\/$/, '')}${path}` : undefined;

const desc = post ? stripMarkdown(post.content) || siteDesc : siteDesc;

// JSON-LD structured data for articles
const articleSchema = post ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  datePublished: post.created,
  dateModified: post.updated,
  author: site?.author ? { '@type': 'Person', name: site.author } : undefined,
  publisher: {
    '@type': 'Organization',
    name: siteName,
  },
  description: desc,
  mainEntityOfPage: canonicalURL ? { '@type': 'WebPage', '@id': canonicalURL } : undefined,
} : undefined;

// JSON-LD for website
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  description: siteDesc,
  url: baseUrl || undefined,
};

// Plugin nav items — fetched once per process lifetime via middleware cache
const allNavItems = await Astro.locals.getNavItems();
const pluginNavItems = allNavItems.filter((item) => item.position === 'header');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Prevent FOUC: set dark class before paint -->
    <script is:inline>
      (() => {
        const t = localStorage.getItem('vanblog-theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Core SEO -->
    <title>{title} - {siteName}</title>
    <meta name="description" content={desc} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- OpenGraph (Facebook / WeChat / others) -->
    <meta property="og:title" content={post?.title || title} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={post ? 'article' : 'website'} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {post && <meta property="article:published_time" content={post.created} />}
    {post && <meta property="article:modified_time" content={post.updated} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={post?.title || title} />
    <meta name="twitter:description" content={desc} />

    <!-- RSS auto-discovery -->
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href="/api/feed.xml" />
    <link rel="alternate" type="application/atom+xml" title={`${siteName} Atom`} href="/api/atom.xml" />

    <!-- Structured Data (JSON-LD) -->
    {post ? (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    ) : (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-10 border-b border-[var(--color-border)] bg-[var(--color-surface)] dark:bg-[var(--color-surface-dark)] backdrop-blur-sm">
      <div class="container-page flex items-center justify-between h-14 gap-4">
        <a href="/" class="font-bold text-lg text-[var(--color-text)] dark:text-[var(--color-text-dark)] no-underline hover:opacity-80">
          {siteName}
        </a>
        <nav class="flex items-center gap-1 sm:gap-2 text-sm text-[var(--color-text)] dark:text-[var(--color-text-dark)]">
          <a href="/" class="px-2 py-1 rounded hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)] transition-colors no-underline text-inherit">首页</a>
          <a href="/archive" class="px-2 py-1 rounded hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)] transition-colors no-underline text-inherit">归档</a>
          <a href="/timeline" class="px-2 py-1 rounded hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)] transition-colors no-underline text-inherit">时间轴</a>
          <a href="/tags" class="px-2 py-1 rounded hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)] transition-colors no-underline text-inherit hidden sm:inline">标签</a>
          <a href="/categories" class="px-2 py-1 rounded hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)] transition-colors no-underline text-inherit hidden sm:inline">分类</a>
          <a href="/search" class="px-2 py-1 rounded hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)] transition-colors no-underline text-inherit">搜索</a>
          {pluginNavItems.map((item) => (
            <a href={item.path} class="px-2 py-1 rounded hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)] transition-colors no-underline text-inherit">{item.title}</a>
          ))}
          {hasAbout && (
            <a href="/about" class="px-2 py-1 rounded hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)] transition-colors no-underline text-inherit hidden sm:inline">关于</a>
          )}
          {isLoggedIn ? (
            <a href="/admin" class="px-2 py-1 rounded hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)] transition-colors no-underline text-inherit">管理</a>
          ) : (
            <a href="/login" class="px-2 py-1 rounded hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)] transition-colors no-underline text-inherit">登录</a>
          )}
          {isLoggedIn && (
            <button id="logout-btn" type="button" class="px-2 py-1 rounded hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)] transition-colors text-inherit" aria-label="退出登录" title="退出登录">退出</button>
          )}
          <button id="darkmode-toggle" class="ml-1 px-2 py-1 rounded hover:bg-[var(--color-border)] dark:hover:bg-[var(--color-border-dark)] transition-colors text-lg" aria-label="切换深色模式" title="切换深色/浅色模式">
            <span class="dark:hidden">🌙</span>
            <span class="hidden dark:inline">☀️</span>
          </button>
        </nav>
      </div>
    </header>
    <main class="flex-1 container-page py-8">
      <slot />
    </main>
    <footer class="border-t border-[var(--color-border)] py-8 text-sm text-[var(--color-text-muted)]">
      <div class="container-page flex flex-col sm:flex-row justify-between gap-4">
        <p>&copy; {new Date().getFullYear()} {siteName}. Powered by <a href="https://github.com/CornWorld/vanblog" class="underline">Vanblog</a>.</p>
        <p class="flex gap-4">
          <a href="/api/feed.xml" class="hover:text-[var(--color-text)]">RSS</a>
          <a href="/api/atom.xml" class="hover:text-[var(--color-text)]">Atom</a>
          <a href="/api/sitemap.xml" class="hover:text-[var(--color-text)]">Sitemap</a>
        </p>
      </div>
    </footer>

    <!-- Dark mode toggle + logout logic -->
    <script>
      const btn = document.getElementById('darkmode-toggle');
      const html = document.documentElement;
      btn?.addEventListener('click', () => {
        html.classList.toggle('dark');
        const isDark = html.classList.contains('dark');
        localStorage.setItem('vanblog-theme', isDark ? 'dark' : 'light');
        // Notify comment widgets (Artalk/Giscus) to sync dark mode
        html.dispatchEvent(new CustomEvent('darkmodechange', { detail: { dark: isDark } }));
      });

      const logoutBtn = document.getElementById('logout-btn');
      logoutBtn?.addEventListener('click', async () => {
        const { logout } = await import('@vanblog/sdk/browser');
        logout('/');
      });
    </script>
  </body>
</html>
