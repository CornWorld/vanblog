---
// ============================================================
// 平台层 base 布局 (app/src/layouts/BaseLayout.astro)
// ------------------------------------------------------------
// 这是"纯布局 + 简单颜色"的平台布局, 服务对象:
//   - admin 页面 (control plane, 经 AdminLayout)
//   - 登录/安装页 (login.astro / setup.astro)
//   - base 主题 (themes/base 直接复用, 见 @vanblog/base/layouts/BaseLayout.astro)
// 它不属于任何具体主题的视觉。vanblog 主题自带独立的 BaseLayout。
//
// 保留 Tailwind global.css —— admin 页面大量使用 Tailwind 工具类。
// ============================================================
import '../styles/global.css';
// KaTeX CSS: 编辑器/渲染链路需要 (admin/edit 的 ByteMdEditor 依赖)。
import 'katex/dist/katex.css';
import { stripMarkdown } from '@vanblog/sdk';
import { packs as packMetadata } from 'virtual:vanblog/packs';
import { contributions as packContributions } from 'virtual:vanblog/pack-frontend';
import type { Site, Post } from '@vanblog/sdk';

interface Props {
  title: string;
  description?: string;
  site?: Partial<Site>;
  post?: Post;
  path?: string;
}

const { title, description, site: siteProp, post, path } = Astro.props;
const site = siteProp || await Astro.locals.getSite();

const siteName = site?.siteName || 'Vanblog';
const siteDesc = description || site?.siteDesc || '';
const baseUrl = site?.baseUrl || '';
const canonicalURL = baseUrl && path ? `${baseUrl.replace(/\/$/, '')}${path}` : undefined;
const desc = post ? stripMarkdown(post.content) || siteDesc : siteDesc;

const packNavItems = packMetadata.flatMap((pack) => pack.nav ? [pack.nav] : []);
const hasAbout = !!(site?.aboutContent && site.aboutContent.trim());
const isLoggedIn = Astro.locals.pb.authStore.isValid;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Prevent FOUC: set dark class before paint -->
    <script is:inline>
      (() => {
        const t = localStorage.getItem('vanblog-theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <title>{title} - {siteName}</title>
    <meta name="description" content={desc} />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    <!-- Palette CSS (zero-build theme switch) -->
    {site?.palette && (
      <link rel="stylesheet" href={`/api/palette.css?v=${site.updated ?? ''}`} data-vanblog-palette />
    )}

    {packContributions.filter((item) => item.scope === 'public').flatMap((item) => item.styles).map((href) => (
      <link rel="stylesheet" href={href} data-vanblog-pack-style />
    ))}

    <!-- OpenGraph -->
    <meta property="og:title" content={post?.title || title} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={post ? 'article' : 'website'} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}

    <!-- RSS auto-discovery -->
    <link rel="alternate" type="application/rss+xml" title={`${siteName} RSS`} href="/api/feed.xml" />
    <link rel="alternate" type="application/atom+xml" title={`${siteName} Atom`} href="/api/atom.xml" />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b">
      <div class="container-page flex items-center justify-between py-3">
        <a href="/" class="font-semibold no-underline">{siteName}</a>
        <nav class="flex flex-wrap gap-3 text-sm">
          <a href="/">首页</a>
          <a href="/archive">归档</a>
          <a href="/timeline">时间轴</a>
          <a href="/tags">标签</a>
          <a href="/categories">分类</a>
          {hasAbout && <a href="/about">关于</a>}
          {packNavItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
          {isLoggedIn ? <a href="/admin">管理</a> : <a href="/login">登录</a>}
        </nav>
      </div>
    </header>

    <main class="flex-1 container-page py-8">
      <slot />
    </main>

    <footer class="border-t py-4 text-center text-xs text-[var(--text-muted)]">
      <p>{site?.copyrightAgreement || ''} {site?.author || ''} · Powered by Vanblog</p>
    </footer>

    {packContributions.filter((item) => item.scope === 'public').flatMap((item) => item.scripts).map((src) => (
      <script is:inline type="module" src={src} data-vanblog-pack-script></script>
    ))}
  </body>
</html>
