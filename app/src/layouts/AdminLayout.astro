---
// Admin layout: extends BaseLayout and loads the PocketBase browser SDK
// so admin page scripts can call pb.collection(...).authWithPassword etc.
import BaseLayout from './BaseLayout.astro';

// All admin pages are SSR — never cache.
Astro.cache.set(false);

interface Props {
  title: string;
  [key: string]: any;
}
---
<BaseLayout {...Astro.props}>
  <script>
    import { initClient } from '@vanblog/sdk/browser';
    initClient();
  </script>
  <slot />
</BaseLayout>
