---
// Admin layout: extends BaseLayout and loads the PocketBase browser SDK
// so admin page scripts can call pb.collection(...).authWithPassword etc.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  [key: string]: any;
}
---
<BaseLayout {...Astro.props}>
  <script>
    import { initBrowserPb } from '@vanblog/sdk/browser';
    initBrowserPb();
  </script>
  <slot />
</BaseLayout>
