---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import PbInit from '../components/PbInit.astro';
import { isAuthenticated } from '../middleware';

// Already-logged-in users have no business on /login — bounce to /admin
// (or to ?back= if they were sent here from a private post redirect).
const back = Astro.url.searchParams.get('back');
if (isAuthenticated(Astro)) return Astro.redirect(back || '/admin');

Astro.cache.set(false);
---

<BaseLayout title="登录">
  <PbInit />
  <h1>登录</h1>

  <form id="login-form" class="flex flex-col gap-2 max-w-sm">
    <label class="flex flex-col">
      邮箱 / 用户名
      <input name="email" type="text" required autocomplete="username email" class="px-1.5 py-0.5" />
    </label>
    <label class="flex flex-col">
      密码
      <input name="password" type="password" required autocomplete="current-password" class="px-1.5 py-0.5" />
    </label>
    <input type="hidden" name="back" value={back || ''} />
    <button type="submit" class="self-start px-3 py-1">登录</button>
    <p id="login-error" class="text-red-600 text-sm hidden"></p>
  </form>

  <script define:vars={{}}>
    const form = document.getElementById('login-form');
    const errEl = document.getElementById('login-error');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.classList.add('hidden');
      const fd = new FormData(form);
      const pb = window.__pb;
      if (!pb) {
        errEl.textContent = '客户端未初始化，请刷新';
        errEl.classList.remove('hidden');
        return;
      }
      try {
        await pb.collection('users').authWithPassword(fd.get('email'), fd.get('password'));
        // Cookie is the single source of truth for the SSR middleware.
        // PbInit no longer syncs the cookie via onChange (that was the
        // anti-pattern that caused state drift), so we write it explicitly
        // here on login. Options must match middleware.ts's exportToCookie
        // call so the browser actually accepts the cookie over HTTP.
        document.cookie = pb.authStore.exportToCookie({
          secure: window.location.protocol === 'https:',
          sameSite: 'lax',
          httpOnly: false,
        });
        const back = fd.get('back');
        location.href = back || '/admin';
      } catch (err) {
        errEl.textContent = '登录失败：' + (err?.message || '用户名/邮箱或密码错误');
        errEl.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
