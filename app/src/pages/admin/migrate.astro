---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAuthUser } from '@vanblog/sdk';
const pb = Astro.locals.pb;
const isAdmin = getAuthUser(pb)?.role === 'admin';
---

<AdminLayout title="数据迁移">
  <h1>数据迁移</h1>
  <p class="flex gap-3 items-center">
    <a href="/admin">← 返回</a>
    <a
      class="text-sm underline"
      href={`/admin/terminal?name=${encodeURIComponent('AI 迁移助手')}&prompt=${encodeURIComponent(
        '你是 vanblog 数据迁移助手。先读 docs/reference/backup.md 的迁移协议和 docs/faq.md 的迁移条目,然后帮我完成数据导入:先了解我手上 ZIP 的来源格式(原版 mereithhh 或其他 fork),再给出校验与导入步骤,导入后核对文章数与图片链接改写结果。',
      )}`}
    >🤖 AI 迁移助手</a>
  </p>
  {!isAdmin ? (
    <p>仅管理员可访问。</p>
  ) : (
    <div class="flex flex-col gap-6 max-w-3xl">
      <!-- Step 1: Export from another Vanblog -->
      <section class="border border-[var(--border)] p-4">
        <h2 class="text-lg font-semibold mb-2">步骤 1：从源站点导出</h2>
        <p class="text-sm text-[var(--text-muted)] mb-3">
          在另一台 Vanblog 实例（或迁移前的备份）上，用管理员身份调用导出接口获取 ZIP 包。
          导出内容包含全部文章 + 文章内引用的图片，图片会自动打包进 images/ 目录。
        </p>
        <pre class="overflow-x-auto bg-[var(--surface)] border border-[var(--border)] p-3 text-sm"><code># 全量导出（全部文章 + 图片）
curl -X GET http://&lt;源站&gt;:8090/api/vanblog/export/all \
  -H "Authorization: Bearer &lt;管理员TOKEN&gt;" \
  -o vanblog_export.zip

# 单篇导出
curl -X GET http://&lt;源站&gt;:8090/api/vanblog/export/post/&lt;文章ID&gt; \
  -H "Authorization: Bearer &lt;管理员TOKEN&gt;" \
  -o post_&lt;文章ID&gt;.zip</code></pre>
      </section>

      <!-- Step 2: Upload ZIP to import -->
      <section class="border border-[var(--border)] p-4">
        <h2 class="text-lg font-semibold mb-2">步骤 2：上传 ZIP 导入</h2>
        <p class="text-sm text-[var(--text-muted)] mb-3">
          选择步骤 1 导出的 ZIP 文件，上传后自动导入。图片会自动上传到本站图床，文章内容中的图片链接会自动改写为新地址。
        </p>
        <div class="flex gap-2 items-center">
          <input type="file" id="zip-file" accept=".zip,application/zip" class="text-sm" />
          <button id="btn-zip-import" class="px-3 py-1 border border-[var(--border)] rounded">上传并导入</button>
        </div>
        <div id="zip-result"></div>

        <details class="mt-3">
          <summary class="cursor-pointer font-semibold text-sm">或使用 curl</summary>
          <pre class="overflow-x-auto bg-[var(--surface)] border border-[var(--border)] p-3 text-sm mt-2"><code>curl -X POST http://your-vanblog:8090/api/vanblog/migrate/import \
  -H "Authorization: Bearer &lt;管理员TOKEN&gt;" \
  -H "Content-Type: application/zip" \
  --data-binary @vanblog_export.zip</code></pre>
        </details>
      </section>
    </div>
  )}

  <script>
    document.getElementById('btn-zip-import')?.addEventListener('click', async () => {
      const fileInput = document.getElementById('zip-file') as HTMLInputElement;
      const resultDiv = document.getElementById('zip-result');
      if (!fileInput || !resultDiv) return;
      const file = fileInput.files?.[0];
      if (!file) { alert('请选择 ZIP 文件'); return; }
      try {
        const resp = await fetch('/api/vanblog/migrate/import', {
          method: 'POST',
          headers: { 'Content-Type': 'application/zip' },
          body: file,
        });
        const result = await resp.json();
        if (!resp.ok) {
          resultDiv.innerHTML = `<p class="text-red-600 dark:text-red-400 mt-3">导入失败: ${result.message || resp.statusText}</p>`;
          return;
        }
        resultDiv.innerHTML = `
          <div class="mt-3 p-3 border border-green-500 rounded bg-green-50 dark:bg-green-900/20">
            <h3 class="font-semibold">✅ 导入完成</h3>
            <ul class="list-disc list-inside mt-1 text-sm">
              <li>文章: ${result.posts || 0}</li>
            </ul>
            ${result.errors && result.errors.length > 0 ? `<p class="text-orange-600 dark:text-orange-400 text-sm mt-1">⚠ 部分数据导入异常: ${result.errors.join(', ')}</p>` : ''}
          </div>
        `;
      } catch (err: any) {
        if (resultDiv) {
          resultDiv.innerHTML = `<p class="text-red-600 dark:text-red-400 mt-3">错误: ${err.message}</p>`;
        }
      }
    });
  </script>
</AdminLayout>
