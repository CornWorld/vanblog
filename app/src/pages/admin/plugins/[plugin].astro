---
// /admin/plugins/moments, etc.
// Auth is already handled by the middleware (guards /admin/*).
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { fetchPluginPage } from '../../../lib/plugin-loader';

const { plugin } = Astro.params;

if (!plugin) {
    return Astro.redirect('/404');
}

const pluginData = await fetchPluginPage({
    plugin,
    type: 'admin',
    pbUrl: Astro.locals.pbUrl,
    cookie: Astro.request.headers.get('cookie') || '',
});

if (!pluginData) {
    return Astro.redirect('/404');
}
---

<AdminLayout title={pluginData.title}>
    <Fragment set:html={pluginData.html} />
</AdminLayout>
