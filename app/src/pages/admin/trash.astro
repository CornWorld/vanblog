---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import ErrorNotice from '../../components/ErrorNotice.astro';
import { fmtDateTime, safe } from '@vanblog/sdk';
import { getAuthUser, hasPermission } from '@vanblog/sdk';
const pb = Astro.locals.pb;


const user = getAuthUser(pb);
const isAdmin = user?.role === 'admin';
const canDeletePost = !!hasPermission(pb, 'article:delete') || isAdmin;
const canEditPost = !!hasPermission(pb, 'article:create') || !!hasPermission(pb, 'article:update');

const denied = !canEditPost;
if (denied) Astro.response.status = 403;

const { data: trash = [] } = denied ? { data: [] } : await safe(
  () => pb.vanblog.posts.trash(),
  'admin/trash'
);
---

<AdminLayout title="回收站">
  <h1>回收站</h1>
  <p><a href="/admin">← 返回</a></p>

  {denied ? (
    <ErrorNotice code="403" title="无权限访问" message="回收站需要 article:create 或 article:update 权限。" />
  ) : trash.length === 0 ? (
    <p>回收站为空。</p>
  ) : (
    <table class="w-full border-collapse">
      <thead>
        <tr class="text-left border-b border-[var(--color-border)]">
          <th>标题</th><th>状态</th><th>删除时间</th><th>操作</th>
        </tr>
      </thead>
      <tbody>
        {trash.map(post => (
          <tr data-id={post.id} class="border-b border-[var(--color-border)]">
            <td>{post.title}</td>
            <td>{post.status}</td>
            <td>{fmtDateTime(post.updated)}</td>
            <td class="flex gap-2 flex-wrap">
              <button class="btn-restore">恢复</button>
              {canDeletePost && (
                <button class="btn-purge text-red-600">彻底删除</button>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}

  <script is:inline>
    document.querySelectorAll('tr[data-id]').forEach((tr) => {
      const id = tr.dataset.id;
      const pb = window.__pb;

      tr.querySelector('.btn-restore').addEventListener('click', async () => {
        if (!id || !confirm('恢复该文章？（deleted=false）')) return;
        if (!pb) return alert('未登录');
        try {
          await pb.vanblog.posts.restore(id);
          location.reload();
        } catch (err) {
          alert('恢复失败: ' + err.message);
        }
      });

      const purgeBtn = tr.querySelector('.btn-purge');
      if (purgeBtn) {
        purgeBtn.addEventListener('click', async () => {
          if (!id) return;
          if (!confirm('彻底删除？该操作不可撤销。')) return;
          if (!pb) return alert('未登录');
          try {
            await pb.vanblog.posts.purge(id);
            location.reload();
          } catch (err) {
            alert('删除失败: ' + err.message);
          }
        });
      }
    });
  </script>
</AdminLayout>
