---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import ErrorNotice from '../../../components/ErrorNotice.astro';
import { getAuthUser } from '../../../middleware';
import { formatPbDate } from '../../../lib/dates';
import type { Revision, Post } from '@vanblog/sdk';


Astro.cache.set(false);

const { postId } = Astro.params;
// Inline 404 instead of redirect to /404 — preserves nav chrome.
const notFound = !postId;
if (notFound) Astro.response.status = 404;

const user = getAuthUser(Astro);
const isAdmin = user?.role === 'admin';

let post: Post | null = null;
let revs: Revision[] = [];
let denied = false;

const pb = Astro.locals.pb;

if (!notFound) {
  try {
    post = await pb.collection('posts').getOne<Post>(postId);
  } catch {
    // post missing OR blocked by posts ViewRule. Render inline 404.
    denied = true;
    Astro.response.status = 404;
  }
}

if (!notFound && !denied) {
  try {
    revs = await pb.collection('revisions').getFullList<Revision>({
      filter: `target = "${postId}"`,
      sort: '-created',
    });
  } catch (e) {
    console.error('[revisions] Failed to load:', e);
  }

  // revisions ListRule (1782300004) returns empty for non-admin reading
  // someone else's post. Distinguish "no history" from "no access":
  // collaborators reading their own post legitimately see empty too, so we
  // only mark denied=true when the post's author isn't the current user.
  if (!isAdmin && post && post.author !== user?.id && revs.length === 0) {
    denied = true;
    Astro.response.status = 403;
  }
}
---
<AdminLayout title={notFound ? '修订历史 - 不存在' : denied ? '修订历史 - 无权限' : `修订历史 - ${post?.title || ''}`}>
  <h1>修订历史</h1>
  <p><a href="/admin">← 返回管理</a>{!notFound && !denied && ` ｜ `}<a href={`/admin/edit/${postId}`}>编辑</a></p>
  {!notFound && !denied && (
    <>
      <p><strong>文章：</strong>{post?.title}</p>
      <hr />
    </>
  )}

  {notFound ? (
    <ErrorNotice code="404" title="文章不存在" message="该文章可能已被彻底删除，或链接有误。" />
  ) : denied ? (
    <ErrorNotice code="403" title="无权限查看历史" message="仅作者或管理员可查看该文章的修订历史。" />
  ) : revs.length === 0 ? (
    <p>暂无修订记录。</p>
  ) : (
    <ul class="list-none p-0 flex flex-col gap-3">
      {revs.map(r => (
        <li class="border border-[var(--color-border)] p-3">
          <div class="flex justify-between gap-4 flex-wrap">
            <strong>{r.reason || '(无原因)'}</strong>
            <small class="text-[var(--color-text-muted)]">{formatPbDate(r.created)}</small>
          </div>
          <div class="text-xs text-[var(--color-text-muted)] mt-1">
            by {r.authoredBy || '-'}
          </div>
          {r.snapshot && (
            <details class="mt-2">
              <summary class="cursor-pointer">快照</summary>
              <pre class="whitespace-pre-wrap text-xs bg-gray-50 p-2">{JSON.stringify(r.snapshot, null, 2)}</pre>
            </details>
          )}
        </li>
      ))}
    </ul>
  )}
</AdminLayout>
