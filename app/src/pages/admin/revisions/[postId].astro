---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import ErrorNotice from '../../../components/ErrorNotice.astro';
import { getAuthUser, hasPermission, fmtDateTime } from '@vanblog/sdk';
import type { Revision, Post } from '@vanblog/sdk';

interface DiffPart {
  t: 'same' | 'del' | 'add';
  s: string;
}

interface Line {
  t: 'same' | 'del' | 'add';
  s: string;
}

// 行级 diff：先按 \n 分行。两侧均 ≤1500 行时用经典 LCS DP
//（Uint32Array 行滚动）；超限退化为「公共前缀 + 公共后缀，
// 中间整块 del/add」，保证大文档下不出爆内存。
function diffLines(oldStr: string, newStr: string): DiffPart[] {
  const a = (oldStr ?? '').split('\n');
  const b = (newStr ?? '').split('\n');
  const lines: Line[] = [];

  if (a.length <= 1500 && b.length <= 1500) {
    const n = a.length;
    const m = b.length;
    // dp[i][j] = LCS 长度；用 Uint32Array 行（滚动）存全矩阵以便回溯。
    const dp: Uint32Array[] = new Array(n + 1);
    dp[0] = new Uint32Array(m + 1);
    for (let i = 1; i <= n; i++) {
      const row = new Uint32Array(m + 1);
      const prev = dp[i - 1];
      const ai = a[i - 1];
      for (let j = 1; j <= m; j++) {
        row[j] = ai === b[j - 1] ? prev[j - 1] + 1 : Math.max(prev[j], row[j - 1]);
      }
      dp[i] = row;
    }
    let i = n;
    let j = m;
    while (i > 0 && j > 0) {
      if (a[i - 1] === b[j - 1]) {
        lines.push({ t: 'same', s: a[i - 1] });
        i--; j--;
      } else if (dp[i - 1][j] >= dp[i][j - 1]) {
        lines.push({ t: 'del', s: a[i - 1] });
        i--;
      } else {
        lines.push({ t: 'add', s: b[j - 1] });
        j--;
      }
    }
    while (i > 0) { lines.push({ t: 'del', s: a[i - 1] }); i--; }
    while (j > 0) { lines.push({ t: 'add', s: b[j - 1] }); j--; }
    lines.reverse();
  } else {
    // 公共前缀
    let pre = 0;
    while (pre < a.length && pre < b.length && a[pre] === b[pre]) pre++;
    // 公共后缀（不与前缀重叠）
    let suf = 0;
    while (
      suf < a.length - pre && suf < b.length - pre &&
      a[a.length - 1 - suf] === b[b.length - 1 - suf]
    ) suf++;
    for (let k = 0; k < pre; k++) lines.push({ t: 'same', s: a[k] });
    for (let k = pre; k < a.length - suf; k++) lines.push({ t: 'del', s: a[k] });
    for (let k = pre; k < b.length - suf; k++) lines.push({ t: 'add', s: b[k] });
    for (let k = a.length - suf; k < a.length; k++) lines.push({ t: 'same', s: a[k] });
  }

  // 折叠 same：每段 same 首尾各保留 3 行上下文，中间折叠为提示。
  const CONTEXT = 3;
  const parts: DiffPart[] = [];
  const pushPart = (t: DiffPart['t'], s: string) => {
    const last = parts[parts.length - 1];
    if (last && last.t === t) last.s += '\n' + s;
    else parts.push({ t, s });
  };

  let k = 0;
  while (k < lines.length) {
    if (lines[k].t !== 'same') {
      pushPart(lines[k].t, lines[k].s);
      k++;
      continue;
    }
    let end = k;
    while (end < lines.length && lines[end].t === 'same') end++;
    const run = lines.slice(k, end).map((l) => l.s);
    const len = run.length;
    if (len <= CONTEXT * 2) {
      for (const s of run) pushPart('same', s);
    } else {
      for (let x = 0; x < CONTEXT; x++) pushPart('same', run[x]);
      pushPart('same', `⋯ ${len - CONTEXT * 2} 行未变更`);
      for (let x = len - CONTEXT; x < len; x++) pushPart('same', run[x]);
    }
    k = end;
  }
  return parts;
}

const pb = Astro.locals.pb;

const { postId } = Astro.params;
// Inline 404 instead of redirect to /404 — preserves nav chrome.
const notFound = !postId;
if (notFound) Astro.response.status = 404;

const user = getAuthUser(pb);
const isAdmin = user?.role === 'admin';

let post: Post | null = null;
let revs: Revision[] = [];
let denied = false;

if (!notFound) {
  try {
    post = await pb.collection('posts').getOne<Post>(postId);
  } catch {
    // post missing OR blocked by posts ViewRule. Render inline 404.
    denied = true;
    Astro.response.status = 404;
  }
}

if (!notFound && !denied) {
  try {
    revs = await pb.collection('revisions').getFullList<Revision>({
      filter: `target = "${postId}"`,
      sort: '-created',
    });
  } catch (e) {
    console.error('[revisions] Failed to load:', e);
  }

  // revisions ListRule (1782300004) returns empty for non-admin reading
  // someone else's post. Distinguish "no history" from "no access":
  // collaborators reading their own post legitimately see empty too, so we
  // only mark denied=true when the post's author isn't the current user.
  if (!isAdmin && post && post.author !== user?.id && revs.length === 0) {
    denied = true;
    Astro.response.status = 403;
  }
}

// 恢复按钮 SSR 门控：无权限完全不渲染。
const canRestore =
  !!post &&
  !!hasPermission(pb, 'article:update') &&
  (!!isAdmin || post.author === user?.id);

// 修订按时间正序逐条与当前 post.content 比（不逐对相邻比）。
const asc = [...revs].reverse();
interface RenderRev {
  r: Revision;
  latest: boolean;
  titleDiff: { oldTitle: string; newTitle: string } | null;
  parts: DiffPart[];
  changed: boolean;
}
const renderLine = (p: DiffPart) =>
  p.s
    .split('\n')
    .map((l) => (p.t === 'del' ? `- ${l}` : p.t === 'add' ? `+ ${l}` : `  ${l}`))
    .join('\n');
const items: RenderRev[] = asc.map((r, idx) => {
  const snap = (r.snapshot ?? {}) as { title?: string; content?: string };
  const cur = post as Post;
  const oldTitle = snap.title ?? '';
  const titleDiff =
    oldTitle !== cur.title ? { oldTitle, newTitle: cur.title } : null;
  const parts = diffLines(snap.content ?? '', cur.content ?? '');
  return {
    r,
    latest: idx === asc.length - 1,
    titleDiff,
    parts,
    changed: parts.some((p) => p.t !== 'same'),
  };
});

const REASON_MUTED = new Set(['auto-save']);
const reasonClass = (reason?: string) =>
  `badge${reason && REASON_MUTED.has(reason) ? ' badge-muted' : ''}`.trim();
---
<AdminLayout title={notFound ? '修订历史 - 不存在' : denied ? '修订历史 - 无权限' : `修订历史 - ${post?.title || ''}`}>
  <h1>修订历史</h1>
  <p><a href={`/admin/edit/${postId}`}>编辑</a></p>
  {!notFound && !denied && (
    <>
      <p><strong>文章：</strong>{post?.title}</p>
      <hr />
    </>
  )}

  {notFound ? (
    <ErrorNotice code="404" title="文章不存在" message="该文章可能已被彻底删除，或链接有误。" />
  ) : denied ? (
    <ErrorNotice code="403" title="无权限查看历史" message="仅作者或管理员可查看该文章的修订历史。" />
  ) : revs.length === 0 ? (
    <p>暂无修订记录。</p>
  ) : (
    <ul class="list-none p-0 flex flex-col gap-3" data-post-id={postId}>
      {items.map(({ r, latest, titleDiff, parts, changed }) => {
        const snap = (r.snapshot ?? {}) as { title?: string; content?: string };
        return (
          <li class="border border-[var(--border)] rounded p-4">
            <details open={latest}>
              <summary class="cursor-pointer flex items-center gap-3 flex-wrap">
                <span class={reasonClass(r.reason)}>{r.reason || '(无原因)'}</span>
                <span class="text-xs text-[var(--text-muted)]">{fmtDateTime(r.created)}</span>
                <span class="text-xs text-[var(--text-muted)]">by {r.authoredBy || '-'}</span>
              </summary>
              {titleDiff && (
                <p class="text-sm mt-2">
                  标题: <span class="text-[var(--error)]">{titleDiff.oldTitle}</span>
                  {' → '}
                  <span class="text-[var(--success)]">{titleDiff.newTitle}</span>
                </p>
              )}
              <pre class="text-xs font-mono mt-2 whitespace-pre-wrap overflow-x-auto border border-[var(--border)] rounded p-2">{parts.map((p) => <span class={`block ${p.t === 'del' ? 'bg-[var(--error)]/10 text-[var(--error)]' : p.t === 'add' ? 'bg-[var(--success)]/10 text-[var(--success)]' : 'text-[var(--text-muted)]'}`}>{renderLine(p)}</span>)}{!changed && <span class="block text-[var(--text-muted)]">（内容与当前版本一致）</span>}</pre>
              {canRestore && (
                <div class="mt-3">
                  <button
                    type="button"
                    class="btn btn-sm btn-danger btn-restore"
                    data-rev={r.id}
                    data-title={snap.title ?? ''}
                    data-content={snap.content ?? ''}
                  >恢复到此版本</button>
                </div>
              )}
            </details>
          </li>
        );
      })}
    </ul>
  )}
</AdminLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.btn-restore').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const ok = await self.vanblogUI?.confirmDialog({
        title: '恢复到此版本',
        message: '确认恢复到此版本？当前内容会先自动存为一条修订，之后可以再恢复回来。',
        confirmText: '恢复',
        danger: true,
      });
      if (!ok) return;
      const pb = self.vanblog?.pb;
      if (!pb) return self.vanblogUI?.toast('登录已失效，请重新登录', 'error');
      const postId = btn.closest('ul')?.getAttribute('data-post-id');
      if (!postId) return self.vanblogUI?.toast('找不到文章 ID，请刷新页面重试', 'error');
      try {
        await pb.collection('posts').update(postId, {
          title: btn.dataset.title ?? '',
          content: btn.dataset.content ?? '',
        });
        self.vanblogUI?.toast('已恢复到此版本', 'success');
        location.reload();
      } catch (err: any) {
        self.vanblogUI?.toast('恢复失败: ' + (err?.message || err), 'error');
      }
    });
  });
</script>
