---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { safe } from '@vanblog/sdk';
import type { Category, Post } from '@vanblog/sdk';

const pb = Astro.locals.pb;

const { data: cats = [] } = await safe(
  () => pb.collection('categories').getFullList<Category>({ sort: 'name' }),
  'admin/cats'
);

const { data: posts = [] } = await safe(
  () =>
    pb.collection('posts').getFullList<Post>({
      fields: 'category,tags,deleted',
      filter: 'deleted!=true',
    }),
  'admin/cats-posts'
);

const countMap = new Map<string, number>();
for (const p of posts) {
  if (p.category) countMap.set(p.category, (countMap.get(p.category) || 0) + 1);
}
---
<AdminLayout title="分类管理">
  <h1>分类管理</h1>
  <p><a href="/admin/tags">→ 标签管理</a></p>

  <form id="new-cat" class="flex gap-2 flex-wrap mb-4">
    <input name="name" placeholder="分类名" required class="px-1.5 py-0.5 flex-1 min-w-[160px]" />
    <select name="type">
      <option value="category">分类</option>
      <option value="column">专栏</option>
    </select>
    <label><input type="checkbox" name="private" /> 私有</label>
    <button type="submit" class="btn btn-primary">+ 新建</button>
  </form>

  <div class="table-wrap">
    <table class="admin-table w-full">
      <thead>
        <tr>
          <th>名称</th><th>类型</th><th>私有</th><th>文章数</th><th>操作</th>
        </tr>
      </thead>
      <tbody>
        {cats.map(c => {
          const count = (c.id && countMap.get(c.id)) || 0;
          return (
            <tr data-id={c.id} data-name={c.name} data-count={count}>
              <td><input class="f-name" value={c.name} class="w-full" /></td>
              <td>
                <select class="f-type">
                  <option value="category" selected={c.type === 'category'}>分类</option>
                  <option value="column" selected={c.type === 'column'}>专栏</option>
                </select>
              </td>
              <td><input type="checkbox" class="f-private" checked={!!c.private} /></td>
              <td>
                <a href={`/admin?category=${c.id}`}>
                  <span class="badge badge-muted">{count}</span>
                </a>
              </td>
              <td class="flex gap-2">
                <button class="btn btn-sm btn-save">保存</button>
                <button class="btn btn-sm btn-danger btn-del">删除</button>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  {cats.length === 0 && <p>暂无分类。</p>}

  <script>
    const toast = (msg: string, type: 'success' | 'error' | 'info', ttl?: number) =>
      self.vanblogUI?.toast(msg, type, ttl);

    const confirmDialog = (opts: { title?: string; message: string; confirmText?: string; danger?: boolean }) =>
      self.vanblogUI?.confirmDialog(opts) ?? Promise.resolve(false);

    document.getElementById('new-cat')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pb = self.vanblog?.pb;
      if (!pb) return;
      const fd = new FormData(e.target as HTMLFormElement);
      try {
        await pb.collection('categories').create({
          name: fd.get('name'),
          type: fd.get('type'),
          private: fd.get('private') === 'on',
        });
        location.reload();
      } catch (err) {
        toast('新建失败: ' + (err as Error).message, 'error');
      }
    });

    document.querySelectorAll<HTMLElement>('tr[data-id]').forEach((tr) => {
      const id = tr.dataset.id!;
      const saveBtn = tr.querySelector<HTMLButtonElement>('.btn-save')!;

      saveBtn.onclick = async () => {
        const pb = self.vanblog?.pb;
        if (!pb) return;
        try {
          await pb.collection('categories').update(id, {
            name: (tr.querySelector('.f-name') as HTMLInputElement).value,
            type: (tr.querySelector('.f-type') as HTMLInputElement).value,
            private: (tr.querySelector('.f-private') as HTMLInputElement).checked,
          });
          const orig = saveBtn.textContent;
          saveBtn.textContent = '✓ 已保存';
          setTimeout(() => { saveBtn.textContent = orig; }, 1500);
        } catch (err) {
          toast('保存失败: ' + (err as Error).message, 'error');
        }
      };

      tr.querySelector<HTMLElement>('.btn-del')!.onclick = async () => {
        const pb = self.vanblog?.pb;
        if (!pb) return;
        const name = tr.dataset.name || '该分类';
        const count = Number(tr.dataset.count || 0);
        const using = count > 0 ? `（${count} 篇文章正在使用）` : '';
        const ok = await confirmDialog({
          title: '删除分类',
          message: `确定删除「${name}」？${using}`,
          confirmText: '删除',
          danger: true,
        });
        if (!ok) return;
        try {
          await pb.vanblog.categories.delete(id);
          tr.remove();
          toast('已删除', 'success');
        } catch (err) {
          toast('删除失败: ' + (err as Error).message, 'error');
        }
      };
    });
  </script>
</AdminLayout>
