---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import ErrorNotice from '../../components/ErrorNotice.astro';
import { requireAdmin, getAuthUser } from '../../middleware';


Astro.cache.set(false);

const denied = !requireAdmin(Astro);
if (denied) Astro.response.status = 403;

const ALL_PERMS = [
  'article:create', 'article:delete', 'article:update',
  'draft:publish', 'draft:create', 'draft:delete', 'draft:update',
  'img:delete', 'all',
];

let users: any[] = [];
if (!denied) {
  try {
    users = await Astro.locals.pb.collection('users').getFullList({ sort: 'username' });
  } catch (e) {
    console.error('[admin/users] load:', e);
  }
}

// Last-admin guard: demoting or deleting the only remaining admin locks
// everyone out of admin UI. Compute admin count for client-side guard and
// also pass current user id so self-demotion is at least visible.
const currentUserId = getAuthUser(Astro)?.id;
const adminCount = users.filter((u) => u.role === 'admin').length;
---
<AdminLayout title="用户管理">
  <h1>用户管理</h1>
  <p><a href="/admin">← 返回</a></p>

  {denied ? (
    <ErrorNotice code="403" title="无权限访问" message="用户管理仅管理员可见。" />
  ) : (
    <form id="new-user" class="flex gap-2 flex-wrap mb-4">
    <input name="username" placeholder="用户名" required class="px-1.5 py-0.5" />
    <input name="email" type="email" placeholder="邮箱（登录用）" required class="px-1.5 py-0.5 flex-1 min-w-[200px]" />
    <input name="password" type="password" placeholder="初始密码" required class="px-1.5 py-0.5 w-40" />
    <input name="nickname" placeholder="昵称（可空）" class="px-1.5 py-0.5" />
    <select name="role">
      <option value="collaborator">协作者</option>
      <option value="admin">管理员</option>
    </select>
    <button type="submit">+ 新建</button>
  </form>

  <table class="w-full border-collapse">
    <thead>
      <tr class="text-left border-b border-[var(--color-border)]">
        <th>用户名</th><th>昵称</th><th>邮箱</th><th>角色</th><th>权限</th><th>操作</th>
      </tr>
    </thead>
    <tbody>
      {users.map((u: any) => (
        <tr data-id={u.id} data-role={u.role} class="border-b border-[var(--color-border)]">
          <td>{u.username}</td>
          <td><input class="f-nickname" value={u.nickname || ''} class="w-full" /></td>
          <td><small>{u.email}</small></td>
          <td>
            <select class="f-role">
              <option value="collaborator" selected={u.role === 'collaborator'}>协作者</option>
              <option value="admin" selected={u.role === 'admin'}>管理员</option>
            </select>
          </td>
          <td>
            <details>
              <summary class="cursor-pointer">{(u.permissions || []).length || 0} 项</summary>
              <fieldset class="grid grid-cols-2 gap-1">
                {ALL_PERMS.map(p => (
                  <label>
                    <input type="checkbox" class="f-perm" value={p} checked={(u.permissions || []).includes(p)} />
                    {p}
                  </label>
                ))}
              </fieldset>
            </details>
          </td>
          <td class="flex gap-2">
            <button class="btn-save">保存</button>
            <button class="btn-reset" title="发送重置密码邮件 / 或在此设置新密码">改密码</button>
            <button class="btn-del" class="text-red-600">删除</button>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  <script define:vars={{ currentUserId, adminCount }}>
    const pb = window.__pb!;

    document.getElementById('new-user')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.currentTarget as HTMLFormElement);
      try {
        await pb.collection('users').create({
          username: fd.get('username'),
          email: fd.get('email'),
          password: fd.get('password'),
          passwordConfirm: fd.get('password'),
          nickname: fd.get('nickname') || undefined,
          role: fd.get('role'),
          permissions: [],
        });
        location.reload();
      } catch (err) { alert('新建失败: ' + (err as Error).message); }
    });

    // Demoting the last admin locks all admin routes (UpdateRule
    // @request.auth.role = "admin"). Block before the request — pb returns
    // 404 on the next save, which looks like a mystery bug.
    function isLastAdminDowngrade(tr) {
      const roleSel = tr.querySelector<HTMLSelectElement>('.f-role')!;
      const wasAdmin = tr.dataset.role === 'admin';
      const willAdmin = roleSel.value === 'admin';
      return wasAdmin && !willAdmin && adminCount <= 1;
    }

    document.querySelectorAll<HTMLElement>('tr[data-id]').forEach((tr) => {
      const id = tr.dataset.id!;
      tr.querySelector<HTMLElement>('.btn-save')!.onclick = async () => {
        if (isLastAdminDowngrade(tr)) {
          alert('无法降级：这是系统里唯一的管理员。请先把另一个用户提升为管理员。');
          return;
        }
        const perms = Array.from(tr.querySelectorAll<HTMLInputElement>('.f-perm:checked')).map((c) => c.value);
        try {
          await pb.collection('users').update(id, {
            nickname: tr.querySelector<HTMLInputElement>('.f-nickname')!.value,
            role: tr.querySelector<HTMLSelectElement>('.f-role')!.value,
            permissions: perms,
          });
          alert('已保存');
        } catch (err) { alert('保存失败: ' + (err as Error).message); }
      };
      tr.querySelector<HTMLElement>('.btn-reset')!.onclick = async () => {
        const pw = prompt('输入新密码（留空取消）');
        if (!pw) return;
        try {
          await pb.collection('users').update(id, { password: pw, passwordConfirm: pw });
          alert('已重置');
        } catch (err) { alert('重置失败: ' + (err as Error).message); }
      };
      tr.querySelector<HTMLElement>('.btn-del')!.onclick = async () => {
        if (tr.dataset.role === 'admin' && adminCount <= 1) {
          alert('无法删除：这是系统里唯一的管理员。');
          return;
        }
        if (!confirm('确定删除该用户？')) return;
        try {
          await pb.vanblog.users.delete(id);
          tr.remove();
        } catch (err) { alert('删除失败: ' + (err as Error).message); }
      };
    });
  </script>
  )}
</AdminLayout>
