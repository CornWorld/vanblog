---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import ErrorNotice from '../../components/ErrorNotice.astro';
import { requireAdmin, safe } from '@vanblog/sdk';
const pb = Astro.locals.pb;



const denied = !requireAdmin(pb);
if (denied) Astro.response.status = 403;

const ALL_PERMS = [
  'article:create', 'article:delete', 'article:update',
  'draft:publish', 'draft:create', 'draft:delete', 'draft:update',
  'img:delete', 'all',
];

const { data: users = [] } = denied ? { data: [] } : await safe(
  () => pb.collection('users').getFullList({ sort: 'username' }),
  'admin/users'
);

// Last-admin guard
const adminCount = users.filter((u: any) => u.role === 'admin').length;
---
<AdminLayout title="用户管理">
  <h1>用户管理</h1>

  {denied ? (
    <ErrorNotice code="403" title="无权限访问" message="用户管理仅管理员可见。" />
  ) : (
    <form id="new-user" class="flex gap-2 flex-wrap mb-4">
    <input name="username" placeholder="用户名" required class="px-1.5 py-0.5" />
    <input name="email" type="email" placeholder="邮箱（登录用）" required class="px-1.5 py-0.5 flex-1 min-w-[200px]" />
    <input name="password" type="password" placeholder="初始密码" required class="px-1.5 py-0.5 w-40" />
    <input name="nickname" placeholder="昵称（可空）" class="px-1.5 py-0.5" />
    <select name="role">
      <option value="collaborator">协作者</option>
      <option value="admin">管理员</option>
    </select>
    <button type="submit">+ 新建</button>
  </form>

  <div class="table-wrap">
  <table class="admin-table">
    <thead>
      <tr class="text-left border-b border-[var(--border)]">
        <th>用户名</th><th>昵称</th><th>邮箱</th><th>角色</th><th>权限</th><th>操作</th>
      </tr>
    </thead>
    <tbody>
      {users.map((u: any) => (
        <tr data-id={u.id} data-role={u.role} data-username={u.username} class="border-b border-[var(--border)]">
          <td>{u.username}</td>
          <td><input class="f-nickname" value={u.nickname || ''} class="w-full" /></td>
          <td><small>{u.email}</small></td>
          <td>
            <select class="f-role">
              <option value="collaborator" selected={u.role === 'collaborator'}>协作者</option>
              <option value="admin" selected={u.role === 'admin'}>管理员</option>
            </select>
          </td>
          <td>
            <details>
              <summary class="cursor-pointer">{(u.permissions || []).length || 0} 项</summary>
              <fieldset class="grid grid-cols-2 gap-1">
                {ALL_PERMS.map(p => (
                  <label>
                    <input type="checkbox" class="f-perm" value={p} checked={(u.permissions || []).includes(p)} />
                    {p}
                  </label>
                ))}
              </fieldset>
            </details>
          </td>
          <td class="flex gap-2">
            <button class="btn btn-sm btn-save">保存</button>
            <button class="btn btn-sm btn-reset" title="为该用户设置新密码">改密码</button>
            <button class="btn btn-sm btn-danger btn-del">删除</button>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>
<script is:inline type="application/json" id="users-data" set:html={JSON.stringify({ adminCount })} />
  <script is:inline>
    const { adminCount } = JSON.parse(document.getElementById('users-data').textContent);
    // 懒解析：is:inline 脚本先于 AdminLayout 的 initClient 模块执行，
    // 顶层直接取 self.vanblog.pb 会让整个脚本在解析期崩掉（表单裸提交）。
    const getPb = () => self.vanblog?.pb;

    document.getElementById('new-user').addEventListener('submit', async (e) => {
      e.preventDefault();
      const pb = getPb();
      if (!pb) return self.vanblogUI?.toast('登录已失效，请重新登录', 'error');
      const fd = new FormData(e.currentTarget);
      try {
        await pb.collection('users').create({
          username: fd.get('username'),
          email: fd.get('email'),
          password: fd.get('password'),
          passwordConfirm: fd.get('password'),
          nickname: fd.get('nickname') || undefined,
          role: fd.get('role'),
          permissions: [],
        });
        location.reload();
      } catch (err) { self.vanblogUI?.toast('新建失败: ' + (err).message, 'error'); }
    });

    // Demoting the last admin locks all admin routes (UpdateRule
    // @request.auth.role = "admin"). Block before the request — pb returns
    // 404 on the next save, which looks like a mystery bug.
    function isLastAdminDowngrade(tr) {
      const roleSel = tr.querySelector('.f-role');
      const wasAdmin = tr.dataset.role === 'admin';
      const willAdmin = roleSel.value === 'admin';
      return wasAdmin && !willAdmin && adminCount <= 1;
    }

    document.querySelectorAll('tr[data-id]').forEach((tr) => {
      const id = tr.dataset.id;
      tr.querySelector('.btn-save').onclick = async () => {
        const pb = getPb();
        if (!pb) return self.vanblogUI?.toast('登录已失效，请重新登录', 'error');
        if (isLastAdminDowngrade(tr)) {
          self.vanblogUI?.toast('无法降级：这是系统里唯一的管理员。请先把另一个用户提升为管理员。', 'error', 5000);
          return;
        }
        const perms = Array.from(tr.querySelectorAll('.f-perm:checked')).map((c) => c.value);
        try {
          await pb.collection('users').update(id, {
            nickname: tr.querySelector('.f-nickname').value,
            role: tr.querySelector('.f-role').value,
            permissions: perms,
          });
          self.vanblogUI?.toast('已保存', 'success');
        } catch (err) { self.vanblogUI?.toast('保存失败: ' + (err).message, 'error'); }
      };
      tr.querySelector('.btn-reset').onclick = async () => {
        const pb = getPb();
        if (!pb) return self.vanblogUI?.toast('登录已失效，请重新登录', 'error');
        const username = tr.querySelector('td')?.textContent?.trim() || '该用户';
        const pw = await self.vanblogUI?.promptDialog({
          title: `重置密码 — ${username}`,
          message: '新密码至少 8 位。重置后请通知该用户重新登录。',
          label: '新密码',
          type: 'password',
          placeholder: '至少 8 位',
          confirmText: '重置',
          danger: true,
          validate: (v) => (v.length >= 8 ? null : '密码至少 8 位'),
        });
        if (!pw) return;
        try {
          await pb.collection('users').update(id, { password: pw, passwordConfirm: pw });
          self.vanblogUI?.toast('密码已重置', 'success');
        } catch (err) { self.vanblogUI?.toast('重置失败: ' + (err).message, 'error'); }
      };
      tr.querySelector('.btn-del').onclick = async () => {
        const pb = getPb();
        if (!pb) return self.vanblogUI?.toast('登录已失效，请重新登录', 'error');
        if (tr.dataset.role === 'admin' && adminCount <= 1) {
          self.vanblogUI?.toast('无法删除：这是系统里唯一的管理员。', 'error');
          return;
        }
        const name = tr.dataset.username || '该用户';
        if (!(await self.vanblogUI?.confirmDialog({
          title: '删除用户',
          message: `确定删除用户 ${name}？该操作不可撤销。`,
          confirmText: '删除',
          danger: true,
        }))) return;
        try {
          await pb.vanblog.users.delete(id);
          tr.remove();
        } catch (err) { self.vanblogUI?.toast('删除失败: ' + (err).message, 'error'); }
      };
    });
  </script>
  )}
</AdminLayout>
