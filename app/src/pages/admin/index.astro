---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getAuthUser, hasPermission, safe, getPage, buildPageHref } from '@vanblog/sdk';
import { fmtDateTime } from '@vanblog/sdk';
import type { Post } from '@vanblog/sdk';
const pb = Astro.locals.pb;


const user = getAuthUser(pb);
const isAdmin = user?.role === 'admin';
const canEditPost = !!hasPermission(pb, 'article:create') || !!hasPermission(pb, 'article:update');
const canDeletePost = !!hasPermission(pb, 'article:delete');

const PER_PAGE = 20;
const page = getPage(Astro.url.searchParams);
const q = (Astro.url.searchParams.get('q') || '').trim();
const status = Astro.url.searchParams.get('status') || '';

const parts: string[] = [];
if (q) parts.push(`title ~ "${q.replace(/"/g, '\\"')}"`);
if (status) parts.push(`status = "${status}"`);
const filter = parts.join(' && ');

const { data: result } = await safe(
  () => pb.collection('posts').getList<Post>(page, PER_PAGE, {
    sort: '-updated',
    filter: filter || undefined,
  }),
  'admin'
);
const posts = result?.items ?? [];
const totalPosts = result?.totalItems ?? 0;
const totalPages = result?.totalPages ?? 1;


---
<AdminLayout title="管理">
  <h1>文章管理</h1>

  <nav class="flex gap-4 flex-wrap mb-4">
    {canEditPost && <a href="/admin/new">+ 新建文章</a>}
    <a href="/admin/tags">标签</a>
    <a href="/admin/categories">分类</a>
    <a href="/admin/media">媒体</a>
    {canEditPost && <a href="/admin/trash">回收站</a>}
    {isAdmin && <a href="/admin/users">用户</a>}
    {isAdmin && <a href="/admin/site">站点</a>}
    {isAdmin && <a href="/admin/routing">路由</a>}
    {isAdmin && <a href="/admin/audits">审计</a>}
  </nav>

  <p class="text-xs text-[var(--color-text-muted)]">
    当前用户：<strong>{user?.username}</strong> [{user?.role}]
    {user?.permissions && user.permissions.length > 0 && (
      <span> · 权限: {user.permissions.join(', ')}</span>
    )}
  </p>

  <form method="get" class="flex gap-2 flex-wrap items-center my-3 text-sm">
    <input name="q" value={q} placeholder="标题关键字" class="px-1.5 py-0.5 w-48" />
    <select name="status" class="px-1.5 py-0.5">
      <option value="" selected={!status}>全部状态</option>
      <option value="draft" selected={status === 'draft'}>draft</option>
      <option value="published" selected={status === 'published'}>published</option>
      <option value="hidden" selected={status === 'hidden'}>hidden</option>
    </select>
    <button type="submit">筛选</button>
    {(q || status) && <a href="/admin" class="text-[var(--color-text-muted)]">清除</a>}
  </form>

  {posts.length === 0 ? (
    <p>{(q || status) ? '没有匹配的文章。' : '暂无文章。'}{canEditPost && !(q || status) && <a href="/admin/new">创建第一篇</a>}</p>
  ) : (
    <>
    <table class="w-full border-collapse">
      <thead>
        <tr class="text-left border-b border-[var(--color-border)]">
          <th>标题</th>
          <th>状态</th>
          <th>更新时间</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        {posts.map(post => (
          <tr class="border-b border-[var(--color-border)]">
            <td>{post.title}</td>
            <td>{post.status}</td>
            <td>{fmtDateTime(post.updated)}</td>
            <td class="flex gap-2 flex-wrap">
              {canEditPost && <a href={`/admin/edit/${post.id}`}>编辑</a>}
              <a href={`/admin/revisions/${post.id}`}>修订</a>
              <a href={`/posts/${post.id}`} target="_blank">查看</a>
              {canDeletePost && (
                <a href={`#del-${post.id}`} data-del={post.id} class="text-red-600">删除</a>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class="text-xs text-[var(--color-text-muted)] mt-2">
      共 {totalPosts} 篇 · 第 {page}/{totalPages} 页
    </p>

    {totalPages > 1 && (
      <nav class="flex gap-2 mt-2 text-sm" aria-label="分页">
        {page > 1 && <a href={buildPageHref('/admin', Astro.url.searchParams, page - 1)} class="px-2 py-0.5 border rounded">上一页</a>}
        {page < totalPages && <a href={buildPageHref('/admin', Astro.url.searchParams, page + 1)} class="px-2 py-0.5 border rounded">下一页</a>}
      </nav>
    )}
    </>
  )}

  <script define:vars={{}}>
    document.querySelectorAll('a[data-del]').forEach((a) => {
      a.addEventListener('click', async (e) => {
        e.preventDefault();
        const id = a.dataset.del;
        if (!id || !confirm('确定删除该文章？（软删除：deleted=true）')) return;
        const pb = window.__pb;
        if (!pb) return alert('未登录');
        try {
          // soft-delete: mark deleted=true so it stays in revisions/audits
          await pb.collection('posts').update(id, { deleted: true });
          location.reload();
        } catch (err) {
          alert('删除失败: ' + err.message);
        }
      });
    });
  </script>
</AdminLayout>
