---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import ErrorNotice from '../../../components/ErrorNotice.astro';
import { getAuthUser, hasPermission } from '@vanblog/sdk';
import ByteMdEditor from '../../../components/ByteMdEditor.astro';
import type { Post, Tag, Category } from '@vanblog/sdk';

const user = getAuthUser(Astro.locals.pb)!;

Astro.cache.set(false);

const canEdit = hasPermission(Astro.locals.pb, 'article:create') || hasPermission(Astro.locals.pb, 'article:update');
// Inline 403 instead of silent redirect to /admin — same UX rationale as
// the other admin pages.
const denied = !canEdit;
if (denied) Astro.response.status = 403;

const { id } = Astro.params;
const isNew = !id || id === 'new';

let post: Partial<Post> = {};
let notFound = false;
if (!denied && !isNew) {
  try {
    post = await Astro.locals.pb.collection('posts').getOne<Post>(id);
  } catch {
    // Inline 404 instead of redirect to /404 — keeps editor chrome visible
    // so the user can navigate back without losing context.
    notFound = true;
    Astro.response.status = 404;
  }
}

let tags: Tag[] = [];
let cats: Category[] = [];
if (!denied && !notFound) {
  try {
    const pb = Astro.locals.pb;
    [tags, cats] = await Promise.all([
      pb.collection('tags').getFullList<Tag>({ sort: 'name' }),
      pb.collection('categories').getFullList<Category>({ sort: 'name' }),
    ]);
  } catch (e) {
    console.error('[edit] Failed to load tags/cats:', e);
  }
}

const site = await Astro.locals.getSite();
const mediaConfig = site?.mediaConfig;

const currentTagIds: string[] = Array.isArray(post.tags) ? post.tags : [];
const currentCatId: string = post.category || '';
const currentAuthorId: string = post.author || user.id;
---
<AdminLayout title={isNew ? '新建文章' : '编辑文章'}>
  <h1>{isNew ? '新建文章' : '编辑文章'}</h1>

  {denied ? (
    <ErrorNotice code="403" title="无权限访问" message="编辑文章需要 article:create 或 article:update 权限。" />
  ) : notFound ? (
    <ErrorNotice code="404" title="文章不存在" message="该文章可能已被删除，或你没有访问权限。" />
  ) : (
    <div class="flex flex-wrap gap-4 mb-4 items-end">
    <label class="flex flex-col">
      标题
      <input type="text" id="f-title" value={post.title || ''} required class="w-80 px-1.5 py-0.5" />
    </label>
    <label class="flex flex-col">
      路径
      <input type="text" id="f-path" value={post.pathname || ''} placeholder="/my-post" class="w-48 px-1.5 py-0.5" />
    </label>
    <label class="flex flex-col">
      状态
      <select id="f-status">
        <option value="draft" selected={post.status !== 'published' && post.status !== 'hidden'}>草稿</option>
        <option value="published" selected={post.status === 'published'}>已发布</option>
        <option value="hidden" selected={post.status === 'hidden'}>隐藏</option>
      </select>
    </label>
    <label class="flex flex-col">
      置顶
      <input type="number" id="f-top" value={post.top ?? 0} min="0" class="w-20 px-1.5 py-0.5" />
    </label>
  </div>

  <div class="flex flex-wrap gap-4 mb-4 items-end">
    <label class="flex flex-col">
      分类
      <select id="f-category" class="min-w-[180px]">
        <option value="">（无）</option>
        {cats.map(c => (
          <option value={c.id} selected={currentCatId === c.id}>{c.name}</option>
        ))}
      </select>
    </label>
    <label class="flex flex-col" id="lbl-tags">
      标签
      <select id="f-tags" multiple size="4" class="min-w-[280px]">
        {tags.map(t => (
          <option value={t.id} selected={currentTagIds.includes(t.id)}>#{t.name}</option>
        ))}
      </select>
      <small class="text-[var(--color-text-muted)]">Ctrl/Cmd 多选</small>
    </label>
    <label class="flex flex-col">
      版权
      <input type="text" id="f-copyright" value={post.copyright || ''} class="w-60 px-1.5 py-0.5" />
    </label>
  </div>

  <details class="mb-4">
    <summary class="cursor-pointer">高级（私有文章 / 密码）</summary>
    <div class="flex gap-4 flex-wrap py-2">
      <label><input type="checkbox" id="f-private" checked={!!post.private} /> 私有</label>
      <label class="flex flex-col">
        密码（空则无）
        <input type="text" id="f-password" value={post.password || ''} class="w-48 px-1.5 py-0.5" />
      </label>
    </div>
  </details>

  <ByteMdEditor initialContent={post.content || ''} mediaConfig={mediaConfig} />

  <div class="mt-2 flex gap-4">
    <button id="btn-save" type="button">保存</button>
    <button id="btn-publish" type="button">保存并发布</button>
    <a href="/admin">取消</a>
  </div>

  <script define:vars={{
    postId: isNew ? null : id,
    authorId: currentAuthorId,
  }}>
    const save = async (publish) => {
      const pb = window.__pb;
      if (!pb) return alert('未登录');

      const tagIds = Array.from(document.getElementById('f-tags').selectedOptions).map(o => o.value);

      const data = {
        title: document.getElementById('f-title').value.trim(),
        pathname: document.getElementById('f-path').value.trim(),
        content: document.getElementById('post-content').value,
        status: publish ? 'published' : document.getElementById('f-status').value,
        top: Number(document.getElementById('f-top').value || 0),
        category: document.getElementById('f-category').value || null,
        tags: tagIds,
        copyright: document.getElementById('f-copyright').value,
        private: document.getElementById('f-private').checked,
        password: document.getElementById('f-password').value,
        author: authorId,
        deleted: false,
      };

      if (!data.title) return alert('标题不能为空');

      try {
        if (postId) await pb.collection('posts').update(postId, data);
        else await pb.collection('posts').create(data);
        location.href = '/admin';
      } catch (e) { alert('保存失败: ' + e.message); }
    };

    document.getElementById('btn-save').onclick = () => save(false);
    document.getElementById('btn-publish').onclick = () => save(true);
  </script>
  )}
</AdminLayout>
