---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { hasPermission, safe, getPage, buildPageHref } from '@vanblog/sdk';
import type { Media } from '@vanblog/sdk';

const pb = Astro.locals.pb;
const canDelete = !!hasPermission(pb, 'article:delete');

const PER_PAGE = 24;
const page = getPage(Astro.url.searchParams);

const { data: result } = await safe(
  () => pb.collection('media').getList<Media>(page, PER_PAGE, { sort: '-created' }),
  'admin/media'
);
const media = result?.items ?? [];
const totalMedia = result?.totalItems ?? 0;
const totalPages = result?.totalPages ?? 1;
---
<AdminLayout title="媒体管理">
  <h1>媒体管理</h1>
  <p><a href="/admin">← 返回管理</a></p>

  <form id="upload-form" class="flex items-center gap-2 mb-4">
    <input id="upload-input" type="file" accept="image/*" multiple required class="text-sm" />
    <button type="submit">上传</button>
    <span id="upload-status" class="text-sm text-[var(--color-text-muted)]"></span>
  </form>

  {media.length === 0 ? (
    <p>暂无媒体文件。</p>
  ) : (
    <>
    <div id="media-grid" class="flex flex-wrap gap-4">
      {media.map(m => (
        <figure class="m-0 w-40 border border-[var(--color-border)] p-2">
          {m.staticType === 'img' && (
            <img
              src={`/api/files/media/${m.id}/${m.file}`}
              alt={m.file}
              loading="lazy"
              class="w-full h-[120px] object-cover block"
            />
          )}
          <figcaption class="text-xs mt-1 break-all">
            {m.file}
            <br />
            <small class="text-[var(--color-text-muted)]">[{m.storageType}/{m.fileType}]</small>
          </figcaption>
          <div class="flex gap-2 mt-1">
            <button type="button" class="btn-copy text-xs" data-url={`/api/files/media/${m.id}/${m.file}`}>复制 URL</button>
            {canDelete && (
              <button
                type="button"
                class="btn-delete text-red-600 text-xs"
                data-id={m.id}
                data-name={m.file}
              >删除</button>
            )}
          </div>
        </figure>
      ))}
    </div>

    <p class="text-xs text-[var(--color-text-muted)] mt-3">
      共 {totalMedia} 个 · 第 {page}/{totalPages} 页
    </p>

    {totalPages > 1 && (
      <nav class="flex gap-2 mt-2 text-sm" aria-label="分页">
        {page > 1 && <a href={buildPageHref('/admin/media', Astro.url.searchParams, page - 1)} class="px-2 py-0.5 border rounded">上一页</a>}
        {page < totalPages && <a href={buildPageHref('/admin/media', Astro.url.searchParams, page + 1)} class="px-2 py-0.5 border rounded">下一页</a>}
      </nav>
    )}
    </>
  )}

  <script is:inline data-can-delete={canDelete}>
    const canDelete = document.currentScript.dataset.canDelete === 'true';
    const pb = window.__pb;
    const grid = document.getElementById('media-grid');
    const status = document.getElementById('upload-status');

    // Upload: pb.collection('media').create(FormData) — same shape as the
    // editor's uploadImages. No client-side wasm normalization here on
    // purpose: this page is the escape hatch when users want the original
    // bytes preserved (BMP/TIFF/etc.). The editor handles conversion.
    document.getElementById('upload-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = document.getElementById('upload-input');
      const files = Array.from(input.files || []);
      if (files.length === 0) return;
      if (!pb) return alert('未登录');
      status.textContent = `上传中 0/${files.length}…`;
      let ok = 0;
      for (const f of files) {
        try {
          const fd = new FormData();
          fd.append('file', f);
          fd.append('staticType', 'img');
          fd.append('storageType', 'local');
          const rec = await pb.collection('media').create(fd);
          prependMedia(rec);
          ok++;
        } catch (err) {
          console.error('[media] upload failed:', err);
        }
        status.textContent = `上传中 ${ok}/${files.length}…`;
      }
      status.textContent = `完成：${ok}/${files.length} 成功`;
      input.value = '';
    });

    function escapeAttr(s) {
      return String(s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
    }

    function prependMedia(m) {
      if (!grid) return;
      const fig = document.createElement('figure');
      fig.className = 'm-0 w-40 border border-[var(--color-border)] p-2';
      const imgUrl = `/api/files/media/${m.id}/${m.file}`;
      const safeFile = escapeAttr(m.file);
      const safeType = escapeAttr(`${m.storageType}/${m.fileType}`);
      fig.innerHTML = `
        ${m.staticType === 'img' ? `<img src="${imgUrl}" alt="${safeFile}" loading="lazy" class="w-full h-[120px] object-cover block" />` : ''}
        <figcaption class="text-xs mt-1 break-all">${safeFile}<br><small class="text-[var(--color-text-muted)]">[${safeType}]</small></figcaption>
        <div class="flex gap-2 mt-1">
          <button type="button" class="btn-copy text-xs" data-url="${imgUrl}">复制 URL</button>
          ${canDelete ? `<button type="button" class="btn-delete text-red-600 text-xs" data-id="${m.id}" data-name="${safeFile}">删除</button>` : ''}
        </div>
      `;
      bindRow(fig);
      grid.prepend(fig);
    }

    function bindRow(root) {
      const del = root.querySelector('button.btn-delete[data-id]');
      if (del) del.addEventListener('click', async () => {
        const id = del.dataset.id;
        const name = del.dataset.name;
        if (!id || !confirm(`确认删除媒体文件 ${name}？该操作不可撤销。`)) return;
        if (!pb) return alert('未登录');
        try {
          await pb.vanblog.media.delete(id);
          del.closest('figure')?.remove();
        } catch (err) {
          alert('删除失败: ' + err.message);
        }
      });
      const copy = root.querySelector('button.btn-copy');
      if (copy) copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(location.origin + copy.dataset.url);
          copy.textContent = '已复制';
          setTimeout(() => copy.textContent = '复制 URL', 1500);
        } catch {
          alert('复制失败：' + copy.dataset.url);
        }
      });
    }

    // Bind existing rows (initial render).
    document.querySelectorAll('#media-grid figure').forEach(bindRow);
  </script>
</AdminLayout>
