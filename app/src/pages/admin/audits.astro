---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import ErrorNotice from '../../components/ErrorNotice.astro';
import { requireAdmin, safe, getPage, buildPageHref } from '@vanblog/sdk';
import { fmtDateTime } from '@vanblog/sdk';
const pb = Astro.locals.pb;



const denied = !requireAdmin(pb);
if (denied) Astro.response.status = 403;

const PER_PAGE = 50;
const page = getPage(Astro.url.searchParams);
const action = (Astro.url.searchParams.get('action') || '').trim();
const resultQ = Astro.url.searchParams.get('result') || '';

const parts: string[] = [];
if (action) parts.push(`action ~ "${action.replace(/"/g, '\\"')}"`);
if (resultQ) parts.push(`result = "${resultQ}"`);
const filter = parts.join(' && ');

const { data: auditList } = denied ? { data: undefined } : await safe(
  () => pb.collection('audits').getList(page, PER_PAGE, {
    sort: '-created',
    expand: 'actor',
    filter: filter || undefined,
  }),
  'admin/audits'
);
const audits = auditList?.items ?? [];
const totalAudits = auditList?.totalItems ?? 0;
const totalPages = auditList?.totalPages ?? 1;

function expandName(a: any): string {
  const u = a?.expand?.actor;
  return u?.username || u?.email || a?.actor || '-';
}
---
<AdminLayout title="审计日志">
  <h1>审计日志</h1>
  <p><a href="/admin">← 返回</a></p>

  {denied ? (
    <ErrorNotice code="403" title="无权限访问" message="审计日志仅管理员可见。" />
  ) : (
    <>
    <form method="get" class="flex gap-2 flex-wrap items-center my-3 text-sm">
      <input name="action" value={action} placeholder="动作关键字 (如 auth.login)" class="px-1.5 py-0.5 w-56" />
      <select name="result" class="px-1.5 py-0.5">
        <option value="" selected={!resultQ}>全部结果</option>
        <option value="success" selected={resultQ === 'success'}>成功</option>
        <option value="failure" selected={resultQ === 'failure'}>失败</option>
      </select>
      <button type="submit">筛选</button>
      {(action || resultQ) && <a href="/admin/audits" class="text-[var(--text-muted)]">清除</a>}
    </form>

    {audits.length === 0 ? (
      <p>{(action || resultQ) ? '没有匹配的记录。' : '暂无审计记录。'}</p>
    ) : (
      <table class="w-full border-collapse text-xs">
        <thead>
          <tr class="text-left border-b border-[var(--border)]">
            <th>时间</th><th>用户</th><th>动作</th><th>目标</th><th>结果</th><th>IP</th><th>详情</th>
          </tr>
        </thead>
        <tbody>
          {audits.map(a => (
            <tr class="border-b border-[var(--border)] align-top">
              <td><small>{fmtDateTime(a.created)}</small></td>
              <td>{expandName(a)}</td>
              <td>{a.action}</td>
              <td class="break-all">{a.target}</td>
              <td>{a.result === 'failure' ? (
                <span class="text-red-600">失败</span>
              ) : <span class="text-green-600">成功</span>}</td>
              <td><small>{a.ip || '-'}</small></td>
              <td>
                {a.detail && (
                  <details>
                    <summary class="cursor-pointer">查看</summary>
                    <pre class="whitespace-pre-wrap text-[11px] bg-gray-50 p-1">{JSON.stringify(a.detail, null, 2)}</pre>
                  </details>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    <p class="text-xs text-[var(--text-muted)] mt-2">
      共 {totalAudits} 条 · 第 {page}/{totalPages} 页
    </p>

    {totalPages > 1 && (
      <nav class="flex gap-2 mt-2 text-sm" aria-label="分页">
        {page > 1 && <a href={buildPageHref('/admin/audits', Astro.url.searchParams, page - 1)} class="px-2 py-0.5 border rounded">上一页</a>}
        {page < totalPages && <a href={buildPageHref('/admin/audits', Astro.url.searchParams, page + 1)} class="px-2 py-0.5 border rounded">下一页</a>}
      </nav>
    )}
    </>
  )}
</AdminLayout>
