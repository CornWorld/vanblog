---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import ErrorNotice from '../../components/ErrorNotice.astro';
import ThemeCard from '../../components/admin/ThemeCard.astro';
import PaletteCard from '../../components/admin/PaletteCard.astro';
import { requireAdmin, safe } from '@vanblog/sdk';
import type { Site } from '@vanblog/sdk';
const pb = Astro.locals.pb;



const denied = !requireAdmin(pb);
if (denied) Astro.response.status = 403;

let site: Partial<Site> | null = null;
let tlsStatus: any = null;
if (!denied) {
  const r = await safe(
    () => pb.collection('site').getList<Site>(1, 1),
    'admin/site'
  );
  site = r.data?.items?.[0] ?? null;

  const tls = await safe(
    () => pb.vanblog.tls.status(),
    'admin/site/tls'
  );
  tlsStatus = tls.data;
}

// Banner-worthy states: maintenance mode or unreachable caddy.
const tlsWarning =
  tlsStatus && !tlsStatus.caddyReachable
    ? 'Caddy admin API 不可达，路由配置可能未生效。'
    : tlsStatus && tlsStatus.bootstrapMode
    ? `站点处于维护模式（bootstrap 配置生效中）${tlsStatus.bootstrapError ? '：' + tlsStatus.bootstrapError : ''}`
    : '';

const id = site?.id;
const field = (k: keyof Site): string => site?.[k]?.toString() ?? '';
const boolField = (k: keyof Site, def = false): boolean => {
  const v = site?.[k];
  return v === undefined || v === null ? def : !!v;
};

// 外观：服务端并行拉取主题 / 调色盘列表（卡片 SSR 直出，避免客户端闪烁）。
// GET /api/themes 返回 { themes: [{ name, label, ... }] }；palettes 走 SDK。
const [themesRes, palettesRes] = await Promise.all([
  safe(
    async () =>
      (await pb.send('/api/themes', { method: 'GET' })) as {
        themes?: Array<{ name: string; label?: string }>;
      },
    'admin/site/themes'
  ),
  safe(() => pb.vanblog.palettes.list(), 'admin/site/palettes'),
]);
const themes = themesRes.data?.themes ?? [];
const palettes = palettesRes.data ?? [];
const currentTheme = field('activeTheme') || 'vanblog';
const currentPalette = field('palette') || 'default';
---
<AdminLayout title="站点配置">
  <h1>站点配置</h1>
  <p><a href="/admin">← 返回</a></p>

  {tlsWarning && (
    <p class="text-sm bg-yellow-100 dark:bg-yellow-900 text-yellow-900 dark:text-yellow-100 border border-yellow-300 dark:border-yellow-700 rounded px-3 py-2 mb-3">
      ⚠ {tlsWarning}
    </p>
  )}

  {denied ? (
    <ErrorNotice code="403" title="无权限访问" message="站点配置仅管理员可编辑。" />
  ) : !site ? (
    <p>未找到 site 记录（请确认数据库已初始化）。</p>
  ) : (
    <form id="site-form" class="flex flex-col gap-4 max-w-3xl">
      <fieldset class="grid grid-cols-[160px_1fr] gap-2 items-center border border-[var(--border)] p-4">
        <legend>基本信息</legend>
        <label>站点名</label><input name="siteName" value={field('siteName')} class="px-1.5 py-0.5" />
        <label>站点描述</label><input name="siteDesc" value={field('siteDesc')} class="px-1.5 py-0.5" />
        <label>作者</label><input name="author" value={field('author')} class="px-1.5 py-0.5" />
        <label>BaseURL</label><input name="baseUrl" value={field('baseUrl')} placeholder="https://example.com" class="px-1.5 py-0.5" />
        <label>Favicon URL</label><input name="favicon" value={field('favicon')} class="px-1.5 py-0.5" />
        <label>版权</label><input name="copyrightAgreement" value={field('copyrightAgreement')} class="px-1.5 py-0.5" />
      </fieldset>

      <fieldset class="grid grid-cols-[160px_1fr] gap-2 items-center border border-[var(--border)] p-4">
        <legend>外观</legend>

        <label>活动主题</label>
        <div class="col-span-2 flex flex-col gap-2">
          <input type="hidden" name="activeTheme" value={currentTheme} />
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
            {themes.length === 0 ? (
              <p class="text-sm text-[var(--text-muted)]">未加载到主题列表（后端 /api/themes 不可达？）</p>
            ) : (
              themes.map((t) => (
                <ThemeCard name={t.name} label={t.label} active={t.name === currentTheme} />
              ))
            )}
          </div>
          <small class="text-[var(--text-muted)]">
            {import.meta.env.DEV ? '保存后即时生效' : '保存后需重建容器/重新加载主题'}
          </small>
          <div class="flex items-center gap-2">
            <button type="button" id="theme-reload-btn" class="px-3 py-1 border border-[var(--border)] rounded w-fit">重新加载主题</button>
            <span id="theme-reload-status" class="text-sm text-[var(--text-muted)]"></span>
          </div>
          <small class="text-[var(--text-muted)]">通过 ssh / 挂载方式放入新主题后，点「重新加载主题」让它的静态资源生效（无需重启容器）</small>
        </div>

        <details class="col-span-2 mt-2">
          <summary class="cursor-pointer text-sm text-[var(--text-muted)]">高级选项</summary>
          <div class="grid grid-cols-[160px_1fr] gap-2 items-center mt-2">

            <label>调色盘</label>
            <div class="flex flex-col gap-2">
              <input type="hidden" name="palette" value={currentPalette} />
              <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
                {palettes.length === 0 ? (
                  <p class="text-sm text-[var(--text-muted)]">未加载到调色盘列表（后端 /api/palettes 不可达？）</p>
                ) : (
                  palettes.map((p) => (
                    <PaletteCard name={p.name} label={p.label} type={p.type} active={p.name === currentPalette} />
                  ))
                )}
              </div>
              <small class="text-[var(--text-muted)]">点击调色盘卡片即时预览（访客偏好 localStorage）；保存后写入站点默认调色盘</small>
            </div>

            <label>切换主题时调色盘</label>
            <select name="paletteMigrationMode">
              <option value="keep" selected={field('paletteMigrationMode') === 'keep'}>保持当前（默认）</option>
              <option value="silent" selected={field('paletteMigrationMode') === 'silent'}>自动迁移到推荐值</option>
              <option value="prompt" selected={field('paletteMigrationMode') === 'prompt'}>每次询问</option>
            </select>

          </div>
        </details>

        <details class="col-span-2 mt-2">
          <summary class="cursor-pointer text-sm text-[var(--text-muted)]">预览站点</summary>
          <p class="text-xs text-[var(--text-muted)] mb-2">实时预览站点首页。点击调色盘卡片后，预览 iframe 会即时反映所选调色盘（同源访客调色盘机制）。</p>
          <iframe id="site-preview-frame" src="/" title="站点预览" class="w-full h-[600px] bg-white border border-[var(--border)] rounded"></iframe>
        </details>
      </fieldset>

      <fieldset class="grid grid-cols-[160px_1fr] gap-2 items-center border border-[var(--border)] p-4">
        <legend>评论</legend>
        <label>评论 provider</label>
        <select name="commentsProvider" id="commentsProvider">
          {['disabled', 'waline', 'giscus', 'artalk', 'external'].map(t => (
            <option value={t} selected={field('commentsProvider') === t}>{t}</option>
          ))}
        </select>

        <!-- Provider-specific config fields (shown/hidden by JS) -->
        <div id="comments-config-waline" class="comments-config-group col-span-2 grid grid-cols-subgrid gap-2 items-center" style="display:none">
          <label>Waline Server URL</label>
          <input name="waline_serverURL" placeholder="https://comment.example.com" class="px-1.5 py-0.5" />
        </div>
        <div id="comments-config-artalk" class="comments-config-group col-span-2 grid grid-cols-subgrid gap-2 items-center" style="display:none">
          <label>Artalk Server</label>
          <input name="artalk_server" placeholder="https://comment.example.com" class="px-1.5 py-0.5" />
          <label>Artalk Site 名</label>
          <input name="artalk_site" placeholder="VanBlog" class="px-1.5 py-0.5" />
        </div>
        <div id="comments-config-giscus" class="comments-config-group col-span-2 grid grid-cols-subgrid gap-2 items-center" style="display:none">
          <label>Repo</label>
          <input name="giscus_repo" placeholder="user/repo" class="px-1.5 py-0.5" />
          <label>Repo ID</label>
          <input name="giscus_repoId" class="px-1.5 py-0.5" />
          <label>Category</label>
          <input name="giscus_category" placeholder="Announcements" class="px-1.5 py-0.5" />
          <label>Category ID</label>
          <input name="giscus_categoryId" class="px-1.5 py-0.5" />
          <label>Theme</label>
          <select name="giscus_theme">
            {['preferred_color_scheme', 'light', 'dark', 'light_tritanopia', 'dark_tritanopia'].map(t => (
              <option value={t}>{t}</option>
            ))}
          </select>
        </div>
        <div id="comments-config-external" class="comments-config-group col-span-2 grid grid-cols-subgrid gap-2" style="display:none">
          <label>自定义脚本 / HTML</label>
          <textarea name="external_script" rows="4" class="px-1.5 py-0.5 font-mono text-sm" placeholder="&lt;script src=&quot;...&quot;&gt;&lt;/script&gt;"></textarea>
        </div>
      </fieldset>

      <fieldset class="flex flex-col gap-2 border border-[var(--border)] p-4">
        <legend>关于页 / 自定义注入</legend>
        <label>关于页内容（Markdown）</label>
        <textarea name="aboutContent" rows="6" class="px-1.5 py-0.5 font-mono">{field('aboutContent')}</textarea>
        <label>customHead（HTML，raw 注入 &lt;head&gt;）</label>
        <textarea name="customHead" rows="3" class="px-1.5 py-0.5 font-mono">{field('customHead')}</textarea>
        <label>customScript（JS）</label>
        <textarea name="customScript" rows="3" class="px-1.5 py-0.5 font-mono">{field('customScript')}</textarea>
      </fieldset>

      <fieldset class="grid grid-cols-[160px_1fr] gap-2 items-center border border-[var(--border)] p-4">
        <legend>修订</legend>
        <label>启用修订</label>
        <label><input type="checkbox" name="revisionsEnabled" checked={boolField('revisionsEnabled', true)} /> 启用</label>
        <label>保留数量</label>
        <input type="number" name="revisionsRetention" value={site?.revisionsRetention ?? 50} class="px-1.5 py-0.5 w-[120px]" />
      </fieldset>

      <div class="flex gap-4 items-center">
        <button type="submit">保存</button>
        <small class="text-[var(--text-muted)]">仅保存上方字段；JSON 数组（nav/links/socials 等）请用 API 编辑</small>
      </div>
    </form>
  )}

  <script is:inline type="application/json" id="site-data" set:html={JSON.stringify({ siteId: id, commentsConfig: site?.commentsConfig || {} }).replace(/<\//g, '<\\/')} />
  <script is:inline type="application/json" id="theme-preview-data" set:html={JSON.stringify({ sitePalette: field('palette'), palettes }).replace(/<\//g, '<\\/')} />
  <script is:inline>
    const { siteId, commentsConfig: commentsConfigJson } = JSON.parse(document.getElementById('site-data').textContent);
    const pb = self.vanblog.pb;
    if (siteId) {
      // ── Show/hide provider-specific config panels ──
      const providerSelect = document.getElementById('commentsProvider');
      const panels = {
        waline: document.getElementById('comments-config-waline'),
        artalk: document.getElementById('comments-config-artalk'),
        giscus: document.getElementById('comments-config-giscus'),
        external: document.getElementById('comments-config-external'),
      };
      function showPanel(provider) {
        Object.values(panels).forEach((p) => { if (p) p.style.display = 'none'; });
        const panel = panels[provider];
        if (panel) panel.style.display = '';
      }
      if (providerSelect) {
        providerSelect.addEventListener('change', () => showPanel(providerSelect.value));
        showPanel(providerSelect.value);
      }

      // ── Pre-fill from existing commentsConfig ──
      try {
        const existingConfig = commentsConfigJson;
        if (existingConfig.serverURL) {
          const w = document.querySelector('[name="waline_serverURL"]');
          if (w) w.value = existingConfig.serverURL;
        }
        if (existingConfig.server) {
          const s = document.querySelector('[name="artalk_server"]'); if (s) s.value = existingConfig.server;
          const n = document.querySelector('[name="artalk_site"]'); if (n) n.value = existingConfig.site || '';
        }
        if (existingConfig.repo) {
          document.querySelector('[name="giscus_repo"]')?.setAttribute('value', existingConfig.repo);
          document.querySelector('[name="giscus_repoId"]')?.setAttribute('value', existingConfig.repoId || '');
          document.querySelector('[name="giscus_category"]')?.setAttribute('value', existingConfig.category || '');
          document.querySelector('[name="giscus_categoryId"]')?.setAttribute('value', existingConfig.categoryId || '');
          const ts = document.querySelector('[name="giscus_theme"]');
          if (ts && existingConfig.theme) ts.value = existingConfig.theme;
        }
        if (existingConfig.customScript) {
          const ta = document.querySelector('[name="external_script"]');
          if (ta) ta.textContent = existingConfig.customScript;
        }
      } catch (_) {}

      // ── Submit ──
      document.getElementById('site-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const provider = fd.get('commentsProvider');

        // Build commentsConfig from visible fields
        let commentsConfig = {};
        if (provider === 'waline') {
          commentsConfig = {
            serverURL: fd.get('waline_serverURL') || '',
          };
        } else if (provider === 'artalk') {
          commentsConfig = {
            server: fd.get('artalk_server') || '',
            site: fd.get('artalk_site') || 'VanBlog',
          };
        } else if (provider === 'giscus') {
          commentsConfig = {
            repo: fd.get('giscus_repo') || '',
            repoId: fd.get('giscus_repoId') || '',
            category: fd.get('giscus_category') || '',
            categoryId: fd.get('giscus_categoryId') || '',
            theme: fd.get('giscus_theme') || 'preferred_color_scheme',
          };
        } else if (provider === 'external') {
          commentsConfig = {
            customScript: fd.get('external_script') || '',
          };
        }

        const data = {
          siteName: fd.get('siteName'),
          siteDesc: fd.get('siteDesc'),
          author: fd.get('author'),
          baseUrl: fd.get('baseUrl'),
          favicon: fd.get('favicon'),
          copyrightAgreement: fd.get('copyrightAgreement'),
          palette: fd.get('palette'),
          activeTheme: fd.get('activeTheme'),
          paletteMigrationMode: fd.get('paletteMigrationMode'),
          commentsProvider: provider,
          commentsConfig: commentsConfig,
          aboutContent: fd.get('aboutContent'),
          customHead: fd.get('customHead'),
          customScript: fd.get('customScript'),
          revisionsEnabled: fd.get('revisionsEnabled') === 'on',
          revisionsRetention: Number(fd.get('revisionsRetention') || 50),
          aboutUpdatedAt: new Date().toISOString().slice(0, 10),
        };
        try {
          await pb.collection('site').update(siteId, data);
          alert('已保存');
        } catch (err) { alert('保存失败: ' + err.message); }
      });

      // ── 重新加载主题：放入新主题后重扫 Caddy file_server 路由 ──
      const reloadBtn = document.getElementById('theme-reload-btn');
      const reloadStatus = document.getElementById('theme-reload-status');
      if (reloadBtn) {
        reloadBtn.addEventListener('click', async () => {
          reloadBtn.disabled = true;
          if (reloadStatus) reloadStatus.textContent = '重新加载中…';
          try {
            const res = await pb.vanblog.themes.reload();
            if (res.error) {
              if (reloadStatus) reloadStatus.textContent = '加载失败：' + res.error;
            } else {
              if (reloadStatus) reloadStatus.textContent = '已重新加载 ✓';
            }
          } catch (err) {
            if (reloadStatus) reloadStatus.textContent = '加载失败：' + (err.message || err);
          } finally {
            reloadBtn.disabled = false;
          }
        });
      }
    }
  </script>

  <script>
    import { applyPalette } from '@vanblog/sdk/browser';

    // ── 外观卡片交互：主题 / 调色盘选择 + 即时预览 ──
    function wireAppearanceCards() {
      // 调色盘 / 站点默认数据（SSR 注入），供 applyPalette 判定明暗与站点默认调色盘
      const previewEl = document.getElementById('theme-preview-data');
      let sitePalette: string | null = null;
      let palettes: Array<{ name: string; type?: 'dark' | 'light' }> = [];
      if (previewEl) {
        try {
          const parsed = JSON.parse(previewEl.textContent || '{}');
          sitePalette = parsed.sitePalette || null;
          palettes = parsed.palettes ?? [];
        } catch {
          /* 解析失败按空处理 */
        }
      }

      function setCardActive(selector: string, name: string) {
        document.querySelectorAll<HTMLElement>(selector).forEach((card) => {
          const on = card.dataset.name === name;
          card.dataset.active = on ? 'true' : 'false';
          card.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      }

      // 主题卡片：仅标记选中（activeTheme 是站点级字段，保存后生效）
      document.querySelectorAll<HTMLElement>('[data-theme-card]').forEach((card) => {
        card.addEventListener('click', () => {
          const name = card.dataset.name || '';
          const input = document.querySelector<HTMLInputElement>('input[name="activeTheme"]');
          if (input) input.value = name;
          setCardActive('[data-theme-card]', name);
        });
      });

      // 调色盘卡片：标记选中 + 即时预览（SDK applyPalette 写 localStorage + 换 palette.css link）
      const previewFrame = document.getElementById('site-preview-frame') as HTMLIFrameElement | null;
      document.querySelectorAll<HTMLElement>('[data-palette-card]').forEach((card) => {
        card.addEventListener('click', () => {
          const name = card.dataset.name || '';
          const input = document.querySelector<HTMLInputElement>('input[name="palette"]');
          if (input) input.value = name;
          setCardActive('[data-palette-card]', name);
          try {
            applyPalette(name, { sitePalette, palettes });
          } catch {
            /* 预览失败忽略 */
          }
          // 同源 iframe 共享 localStorage：刷新预览 iframe 让其即时反映所选调色盘
          if (previewFrame?.contentWindow) {
            try {
              previewFrame.contentWindow.location.reload();
            } catch {
              /* ignore */
            }
          }
        });
      });

      // 轻量 swatch 加载：逐个 palette fetch palette.css，解析 6 个 --color-* 变量（失败保持占位色板）
      document.querySelectorAll<HTMLElement>('[data-palette-card]').forEach((card) => {
        const name = card.dataset.name || '';
        const type = card.dataset.type;
        const row = card.querySelector<HTMLElement>('[data-palette-swatches]');
        if (!row || !name) return;
        fetch(`/api/palette.css?name=${encodeURIComponent(name)}`)
          .then((r) => (r.ok ? r.text() : ''))
          .then((css) => {
            if (!css) return;
            const keys = ['bg', 'surface', 'text', 'text-muted', 'border', 'accent'];
            const suffix = type === 'dark' ? '-dark' : '';
            const colors = keys.map((k) => {
              const m = css.match(new RegExp(`--color-${k}${suffix}\\s*:\\s*([^;]+);`));
              return m ? m[1].trim() : null;
            });
            if (colors.every((c) => !c)) return;
            row.innerHTML = colors
              .map((c) => `<span class="flex-1 h-6" style="background-color:${c || 'transparent'}"></span>`)
              .join('');
          })
          .catch(() => {});
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', wireAppearanceCards);
    } else {
      wireAppearanceCards();
    }
  </script>
</AdminLayout>
