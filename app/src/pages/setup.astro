---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { createVanblogClient } from '@vanblog/sdk';

Astro.cache.set(false);

// Pass through ?back= so we can route there after a successful setup.
const back = Astro.url.searchParams.get('back') || '/admin';

// SSR-side check: if an admin already exists, /setup is closed.
// We don't strictly require this (the API would refuse), but rendering
// a "this page is closed" message is better UX than letting the operator
// fill the form and get a 409 on submit.
let alreadySetup = false;
try {
  const probe = createVanblogClient({ url: Astro.locals.pbUrl });
  const status = await probe.vanblog.setup.status();
  alreadySetup = !status.bootstrap;
} catch (err) {
  // If the status call fails (pb down, fresh install with no DB yet),
  // show the form anyway — let the operator try.
  console.warn("[setup] setup status probe failed:", err);
}
if (alreadySetup) {
  return Astro.redirect('/login');
}
---

<BaseLayout title="初始设置">
  <script>
    import { initClient } from '@vanblog/sdk/browser';
    initClient();
  </script>
  <h1>初始设置</h1>

  <div class="bg-yellow-50 dark:bg-yellow-950 border border-yellow-300 dark:border-yellow-700 text-yellow-900 dark:text-yellow-100 rounded px-4 py-3 mb-4 text-sm max-w-xl">
    <p class="font-semibold mb-1">首次启动：尚未创建管理员账户。</p>
    <p>填写下方表单创建第一个管理员。在此之前，<code>/admin</code> 无法登录，所有后台功能不可用。</p>
    <p class="mt-2 text-xs opacity-80">提示：完成此步骤后，本页面将自动关闭。后续管理员需要由已登录的管理员在「用户管理」中创建。</p>
  </div>

  <form id="setup-form" class="flex flex-col gap-2 max-w-sm">
    <label class="flex flex-col">
      用户名
      <input name="username" type="text" required autocomplete="username" minlength="2"
             class="px-1.5 py-0.5" placeholder="admin" />
    </label>
    <label class="flex flex-col">
      邮箱
      <input name="email" type="email" required autocomplete="email"
             class="px-1.5 py-0.5" placeholder="admin@example.com" />
    </label>
    <label class="flex flex-col">
      密码（至少 8 位）
      <input name="password" type="password" required autocomplete="new-password" minlength="8"
             class="px-1.5 py-0.5" />
    </label>
    <label class="flex flex-col">
      确认密码
      <input name="passwordConfirm" type="password" required autocomplete="new-password" minlength="8"
             class="px-1.5 py-0.5" />
    </label>
    <fieldset class="border p-3 mt-3">
      <legend>评论系统（可选）</legend>
      <label class="flex items-center gap-2"><input name="commentsProvider" type="radio" value="disabled" checked /> 不启用 Artalk</label>
      <label class="flex items-center gap-2"><input name="commentsProvider" type="radio" value="artalk" /> 启用内置 Artalk</label>
      <div id="artalk-setup" class="hidden flex flex-col gap-2 mt-2">
        <input name="artalk_site" type="text" value="VanBlog" placeholder="Artalk Site 名" />
        <input name="artalk_email" type="email" autocomplete="email" placeholder="Artalk 管理员邮箱" />
        <input name="artalk_password" type="password" autocomplete="new-password" minlength="8" placeholder="Artalk 管理员密码（至少 8 位）" />
        <input name="artalk_password_confirm" type="password" autocomplete="new-password" minlength="8" placeholder="确认 Artalk 管理员密码" />
      </div>
    </fieldset>
    <input type="hidden" name="back" value={back} />
    <button type="submit" class="self-start px-3 py-1">创建管理员</button>
    <p id="setup-error" class="text-red-600 text-sm hidden"></p>
    <p id="setup-status" class="text-[var(--text-muted)] text-sm"></p>
  </form>

  <script is:inline data-back={back}>
    const back = document.currentScript.dataset.back;
    const form = document.getElementById('setup-form');
    const errEl = document.getElementById('setup-error');
    const statusEl = document.getElementById('setup-status');
    const artalkSetup = document.getElementById('artalk-setup');
    const providerInputs = form.querySelectorAll('[name="commentsProvider"]');
    const setupStatus = self.vanblog?.pb?.vanblog?.setup;
    setupStatus?.status?.().then((status) => {
      const artalk = form.querySelector('[value="artalk"]');
      if (!status.capabilities?.artalk && artalk) {
        artalk.disabled = true;
        artalk.parentElement.title = '当前镜像不包含 Artalk，请使用 prod-artalk 镜像';
      }
    }).catch(() => {});
    providerInputs.forEach((input) => input.addEventListener('change', () => {
      artalkSetup.classList.toggle('hidden', input.checked && input.value === 'artalk');
    }));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.classList.add('hidden');
      statusEl.textContent = '创建中…';

      const fd = new FormData(form);
      const pb = self.vanblog.pb;
      if (!pb) {
        errEl.textContent = '客户端未初始化，请刷新';
        errEl.classList.remove('hidden');
        statusEl.textContent = '';
        return;
      }

      let r;
      try {
        r = await pb.vanblog.setup.complete({
          username: fd.get('username'),
          email: fd.get('email'),
          password: fd.get('password'),
          passwordConfirm: fd.get('passwordConfirm'),
          comments: {
            provider: fd.get('commentsProvider') || 'disabled',
            artalkSite: fd.get('artalk_site') || 'VanBlog',
            artalkEmail: fd.get('artalk_email') || '',
            artalkPassword: fd.get('artalk_password') || '',
            artalkPasswordConfirm: fd.get('artalk_password_confirm') || '',
          },
        });
        if (r.ok) {
          statusEl.textContent = '✓ 管理员创建成功，正在跳转登录…';
          // We don't auto-login here because the setup endpoint doesn't
          // return a token (it's the bootstrap authority). The operator
          // logs in normally — by then the user exists.
          location.href = '/login?back=' + encodeURIComponent(back);
        } else {
          // The setup endpoint returns 200 with ok=false only on certain
          // paths; most errors come back via the catch branch below.
          throw new Error(r.error || '未知错误');
        }
      } catch (err) {
        // 4xx (validation) and 409 (already exists) both land here.
        // pb SDK throws on non-2xx with the server's error body.
        const msg = err?.response?.message || err?.message || '请求失败';
        const traceId = err?.response?.headers?.get?.('X-Trace-Id')
          || r?.traceId || '';
        errEl.textContent = traceId
          ? `创建失败：${msg}（追踪号：${traceId}）`
          : `创建失败：${msg}`;
        errEl.classList.remove('hidden');
        statusEl.textContent = '';
      }
    });
  </script>
</BaseLayout>
