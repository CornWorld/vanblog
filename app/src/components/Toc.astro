---
export interface Props {
  html: string;
}

const { html } = Astro.props;

// SSR: extract h2/h3 headings from rendered HTML
interface TocItem {
  id: string;
  tag: 'h2' | 'h3';
  text: string;
  level: number;
}

function extractHeadings(html: string): TocItem[] {
  const items: TocItem[] = [];
  const h2Re = /<h2[^>]*id="([^"]+)"[^>]*>([\s\S]*?)<\/h2>/gi;
  const h3Re = /<h3[^>]*id="([^"]+)"[^>]*>([\s\S]*?)<\/h3>/gi;
  let match: RegExpExecArray | null;

  while ((match = h2Re.exec(html)) !== null) {
    const text = match[2].replace(/<[^>]*>/g, '').trim();
    if (text) { items.push({ id: match[1], tag: 'h2', text, level: 1 }); }
  }

  while ((match = h3Re.exec(html)) !== null) {
    const text = match[2].replace(/<[^>]*>/g, '').trim();
    if (text) { items.push({ id: match[1], tag: 'h3', text, level: 2 }); }
  }

  return items;
}

const headings = extractHeadings(html);
---

{headings.length > 0 && (
  <aside class="toc-wrapper">
    <details class="toc-details" open>
      <summary class="toc-summary">
        <span class="text-sm font-semibold text-[var(--text-muted)]">目录</span>
        <span class="toc-toggle text-xs text-[var(--text-muted)]">折叠</span>
      </summary>
      <nav class="toc-nav mt-2">
        <ul class="toc-list">
          {headings.map((h) => (
            <li class={h.level === 1 ? 'toc-item--h2' : 'toc-item--h3'}>
              <a href={`#${h.id}`} class="toc-link">{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </aside>
)}

<script is:inline>
  (() => {
    // Toggle collapse/expand label
    const details = document.querySelector('.toc-details');
    const toggleSpan = document.querySelector<HTMLSpanElement>('.toc-toggle');
    if (details && toggleSpan) {
      details.addEventListener('toggle', () => {
        toggleSpan.textContent = details.open ? '折叠' : '展开';
      });
    }

    // IntersectionObserver: highlight visible heading
    const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (links.length === 0) return;

    const headings: Element[] = [];
    links.forEach((link) => {
      const id = link.getAttribute('href')?.slice(1);
      if (id) { const el = document.getElementById(id); if (el) headings.push(el); }
    });

    if (headings.length === 0) return;

    let activeIdx = -1;

    function updateActive() {
      let idx = -1;
      const scrollY = window.scrollY + 100;
      for (let i = 0; i < headings.length; i++) {
        if (headings[i].getBoundingClientRect().top + window.scrollY <= scrollY) { idx = i; }
      }
      if (idx !== activeIdx) {
        links.forEach((l) => l.classList.remove('toc-link--active'));
        if (idx >= 0) {
          links[idx].classList.add('toc-link--active');
          links[idx].scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
        activeIdx = idx;
      }
    }

    window.addEventListener('scroll', updateActive, { passive: true });
    updateActive();
  })();
</script>

<style>
  .toc-wrapper {
    position: sticky;
    top: 5rem;
  }
  .toc-summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
    list-style: none;
  }
  .toc-summary::-webkit-details-marker {
    display: none;
  }
  .toc-nav {
    max-height: 70vh;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .toc-nav::-webkit-scrollbar {
    width: 4px;
  }
  .toc-nav::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 2px;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .toc-list::before {
    content: '';
    position: absolute;
    left: 0.75rem;
    top: 0.375rem;
    bottom: 0.375rem;
    width: 1px;
    background: var(--border);
    border-radius: 1px;
  }

  .toc-item--h2,
  .toc-item--h3 {
    position: relative;
    padding-left: 1.75rem;
  }

  .toc-link {
    display: block;
    padding: 0.375rem 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: 0.375rem;
    border-left: 2px solid transparent;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }
  .toc-link:hover {
    color: var(--accent);
    background: oklch(from var(--accent) l c h / 0.08);
  }

  .toc-item--h3 {
    padding-left: 2.5rem;
  }
  .toc-item--h3 .toc-link {
    font-size: 0.8125rem;
  }

  .toc-link--active {
    color: var(--text);
    font-weight: 500;
    background: oklch(from var(--accent) l c h / 0.10);
    border-left-color: var(--accent);
  }
  .toc-link--active:hover {
    color: var(--text);
    background: oklch(from var(--accent) l c h / 0.14);
    border-left-color: var(--accent);
  }
</style>
