---
import type { Site } from '@vanblog/sdk';

export interface Props {
  site: Site | null;
}

const { site } = Astro.props;
const name = site?.siteName || 'Vanblog';
---
<footer class="border-t border-[var(--border)] py-8 text-sm text-[var(--text-muted)] bg-[var(--surface-soft)]">
  <div class="container-page">
    <div class="flex flex-col sm:flex-row justify-between gap-4 mb-4">
      <div>
        <p class="font-semibold text-[var(--text)] mb-1">{name}</p>
        {site?.siteDesc && <p class="text-xs">{site.siteDesc}</p>}
      </div>
      {(site?.socials?.length || site?.links?.length) && (
        <div class="flex flex-wrap gap-3">
          {(site.socials ?? []).map((s) => (
            <a href={s.url} target="_blank" class="hover:text-[var(--accent)]">{s.name || s.type}</a>
          ))}
          {(site.links ?? []).map((l) => (
            <a href={l.url} target="_blank" class="hover:text-[var(--accent)]">{l.name}</a>
          ))}
        </div>
      )}
    </div>
    <div class="flex flex-col sm:flex-row justify-between gap-4 pt-4 border-t border-[var(--border)]">
      <p>&copy; {new Date().getFullYear()} {name}. Powered by <a href="https://github.com/CornWorld/vanblog" class="underline hover:text-[var(--accent)]">Vanblog</a>.</p>
      <p class="flex gap-4">
        <a href="/api/feed.xml" class="hover:text-[var(--text)] no-underline">RSS</a>
        <a href="/api/atom.xml" class="hover:text-[var(--text)] no-underline">Atom</a>
        <a href="/api/sitemap.xml" class="hover:text-[var(--text)] no-underline">Sitemap</a>
      </p>
    </div>
    {site?.beianNumber && (
      <p class="mt-2 text-xs">
        <a href={site.beianUrl || '#'} class="hover:text-[var(--text)]">{site.beianNumber}</a>
      </p>
    )}
  </div>
</footer>
