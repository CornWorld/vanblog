---
import type { Site } from '@vanblog/sdk';

export interface Props {
  site: Site | null;
  isLoggedIn: boolean;
  path: string;
}

const { site, isLoggedIn, path } = Astro.props;
const siteName = site?.siteName || 'Vanblog';
---
<header id="nav" class="sticky top-0 z-50 border-b border-[var(--border)] bg-[var(--surface)]/95 backdrop-blur-md transition-transform duration-200">
  <div class="container-page flex items-center justify-between h-14 gap-4">
    <a href="/" class="font-bold text-lg text-[var(--text)] no-underline hover:text-[var(--accent)] flex items-center gap-2">
      {site?.logo && <img src={site.logo} alt="" class="h-7 w-auto" />}
      <span>{siteName}</span>
    </a>
    <nav class="flex items-center gap-1 sm:gap-2 text-sm">
      <a href="/" class="nav-link">首页</a>
      <a href="/archive" class="nav-link">归档</a>
      <a href="/timeline" class="nav-link">时间轴</a>
      <a href="/tags" class="nav-link hidden sm:inline">标签</a>
      <a href="/categories" class="nav-link hidden sm:inline">分类</a>
      <a href="/search" class="nav-link">🔍</a>
      <a href="/about" class="nav-link hidden sm:inline">关于</a>
      {isLoggedIn ? <a href="/admin" class="nav-link">管理</a> : <a href="/login" class="nav-link">登录</a>}
      {isLoggedIn && <button id="logout-btn" class="nav-link">退出</button>}
      <button id="theme-toggle" class="nav-link text-lg" aria-label="切换主题">
        <span class="dark:hidden">🌙</span>
        <span class="hidden dark:inline">☀️</span>
      </button>
    </nav>
  </div>
</header>

<script>
  // Headroom — hide on scroll down, show on scroll up
  const nav = document.getElementById('nav');
  let lastScroll = 0;
  if (nav) {
    window.addEventListener('scroll', () => {
      const cur = window.scrollY;
      if (Math.abs(cur - lastScroll) < 8) return;
      nav.style.transform = cur > lastScroll && cur > 56 ? 'translateY(-100%)' : '';
      lastScroll = cur;
    }, { passive: true });
  }

  // Theme toggle
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const isDark = html.classList.toggle('dark');
    localStorage.setItem('vanblog-theme', isDark ? 'dark' : 'light');
    html.dispatchEvent(new CustomEvent('darkmodechange', { detail: { dark: isDark } }));
  });

  // Logout
  document.getElementById('logout-btn')?.addEventListener('click', async () => {
    const { logout } = await import('@vanblog/sdk/browser');
    logout('/');
  });

  // Ctrl+K / Cmd+K → search
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      window.location.href = '/search';
    }
  });
</script>
