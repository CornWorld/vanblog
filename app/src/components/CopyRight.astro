---
import type { Post } from '@vanblog/sdk';

export interface Props {
  post: Post;
  site: { siteName?: string; baseUrl?: string } | null;
}

const { post, site } = Astro.props;
const name = site?.siteName || 'Vanblog';
const url = site?.baseUrl
  ? `${site.baseUrl.replace(/\/$/, '')}/posts/${post.id}`
  : `/posts/${post.id}`;
---
<div class="mt-10 p-4 rounded-lg border border-[var(--border)] bg-[var(--surface)] text-sm text-[var(--text-muted)] space-y-1">
  <p>
    <strong class="text-[var(--text)]">文章标题：</strong>
    <a href={url} class="hover:text-[var(--accent)]">{post.title}</a>
  </p>
  <p>
    <strong class="text-[var(--text)]">文章作者：</strong>
    {site?.author || name}
  </p>
  {post.tags?.length > 0 && (
    <p>
      <strong class="text-[var(--text)]">文章标签：</strong>
      {post.tags.join(', ')}
    </p>
  )}
  <p>
    <strong class="text-[var(--text)]">发布时间：</strong>
    {new Date((post.created || '').replace(' ', 'T')).toLocaleDateString('zh-CN')}
  </p>
  {post.updated && (
    <p>
      <strong class="text-[var(--text)]">最后更新：</strong>
      {new Date((post.updated || '').replace(' ', 'T')).toLocaleDateString('zh-CN')}
    </p>
  )}
  <hr class="my-2 border-[var(--border)]" />
  {(site?.ccLicense || site?.copyrightNotice) ? (
    <>
      {site.ccLicense && <p><strong class="text-[var(--text)]">版权协议：</strong>{site.ccLicense}</p>}
      {site.copyrightNotice && <p>{site.copyrightNotice}</p>}
    </>
  ) : (
    <p>版权声明：本文采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" class="hover:text-[var(--accent)]" target="_blank">CC BY-NC-SA 4.0</a> 许可协议。转载请注明出处。</p>
  )}
</div>
