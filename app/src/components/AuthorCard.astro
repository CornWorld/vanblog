---
import type { Site } from '@vanblog/sdk';

export interface Props {
  site: Site | null;
}

const { site } = Astro.props;
const name = site?.author || site?.siteName || 'Vanblog';
---
{site?.author && (
  <div class="card-post flex items-center gap-4 p-4 mb-6">
    {site.avatar && (
      <img src={site.avatar} alt={name} class="w-12 h-12 rounded-full object-cover" />
    )}
    <div class="min-w-0">
      <p class="font-semibold text-[var(--text)]">{name}</p>
      {site.siteDesc && <p class="text-sm text-[var(--text-muted)]">{site.siteDesc}</p>}
    </div>
  </div>
)}
