---
import type { Site } from '@vanblog/sdk';

export interface Props {
  site: Site | null;
}

const { site } = Astro.props;
const hasReward = site?.payWechat || site?.payAliPay;
---

{hasReward && (
  <div class="my-8 pt-6 border-t border-[var(--border)] text-center">
    <p class="text-sm text-[var(--text-muted)] mb-4">
      如果觉得文章对你有帮助，欢迎请我喝杯咖啡 ☕️
    </p>
    <div class="flex justify-center gap-6">
      {site?.payWechat && (
        <div class="text-center">
          <img
            src={site.payWechat}
            alt="微信赞赏"
            class="w-32 h-32 rounded-lg border border-[var(--border)]"
          />
          <p class="text-xs text-[var(--text-muted)] mt-1">微信</p>
        </div>
      )}
      {site?.payAliPay && (
        <div class="text-center">
          <img
            src={site.payAliPay}
            alt="支付宝赞赏"
            class="w-32 h-32 rounded-lg border border-[var(--border)]"
          />
          <p class="text-xs text-[var(--text-muted)] mt-1">支付宝</p>
        </div>
      )}
    </div>
  </div>
)}
