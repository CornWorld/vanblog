---
import type { PostExpand } from '@vanblog/sdk';
import { stripMarkdown, fmtDate } from '@vanblog/sdk';

export interface Props {
  post: PostExpand;
  showExcerpt?: boolean;
}

const { post, showExcerpt = true } = Astro.props;
const summary = stripMarkdown(post.content || '', 200);
---
<article class="card-post">
  <h2 class="text-xl mb-2 font-bold leading-tight">
    <a href={`/posts/${post.id}`} class="text-[var(--text)] hover:text-[var(--accent)] no-underline">
      {post.title}
    </a>
  </h2>
  <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--text-muted)] mb-3">
    <time datetime={post.created}>{fmtDate(post.created)}</time>
    {post.expand?.category && (
      <a href={`/categories/${post.category}`} class="text-[var(--accent)] hover:underline">
        {post.expand.category.name}
      </a>
    )}
    {post.expand?.tags?.length > 0 && (
      <span class="flex flex-wrap gap-1">
        {post.expand.tags.map((tag) => (
          <a href={`/tags/${tag.id}`} class="tag-badge text-xs px-2 py-0.5">#{tag.name}</a>
        ))}
      </span>
    )}
  </div>
  {showExcerpt && post.content && (
    <p class="text-[var(--text-muted)] text-sm leading-relaxed">
      {summary}
    </p>
  )}
  {showExcerpt && (
    <div class="mt-3">
      <a href={`/posts/${post.id}`} class="text-sm text-[var(--accent)] hover:underline">
        阅读全文 →
      </a>
    </div>
  )}
  {!showExcerpt && (
    <slot />
  )}
</article>
