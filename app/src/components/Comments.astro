---
// Multi-provider comment system component.
// Renders the appropriate comment widget based on site.commentsProvider.
//
// Props:
//   provider: 'disabled' | 'waline' | 'artalk' | 'giscus' | 'external'
//   config:  provider-specific configuration from site.commentsConfig

export interface Props {
  provider: string;
  config?: Record<string, unknown> | null;
}
const { provider, config } = Astro.props;
---

{provider === 'disabled' || !provider ? null : (
  <div id="vanblog-comments" class="mt-8 pt-6 border-t border-[var(--color-border)]">
    {provider === 'waline' && (
      <>
        <link href="https://unpkg.com/@waline/client@v3/dist/waline.css" rel="stylesheet" />
        <div id="waline-container"></div>
        <script is:inline type="module" data-server-url={String(config?.serverURL || '')}>
          import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';
          const serverURL = document.currentScript.dataset.serverUrl;
          init({ el: '#waline-container', serverURL, path: window.location.pathname, dark: 'html.dark' });
        </script>
      </>
    )}

    {provider === 'artalk' && (
      <>
        <link href="https://unpkg.com/artalk/dist/Artalk.css" rel="stylesheet" />
        <div id="artalk-container"></div>
        <script is:inline src="https://unpkg.com/artalk/dist/Artalk.js"></script>
        <script is:inline data-server={String(config?.server || '')} data-site={String(config?.site || 'VanBlog')}>
          (() => {
            const server = document.currentScript.dataset.server;
            const site = document.currentScript.dataset.site;
            const el = document.getElementById('artalk-container');
            if (!el || typeof Artalk === 'undefined') return;
            const getDark = () => document.documentElement.classList.contains('dark');
            Artalk.init({
              el: '#artalk-container',
              server,
              site,
              pageKey: window.location.pathname,
              darkMode: getDark() ? 'dark' : false,
            });
            // Sync with global dark mode toggle
            document.documentElement.addEventListener('darkmodechange', (e) => {
              Artalk.ui?.setDarkMode(e.detail?.dark ?? getDark());
            });
          })();
        </script>
      </>
    )}

    {provider === 'giscus' && (
      <script is:inline
        src="https://giscus.app/client.js"
        data-repo={String(config?.repo || '')}
        data-repo-id={String(config?.repoId || '')}
        data-category={String(config?.category || '')}
        data-category-id={String(config?.categoryId || '')}
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="bottom"
        data-theme={config?.theme || 'preferred_color_scheme'}
        data-lang="zh-CN"
        data-loading="lazy"
        crossorigin="anonymous"
        async
      >
      </script>
      <div class="giscus"></div>
      <script is:inline>
        document.documentElement.addEventListener('darkmodechange', (e) => {
          const iframe = document.querySelector('.giscus iframe, iframe[src*="giscus"]');
          if (!iframe?.contentWindow) return;
          const theme = e.detail?.dark ? 'dark' : 'light';
          iframe.contentWindow.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
        });
      </script>
    )}

    {provider === 'external' && (
      <Fragment set:html={String(config?.customScript || '')} />
    )}
  </div>
)}
