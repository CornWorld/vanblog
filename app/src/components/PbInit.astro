---
// Client-side pb initializer — loaded on every page via BaseLayout.
// Creates a browser pb client, loads token from cookie, exposes as window.__pb.
//
// Cookie is the SINGLE source of truth, written only by the SSR middleware
// (loadFromCookie → authRefresh → next → exportToCookie). Browser SDK never
// writes the cookie — that was the anti-pattern that caused login/logout state
// to drift between client localStorage and server-side authStore.
//
// Browser SDK still writes localStorage as its own backing store; that's fine
// because the middleware re-derives auth state from the cookie on every
// request, not from localStorage.
---
<script>
  import { createBrowserClient } from '@vanblog/sdk/browser';

  const pb = createBrowserClient();
  // Seed browser SDK from cookie so admin inline scripts can call the API.
  // If the cookie is absent (logged out), this is a no-op.
  pb.authStore.loadFromCookie(document.cookie);
  window.__pb = pb;
</script>
