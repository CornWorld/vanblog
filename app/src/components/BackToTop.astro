---
// Back-to-top floating button
---
<button id="back-to-top" type="button" class="fixed bottom-6 right-6 z-40 w-10 h-10 flex items-center justify-center rounded-full bg-[var(--accent)] text-white shadow-lg opacity-0 invisible transition-all duration-300 hover:opacity-90 cursor-pointer" aria-label="回到顶部">
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="18 15 12 9 6 15" />
  </svg>
</button>

<script>
  const btn = document.getElementById('back-to-top');
  if (btn) {
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(() => {
            if (window.scrollY > 400) {
              btn.classList.remove('opacity-0', 'invisible');
              btn.classList.add('opacity-100');
            } else {
              btn.classList.remove('opacity-100');
              btn.classList.add('opacity-0', 'invisible');
            }
            ticking = false;
          });
          ticking = true;
        }
      },
      { passive: true },
    );

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
